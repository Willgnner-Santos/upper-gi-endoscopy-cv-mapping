  year = {2025}
}

@article{Laun20251296,
  abstract = {INTRODUCTION:Esophageal adenocarcinoma (EAC) is the second-most lethal cancer in the United States, with Barrett esophagus (BE) being the strongest risk factor. Assessing the future risk of neoplastic progression in patients with BE is difficult; however, high-grade dysplasia (HGD) and early EAC are treatable by endoscopic eradication therapy (EET), with survival rates of 90%. Thus, it would be beneficial to develop a molecular assay to identify high-risk patients, who merit more frequent endoscopic surveillance or EET, as well as low-risk patients, who can avoid EET and undergo less frequent surveillance.METHODS:Deidentified endoscopic biopsies were acquired from 240 patients with BE at 6 centers and confirmed as future progressors or nonprogressors. Tissues were analyzed by a set of methylation-specific biomarker assays. Test performance was assessed in an independent validation set using 4 stratification levels: low risks, low-moderate risks, high-moderate risks, and high risks.RESULTS:Relative to patients in the low-risk group, high-risk patients were 15.2 times more likely to progress within 5 years to HGD or EAC. For patients in the high-risk category, the average risk of progressing to HGD or EAC within 5 years was 21.5%, 4-fold the BE population prevalence within 5 years, whereas low-risk patients had a progression risk of only 1.85%.DISCUSSION:This clinical assay, Esopredict, stratifies future neoplastic progression risk to identify higher-risk patients with BE who can benefit from EET or more frequent surveillance and lower-risk patients who can benefit from reduced surveillance. © 2024 The Author(s). Published by Wolters Kluwer Health, Inc. on behalf of The American College of Gastroenterology.},
  author = {Laun, Sarah E. and Kann, Lisa and Braun, Jerome and Gilbert, Stacey and Lunz, Daniel and Pierre, Francia and Kalra, Andrew and Ma, Ke and Tsai, Hua-Ling and Wang, Hao and Jit, Simran and Cheng, Yulan and Ahmed, Yousra and Wang, Kenneth K. and Leggett, Cadman L. and Cellini, Ashley and Ioffe, Olga B. and Zaidi, Ali H. and Omstead, Ashten N. and Jobe, Blair and Korman, Louis and Cornish, Drew and Zellenrath, Pauline and Spaander, Manon and Kuipers, Ernst and Perpetua, Lorrie and Greenwald, Bruce D. and Maddala, Tara and Meltzer, Stephen J.},
  author_keywords = {clinical decisions; epigenetics; esophageal cancer; personomics; predictive biomarkers},
  journal = {American Journal of Gastroenterology},
  keywords = {Adenocarcinoma; Adenocarcinoma Of Esophagus; Aged; Barrett Esophagus; Biopsy; Disease Progression; DNA Methylation; Epigenesis, Genetic; Esophageal Neoplasms; Esophagoscopy; Female; Humans; Male; Middle Aged; Prognosis; Risk Assessment; Risk Factors; biological marker; cyclin dependent kinase inhibitor 2A; fibrillin 1; glycoprotein; membrane protein; RUNX family transcription factor 3; transcription factor; unclassified drug; adult; aged; algorithm; Article; Barrett esophagus; cancer patient; cancer prognosis; cancer staging; clinical decision rule; clinical trial (topic); cohort analysis; DNA methylation; dysplasia; endoscopic eradication therapy; endoscopic surveillance; Epigenetic Prognostic Assay; epigenetics; esophageal adenocarcinoma; esophagogastroduodenoscopy; esophagus; female; follow up; gene; gene mutation; histology; human; human tissue; hyperpigmentation; machine learning; male; multicenter study (topic); overall survival; personomics; phenotype; retrospective study; risk assessment; risk factor; second-most lethal cancer; survival rate; validation therapy; adenocarcinoma; biopsy; clinical trial; disease exacerbation; esophagoscopy; esophagus tumor; genetic epigenesis; genetics; middle aged; multicenter study; pathology; procedures; prognosis; validation study},
  title = {Validation of an Epigenetic Prognostic Assay to Accurately Risk-Stratify Patients with Barrett Esophagus},
  url = {https://www.scopus.com/pages/publications/85201805902?origin=resultslist},
  year = {2025}
}

@article{LEBEDEV20213214,
  abstract = {At present, the search and development of new tools for the prevention and early diagnosis of oncological diseases is especially relevant, especially for use in the general medical network, transformation and optimization of processes in the prevention, screening, diagnosis and treatment of malignant neoplasms at all stages of medical care. In this article, the authors propose an approach to the use of digital technologies in the diagnosis of cancer.},
