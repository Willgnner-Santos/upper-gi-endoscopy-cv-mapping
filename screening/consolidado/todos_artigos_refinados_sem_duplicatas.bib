@conference{Zhou20257184,
  abstract = {Dynamic reconstruction and real-time visualization methods for endoscopic scenes based on Gaussian Splatting have demonstrated excellent performance. However, existing methods primarily rely on the color information of raw images, neglecting the high-quality semantic features provided by large pre-trained foundation models and their potential for extending to related visual tasks. This study proposes EndoLGS, a 4D Language Gaussian Splatting, which achieves open-vocabulary semantic understanding of endoscopic scenes through three key innovations. First, we compress language feature encodings using a scene-specific autoencoder, which not only significantly reduces the high memory overhead caused by high-dimensional encoding but also introduces high-level semantic features into the reconstruction process to improve performance. Second, we employ six orthogonal feature planes encoding for dynamic modeling, constructing a 4D language Gaussian field for expressing endoscopic scenes. Finally, we introduce an optimization strategy with selective fusion initialization to further enhance modeling performance. Experiments on the EndoNeRF dataset show that EndoLGS exhibits excellent performance in both scene modeling (SSIM: 0.960, PSNR: 37.865dB, LPIPS: 0.052) and semantic understanding (mIoU: 89.861%, Speed: 0.022 s/q). These results highlight the great potential of EndoLGS for achieving cognitive intelligence in robot-assisted surgery. © 2025 IEEE.},
  author = {Zhou, Wenxu and Yin, Dong},
  author_keywords = {Endoscopic Scene; Gaussian Splatting; Open-Vocabulary Learning; Semantic Understanding},
  doi = {10.1109/BIBM66473.2025.11356947},
  journal = {Proceedings - 2025 IEEE International Conference on Bioinformatics and Biomedicine, BIBM 2025},
  keywords = {Bioinformatics; Endoscopy; Gaussian beams; Gaussian distribution; Intelligent robots; Learning systems; Modeling languages; Object recognition; Semantics; Visualization; Encodings; Endoscopic scene; Gaussian splatting; Gaussians; Open-vocabulary learning; Performance; Scene understanding; Semantics understanding; Splatting; Vocabulary learning; Encoding (symbols); Signal encoding},
  title = {Open-Vocabulary Endoscopic Scene Understanding via 4D Language Gaussian Splatting},
  url = {https://www.scopus.com/pages/publications/105033552262?origin=resultslist},
  year = {2025}
}

@article{Zhou2026192,
  abstract = {Video depth estimation has been applied to various endoscopy tasks, such as reconstruction, navigation, and surgery. Recently, many methods focus on directly applying or adapting depth estimation foundation models to endoscopy scenes. However, these methods do not consider temporal information, leading to an inconsistent prediction. We propose Endoscopic Depth Any Video (EndoDAV) to estimate spatially accurate and temporally consistent endoscopic video depth, which significantly expands the usability of depth estimation in downstream tasks. Specifically, we parameter-efficiently finetune a video depth estimation foundation model to endoscopy scenes, utilizing a self-supervised depth estimation framework which simultaneously learns depth and camera pose. Considering the distinct characteristics of endoscopic videos compared to common videos, we further design a novel loss function and a depth alignment inference strategy to enhance the temporal consistency. Experiments on two public endoscopy datasets demonstrate that our method presents superior performance in both spatial accuracy and temporal consistency. Code is available at https://github.com/Zanue/EndoDAV. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  author = {Zhou, Zanwei and Yang, Chen and Yang, Piao and Yang, Xiaokang and Shen, Wei},
  author_keywords = {Foundation models; Self-supervised learning; Video depth estimation},
  doi = {10.1007/978-3-032-05114-1_19},
  journal = {Lecture Notes in Computer Science},
  keywords = {Computer vision; Foundations; Image analysis; Self-supervised learning; Supervised learning; Depth Estimation; Down-stream; Foundation models; Learn+; Loss functions; Performance; Spatio-temporal accuracy; Temporal consistency; Temporal information; Video depth estimation; Endoscopy},
  title = {EndoDAV: Depth Any Video in Endoscopy with Spatiotemporal Accuracy},
  url = {https://www.scopus.com/pages/publications/105017955035?origin=resultslist},
  year = {2026}
}

@conference{Zhu2016372,
  abstract = {Since gastroscopy is able to observe the interior of gastrointestinal tract directly, it has been widely used for gastrointestinal examination. But it is hard for clinicians to accurately detect gastrointestinal disease due to its great dependence on doctors experiences. Therefore, a computer-aided lesion detection system can offer great help for clinicians. In this paper, we propose a new scheme for endoscopy image lesion detection. A trainable feature extractor based on convolutional neural network (CNN) is utilized to get more generic features for endoscopy images. And features are fed to support vector machine (SVM) to enhance the generalization ability. Experiments show that the proposed scheme outperforms the previous conventional methods based on color and texture features. © 2015 IEEE.},
  author = {Zhu, Rongsheng and Zhang, Rong and Xue, Dixiu},
  doi = {10.1109/CISP.2015.7407907},
  journal = {Proceedings - 2015 8th International Congress on Image and Signal Processing, CISP 2015},
  title = {Lesion detection of endoscopy images based on convolutional neural network features},
  url = {https://www.scopus.com/pages/publications/84966686780?origin=resultslist},
  year = {2016}
}

@article{Zhu2019806,
  abstract = {Background and Aims: According to guidelines, endoscopic resection should only be performed for patients whose early gastric cancer invasion depth is within the mucosa or submucosa of the stomach regardless of lymph node involvement. The accurate prediction of invasion depth based on endoscopic images is crucial for screening patients for endoscopic resection. We constructed a convolutional neural network computer-aided detection (CNN-CAD) system based on endoscopic images to determine invasion depth and screen patients for endoscopic resection. Methods: Endoscopic images of gastric cancer tumors were obtained from the Endoscopy Center of Zhongshan Hospital. An artificial intelligence–based CNN-CAD system was developed through transfer learning leveraging a state-of-the-art pretrained CNN architecture, ResNet50. A total of 790 images served as a development dataset and another 203 images as a test dataset. We used the CNN-CAD system to determine the invasion depth of gastric cancer and evaluated the system's classification accuracy by calculating its sensitivity, specificity, and area under the receiver operating characteristic curve. Results: The area under the receiver operating characteristic curve for the CNN-CAD system was.94 (95% confidence interval [CI],.90-.97). At a threshold value of.5, sensitivity was 76.47%, and specificity 95.56%. Overall accuracy was 89.16%. Positive and negative predictive values were 89.66% and 88.97%, respectively. The CNN-CAD system achieved significantly higher accuracy (by 17.25%; 95% CI, 11.63-22.59) and specificity (by 32.21%; 95% CI, 26.78-37.44) than human endoscopists. Conclusions: We constructed a CNN-CAD system to determine the invasion depth of gastric cancer with high accuracy and specificity. This system distinguished early gastric cancer from deeper submucosal invasion and minimized overestimation of invasion depth, which could reduce unnecessary gastrectomy. © 2019 American Society for Gastrointestinal Endoscopy},
  author = {Zhu, Yan and Wang, Qiu-Cheng and Xu, Mei-Dong and Zhang, Zhen and Cheng, Jing and Zhong, Yun-Shi and Zhang, Yi-Qun and Chen, Wei-Feng and Yao, Li-Qing and Zhou, Ping-Hong and Li, Quan-Lin},
  doi = {10.1016/j.gie.2018.11.011},
  journal = {Gastrointestinal Endoscopy},
  title = {Application of convolutional neural network in the diagnosis of the invasion depth of gastric cancer based on conventional endoscopy},
  url = {https://www.scopus.com/pages/publications/85060079168?origin=resultslist},
  year = {2019}
}

