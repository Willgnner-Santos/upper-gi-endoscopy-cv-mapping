Camps-Valls, Gustau/0000-0003-1683-2138},
  researcherid-numbers = {MARTINEZ, BEATRIZ/F-7800-2016
Izquierdo-Verdiguier, Emma/AAA-6316-2019
Atzberger, Clement/F-8435-2010
