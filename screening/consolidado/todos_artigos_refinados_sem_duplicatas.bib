@article{Lan2025,
  abstract = {Backgrounds: Gastric cancer (GC) is a prevalent malignancy affecting the digestive system. We aimed to develop a risk prediction model based on endoscopic atrophy classification for GC. Methods: We retrospectively collected the data from January 2020 to October 2021 in our hospital and randomly divided the patients into training and validation sets in an 8:2 ratio. We used multiple machine learning algorithms such as logistic regression (LR), Decision tree, Support Vector Machine, Random forest, and so on to establish the models. We employed the Least absolute shrinkage and selection operator (LASSO) to screen variables for the LR model. However, we chose all the variables to construct the models for other machine learning algorithms. All models were evaluated using the receiver operating characteristic curve (ROC), predictive histograms, and decision curve analysis (DCA). Results: A total of 1156 patients were selected for the analysis. Five variables, including age, sex, family history of GC, HP infection status, and Kimura-Takemoto Classification (KTC), were screened using LASSO analysis. The area under the curve (AUC) of all the machine learning models ranged from 0.762 to 0.974 in the training set and from 0.608 to 0.812 in the validation set. Among them, the LR model exhibited the highest AUC value (0.812, 95%CI: 0.737–0.887) in the validation set with good calibration and clinical applicability. Finally, we constructed a nomogram to demonstrate the LR model. Conclusions: We established a nomogram based on endoscopic atrophy classification for GC, which might be valuable in predicting GC risk and assisting clinical decision-making. © The Author(s) 2025.},
  author = {Lan, Yadi and Sun, Weijia and Zhong, Shen and Xu, Qianqian and Xue, Yining and Liu, Zhaoyu and Shi, Lei and Han, Bing and Zhai, Tianyu and Liu, Mingyue and Sun, Yujing and Xu, Hongwei},
  author_keywords = {Endoscopy; Gastric cancer; Machine learning; Model; Prediction},
  journal = {BMC Cancer},
  keywords = {Adult; Aged; Atrophy; Female; Gastroscopy; Helicobacter Infections; Humans; Logistic Models; Machine Learning; Male; Middle Aged; Nomograms; Retrospective Studies; Risk Assessment; Risk Factors; ROC Curve; Stomach Neoplasms; adaptive boosting; adult; aged; alcohol consumption; Article; atrophic gastritis; Bayesian learning; calibration; classification algorithm; clinical decision making; clinical significance; controlled study; cross-sectional study; decision tree; diagnostic test accuracy study; digestive system; endoscopy; female; Helicobacter pylori; human; human tissue; k nearest neighbor; kimura takemoto classification system; learning algorithm; least absolute shrinkage and selection operator; logistic regression analysis; machine learning; male; nomogram; predictive model; random forest; receiver operating characteristic; retrospective study; smoking; stomach biopsy; stomach cancer; support vector machine; training; validation process; atrophy; classification; complication; gastroscopy; Helicobacter infection; machine learning; middle aged; pathology; procedures; risk assessment; risk factor; statistical model; stomach tumor},
  title = {A risk prediction model for gastric cancer based on endoscopic atrophy classification},
  url = {https://www.scopus.com/pages/publications/105000461693?origin=resultslist},
  year = {2025}
}

@article{Lan2025274,
  abstract = {Polyp segmentation is crucial in the diagnosis of colorectal cancer. The introduction of the Segment Any-thing Model (SAM) provides powerful pretraining capabilities for polyp segmentation, but it faces two main challenges when applied to endoscopic images: first, its Transformer- based architecture tends to overlook local details, leading to feature bias; second, its performance on out-of-distribution (OOD) data is suboptimal, affecting prediction accuracy and confidence estimation. To address these issues, we propose an enhanced approach based on SAM that incorporates a Local Feature Enhancement Module (LFEM) and a Channel Attention Enhancement Module (CAEM). LFEM improves the capture of high-frequency information by enhancing local detail features, playing a crucial role in extracting polyp edges and textures. CAEM introduces a channel attention mechanism that dynamically adjusts the weight of feature channels, thereby enhancing the model's sensitivity and generalization ability. Additionally, we draw on the design principles of the Cross-Branch Feature Enhancement module and the Uncertainty- Guided Prediction Regularization (UPR) module to further improve SAM's performance in multi-scale feature extraction and on out-of-distribution data. Experimental results demon-strate that the inclusion of LFEM and CAEM significantly improves the model's segmentation accuracy on multiple public polyp datasets, particularly excelling in complex background scenarios. © 2025 IEEE.},
  author = {Lan, Lixiang and Yang, Yang and Zhao, Guangyu and Li, Yifeng and Liu, Wanting and Wang, Jikui},
  doi = {10.1109/WRCSARA68202.2025.11194946},
  journal = {Proceeding of the WRC Symposium on Advanced Robotics and Automation, WRC SARA},
  keywords = {Data accuracy; Numerical models; Accuracy estimation; Confidence estimation; Endoscopic image; Feature enhancement; Local feature; Performance; Polyp segmentation; Pre-training; Prediction accuracy; Prediction confidence; Image segmentation},
  title = {AttSAM: Attention-Augmented Segment Anything Model for Accurate Polyp Segmentation},
  url = {https://www.scopus.com/pages/publications/105020982061?origin=resultslist},
  year = {2025}
}

@article{Laqui_re20251041,
  abstract = {Convolutional neural networks which were developed for computer vision, and large language models are opening up new possibilities in many medical spe-cialties, particularly digestive endoscopy. This field is currently the subject of a large body of scientific literature, with numerous studies having been published. This article aims to provide an up-to-date overview of artificial intelligence’s performance and main applications in digestive endoscopy. It analyzes the various biases that may arise in the interaction between artificial intelligence algorithms and gastroenterologists during digestive endoscopy, along with approaches to reduce or correct them. © 2026 JLE. Downloaded by DRS MONIQUE BERKHOF on 08/01/2026.},
  author = {Laquière, Arthur and Peyret, Dysmas and Boustière, Christian and Coron, Emmanuel and Karsenti, David},
