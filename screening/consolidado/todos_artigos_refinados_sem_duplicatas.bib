@article{Mori2019378,
  abstract = {With recent breakthroughs in artificial intelligence, computer-aided diagnosis (CAD) for upper gastrointestinal endoscopy is gaining increasing attention. Main research focuses in this field include automated identification of dysplasia in Barrett's esophagus and detection of early gastric cancers. By helping endoscopists avoid missing and mischaracterizing neoplastic change in both the esophagus and the stomach, these technologies potentially contribute to solving current limitations of gastroscopy. Currently, optical diagnosis of early-stage dysplasia related to Barrett's esophagus can be precisely achieved only by endoscopists proficient in advanced endoscopic imaging, and the false-negative rate for detecting gastric cancer is approximately 10%. Ideally, these novel technologies should work during real-time gastroscopy to provide on-site decision support for endoscopists regardless of their skill; however, previous studies of these topics remain ex vivo and experimental in design. Therefore, the feasibility, effectiveness, and safety of CAD for upper gastrointestinal endoscopy in clinical practice remain unknown, although a considerable number of pilot studies have been conducted by both engineers and medical doctors with excellent results. This review summarizes current publications relating to CAD for upper gastrointestinal endoscopy from the perspective of endoscopists and aims to indicate what is required for future research and implementation in clinical practice. © 2018 Japan Gastroenterological Endoscopy Society},
  author = {Mori, Yuichi and Kudo, Shin-ei and Mohmed, Hussein E. N. and Misawa, Masashi and Ogata, Noriyuki and Itoh, Hayato and Oda, Masahiro and Mori, Kensaku},
  author_keywords = {computer-aided; detection; esophagus; gastroscopy; stomach},
  journal = {Digestive Endoscopy},
  keywords = {Artificial Intelligence; Diagnosis, Computer-Assisted; Digestive System Diseases; Early Detection of Cancer; Endoscopy, Digestive System; Humans; area under the curve; artificial intelligence; Barrett esophagus; cancer diagnosis; chromoendoscopy; clinical effectiveness; computer assisted diagnosis; deep learning; diagnostic accuracy; esophageal squamous cell carcinoma; false negative result; false positive result; gastrointestinal dysplasia; gastrointestinal endoscopy; Helicobacter infection; human; narrow band imaging; patient safety; predictive value; receiver operating characteristic; Review; sensitivity and specificity; stomach cancer; white light endoscopy; digestive system disease; digestive tract endoscopy; early cancer diagnosis; procedures},
  title = {Artificial intelligence and upper gastrointestinal endoscopy: Current status and future perspective},
  url = {https://www.scopus.com/pages/publications/85061563640?origin=resultslist},
  year = {2019}
}

@article{Mu2026,
  abstract = {Early diagnosis of colorectal cancer is highly dependent on the precise segmentation of polyps in endoscopic images. Although large foundation models (LFMs) such as SAM2 have demonstrated remarkable performance in natural image segmentation, their direct application to medical images presents three key challenges: domain drift, inefficient multi-scale feature interaction, and boundary displacement. To alleviate these challenges, this study proposes a SAM2 with adaptive context enhancement model for polyp segmentation (SAM2-PolypNet). The model has three main advantages. First, a lightweight SimAM adapter is designed to mitigate the domain drift problem through dynamic feature enhancement and channel-wise adaptive recalibration. Secondly, an inter-scale interactive attention (ISIA) module is developed to strengthen semantic coherence among multi-scale features by cross-resolution feature alignment and dynamic attention allocation. Thirdly, a high-low frequency enhanced (HLFE) decoder is proposed to improve edge localization via adaptive frequency decomposition and Kolmogorov–Arnold based channel integration. Experimental results on three public datasets, Kvasir-SEG, ETIS-LaribPolypDB, and CVC-ColonDB, show that the proposed SAM2-PolypNet achieves average performance improvements of approximately 3.06% and 4.11% in Dice and IoU metrics, respectively, compared to recent state-of-the-art methods. Code is available at https://github.com/XUPTMZT/SAM2-PolypNet. © 2026 Elsevier Ltd},
  author = {Mu, Zhaoting and Ning, Yu and Zhao, Yueqi and Zhang, Rong and Mubtasim, Fuad Md and Ning, Hailong},
  author_keywords = {Boundary displacement; Domain drift; Large foundation model; Polyp segmentation},
  doi = {10.1016/j.bspc.2026.110381},
  journal = {Biomedical Signal Processing and Control},
  keywords = {Channel coding; Diagnosis; Medical image processing; Semantics; Boundary displacements; Domain drift; Early diagnosis; Endoscopic image; Foundation models; Large foundation model; Multi-scale features; Natural image segmentations; Performance; Polyp segmentation; Image segmentation},
  title = {SAM2-PolypNet: SAM2 with adaptive context enhancement model for polyp segmentation},
  url = {https://www.scopus.com/pages/publications/105037448428?origin=resultslist},
  year = {2026}
}

@conference{Muppidi2025513,
  abstract = {Vision-based Proximal Policy Optimization (PPO) struggles with visual observation-based robotic laparoscopic surgical tasks due to the high-dimensional nature of visual input, the sparsity of rewards in surgical environments, and the difficulty of extracting task-relevant features from raw visual data. We introduce a simple approach integrating MedFlamingo, a medical domain-specific Vision-Language Model, with PPO. Our method is evaluated on five diverse laparoscopic surgery task environments in LapGym, using only endoscopic visual observations. MedFlamingo PPO outperforms and converges faster compared to both standard vision-based PPO and OpenFlamingo PPO baselines, achieving task success rates exceeding 70% across all environments, with improvements ranging from 66.67% to 1114.29% compared to baseline. By processing task observations and instructions once per episode to generate high-level planning tokens, our method efficiently combines medical expertise with real-time visual feedback. Our results highlight the value of specialized medical knowledge in robotic surgical planning and decision-making.  © 2025 IEEE.},
  author = {Muppidi, Akshay and Radfar, Martin},
  author_keywords = {MedFlamingo; Robotic Laparoscopic Surgery; Vision-Based PPO},
  doi = {10.1109/CAI64502.2025.00094},
  journal = {Proceedings - 2025 IEEE Conference on Artificial Intelligence, CAI 2025},
  keywords = {Decision making; Intelligent robots; Laparoscopy; Medical robotics; Robot vision; Visual communication; Visual languages; Visual servoing; Language model; Laparoscopic surgery; Medflamingo; Policy optimization; Robotic laparoscopic surgery; Robotics surgery; Surgical tasks; Vision based; Vision-based proximal policy optimization; Visual observations; Robotic surgery},
  title = {Medical Vision Language Models as Policies for Robotic Surgery},
  url = {https://www.scopus.com/pages/publications/105011296128?origin=resultslist},
  year = {2025}
}

