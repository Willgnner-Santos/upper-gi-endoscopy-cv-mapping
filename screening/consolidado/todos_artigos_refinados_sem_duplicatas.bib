@article{WOS:001532524200011,
  abstract = {Quality of care during endoscopy is greatly influenced by endoscopists'
competence and efforts, which is unfortunately subject to variability.
The recent transformative role of artificial intelligence (AI) is
expected to improve endoscopy quality in a objective way, potentially
eliminating inter-endoscopist variability in endoscopy performance. AI
aids in real-time detection (CADe) and characterization (CADx) of
colorectal polyps, quality assurance of colonoscopy (CAQ), and workflow
optimization including surveillance interval support and endoscopy
reporting. These technologies are rapidly implemented in real clinical
practice largely in the colonoscopy field while there is emerging
progress in upper gastrointestinal endoscopy. This review article
discusses technological advancements including currently available
evidence, regulatory and ethical challenges, and practical tips to
maximize the value of AI in endoscopy.},
  article-number = {102006},
  author = {Mori, Yuchi and Misawa, Masashi},
  doi = {10.1016/j.bpg.2025.102006},
  earlyaccessdate = {JUL 2025},
  eissn = {1532-1916},
