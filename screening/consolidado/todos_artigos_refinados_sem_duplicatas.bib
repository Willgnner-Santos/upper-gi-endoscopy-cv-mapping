  journal = {2019 IEEE Biomedical Circuits and Systems Conference (BioCAS)},
  keywords = {Testing;Stomach;Convolution;Learning systems;Support vector machines;Training;Medical services;Gastric section detection;endoscopic images;convolutional neural networks;decision fusion},
  month = {Oct},
