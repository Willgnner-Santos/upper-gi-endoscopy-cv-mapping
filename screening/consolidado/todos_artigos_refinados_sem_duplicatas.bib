  keywords = {Digital storage; Endoscopy; 'current; Clinical practices; Colonoscopy; Computer aided detection; Computer aided detection systems; Detection models; Generalisation; Image foundational model; Performance; Self-supervision; Medical imaging},
  title = {Predicting the generalization of computer aided detection (CADe) models for colonoscopy},
