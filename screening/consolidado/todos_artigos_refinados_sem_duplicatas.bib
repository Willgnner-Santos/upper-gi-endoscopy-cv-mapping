@conference{Ejiga_Peter2025,
  abstract = {The major limitations of the gastrointestinal (GI) endoscopy AI systems arise from a shortage of annotated data, strict privacy policies, and significant bottlenecks in conventional model fine-tuning. Such limitations impede the successful application of sophisticated AI models in clinical practice, particularly affecting the reliability and scalability of diagnosis. In this paper, we present a dual-pipeline, PEFT model that addresses two fundamental problems, including medical Visual Question Answering (VQA) and the generation of privacy-preserving synthetic data. For clinical VQA, we adopt the Florence-2 vision-language model. Leveraging PEFT enhances model interpretability while substantially reducing the computational cost of training. Simultaneously, we employ Low-Rank Adaptation (LoRA) in the context of Stable Diffusion 2.1 to generate high-quality GI images that enhance training databases without violating patient privacy. This research utilized the Kvasir-VQA dataset. Our Florence-2 VQA model scored ROUGE-1 0.92, ROUGE-L 0.91, and improvements in BLEU scores of 0.08-0.24. Fine-tuning on private datasets consistently showed better results than on public datasets. The rank-4 LoRA synthesis achieved optimal performance with a fidelity score of 0.290, an agreement score of 0.730, and a Frechet BiomedCLIP Distance (FBD) of 1450, reducing computational costs by almost 90%. This framework improves the clinical potential of AI in GI endoscopy. Compared to FLUX, MSDM, and Kandinsky 2.2, our model demonstrates superior FBD and strong semantic alignment. While others lead in Fidelity or Agreement, our lower FBD indicates better image-text coherence. These results establish our approach as a robust solution for enhancing VQA and synthetic data generation in clinical AI. © 2025 IEEE.},
  author = {Ejiga Peter, Ojonugwa Oluwafemi and Akor Ejiga, Frederick and Khalifa, Fahmi and Rahman, Md Mahmudur},
  author_keywords = {Biomedical imaging; Cross-attention mechanisms; Data augmentation; Florence-2; Gastrointestinal endoscopy; Image generation; Low-Rank Adaptation (LoRA); Medical image generation; Medical visual question answering; Parameter-efficient fine-tuning (PEFT); Polyp detection; Stable Diffusion; Synthetic data generation; Synthetic Medical Imaging; Transformer architectures; Vision-language models},
  doi = {10.1109/BHI67747.2025.11269532},
  journal = {BHI 2025 - IEEE-EMBS International Conference on Biomedical and Health Informatics, Conference Proceedings},
  keywords = {Clinical research; Data privacy; Diffusion; Endoscopy; Medical computing; Medical image processing; Medical problems; Semantics; Software architecture; Systems analysis; Tuning; Visual languages; Attention mechanisms; Biomedical imaging; Cross-attention mechanism; Data augmentation; Fine tuning; Florence; Florence-2; Gastrointestinal endoscopies; Image generations; Language model; Low-rank adaptation; Medical image generation; Medical visual question answering; Parameter-efficient fine-tuning; Polyp detection; Question Answering; Stable diffusion; Synthetic data generations; Synthetic medical imaging; Transformer architecture; Vision-language model; Image enhancement},
  title = {Parameter-Efficient VLMs for Gastrointestinal Endoscopy: Medical Image Generation and Clinical Visual Question Answering},
  url = {https://www.scopus.com/pages/publications/105030493646?origin=resultslist},
  year = {2025}
}

@article{Ejiga_Peter2025_1,
  abstract = {The lack of extensive, varied, and thoroughly annotated datasets impedes the advancement of artificial intelligence (AI) for medical applications, especially colorectal cancer detection. Models trained with limited diversity often display biases, especially when utilized on disadvantaged groups. Generative models (e.g., DALL-E 2, Vector-Quantized Generative Adversarial Network (VQ-GAN)) have been used to generate images but not colonoscopy data for intelligent data augmentation. This study developed an effective method for producing synthetic colonoscopy image data, which can be used to train advanced medical diagnostic models for robust colorectal cancer detection and treatment. Text-to-image synthesis was performed using fine-tuned Visual Large Language Models (LLMs). Stable Diffusion and DreamBooth Low-Rank Adaptation produce images that look authentic, with an average Inception score of 2.36 across three datasets. The validation accuracy of various classification models Big Transfer (BiT), Fixed Resolution Residual Next Generation Network (FixResNeXt), and Efficient Neural Network (EfficientNet) were 92%, 91%, and 86%, respectively. Vision Transformer (ViT) and Data-Efficient Image Transformers (DeiT) had an accuracy rate of 93%. Secondly, for the segmentation of polyps, the ground truth masks are generated using Segment Anything Model (SAM). Then, five segmentation models (U-Net, Pyramid Scene Parsing Network (PSNet), Feature Pyramid Network (FPN), Link Network (LinkNet), and Multi-scale Attention Network (MANet)) were adopted. FPN produced excellent results, with an Intersection Over Union (IoU) of (Formula presented.), an F1 score of (Formula presented.), a recall of (Formula presented.), and a Dice coefficient of 0.77. This demonstrates strong performance in terms of both segmentation accuracy and overlap metrics, with particularly robust results in balanced detection capability as shown by the high F1 score and Dice coefficient. This highlights how AI-generated medical images can improve colonoscopy analysis, which is critical for early colorectal cancer detection. © 2025 by the authors.},
  author = {Ejiga Peter, Ojonugwa Oluwafemi and Adeniran, Opeyemi Taiwo and John-Otumu, Adetokunbo MacGregor and Khalifa, Fahmi and Rahman, Md Mahmudur},
  author_keywords = {colorectal cancer detection; data augmentation; DreamBooth; Feature Pyramid Network; generative AI; healthcare AI; image segmentation; Low-Rank Adaptation (LoRA); medical diagnostic models; medical image synthesis; medical imaging synthesis; polyp detection; polyp segmentation; Segment Anything Model; Stable Diffusion; synthetic colonoscopy images; text-to-image generation; text-to-image generation; Vision Transformer},
  doi = {10.3390/a18030155},
  journal = {Algorithms},
  keywords = {Breath controlled devices; Electrotherapeutics; Endoscopy; Eye controlled devices; Image segmentation; Medical image processing; Oncology; Sensory feedback; Vector quantization; Cancer detection; Colonoscopy; Colorectal cancer detection; Data augmentation; Diagnostic model; Dreambooth; Feature pyramid; Feature pyramid network; Generative artificial intelligence; Healthcare artificial intelligence; Image generations; Images segmentations; Images synthesis; Low-rank adaptation; Medical diagnostic model; Medical diagnostics; Medical image synthesis; Medical imaging synthesis; Polyp detection; Polyp segmentation; Pyramid network; Segment anything model; Stable diffusion; Synthetic colonoscopy image; Text-to-image generation; Vision transformer; Diseases},
  title = {Text-Guided Synthesis in Medical Multimedia Retrieval: A Framework for Enhanced Colonoscopy Image Classification and Segmentation},
  url = {https://www.scopus.com/pages/publications/105001396823?origin=resultslist},
  year = {2025}
