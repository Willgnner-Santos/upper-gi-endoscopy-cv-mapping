  keywords = {algorithm; Article; artificial intelligence; cancer diagnosis; convolutional neural network; diagnostic accuracy; diagnostic test accuracy study; endoscopy; erosive gastritis; gastroscopy; human; human tissue; hyperplasia; learning algorithm; major clinical study; multicenter study; pain threshold; predictive value; quality control; receiver operating characteristic; sensitivity and specificity; stomach cancer; stomach ulcer; Youden index},
