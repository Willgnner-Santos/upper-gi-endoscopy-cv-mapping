@article{An2020884,
  abstract = {Background: Accurate delineation of cancer margins is critical for endoscopic curative resection. This study aimed to train and validate real-time fully convolutional networks for delineating the resection margin of early gastric cancer (EGC) under indigo carmine chromoendoscopy (CE) or white light endoscopy (WLE), and evaluated its performance and that of magnifying endoscopy with narrow-band imaging (ME-NBI). Methods: We collected CE and WLE images of EGC lesions to train fully convolutional networks ENDOANGEL. ENDOANGEL was tested both on stationary images and endoscopic submucosal dissection (ESD) videos. The accuracy and reliability of ENDOANGEL and NBI-dependent delineation were further evaluated by a novel endoscopy–pathology point-to-point marking. Results: ENDOANGEL had an accuracy of 85.7% in the CE images and 88.9% in the WLE images under an overlap ratio threshold of 0.60 in comparison with the manual markers labeled by the experts. In the ESD videos, the resection margins predicted by ENDOANGEL covered all areas of high-grade intraepithelial neoplasia and cancers. The minimum distance between the margins predicted by ENDOANGEL and the histological cancer boundary was 3.44 ± 1.45 mm which outperformed the resection margin based on ME-NBI. Conclusions: ENDOANGEL has the potential to assist endoscopists in delineating the resection extent of EGC under CE or WLE during ESD. © 2020, The International Gastric Cancer Association and The Japanese Gastric Cancer Association.},
  author = {An, Ping and Yang, Dongmei and Wang, Jing and Wu, Lianlian and Zhou, Jie and Zeng, Zhi and Huang, Xu and Xiao, Yong and Hu, Shan and Chen, Yiyun and Yao, Fang and Guo, Mingwen and Wu, Qi and Yang, Yanning and Yu, Honggang},
  author_keywords = {Chromoendoscopy; Early gastric cancer; Fully convolutional networks; Horizontal extent; White light endoscopy},
  journal = {Gastric Cancer},
  keywords = {Deep Learning; Early Detection of Cancer; Endoscopic Mucosal Resection; Gastroscopy; Humans; Indigo Carmine; Margins of Excision; Narrow Band Imaging; Prognosis; Stomach Neoplasms; indigo carmine; Article; cancer grading; cancer surgery; chromoendoscopy; controlled study; convolutional neural network; deep learning; diagnostic accuracy; diagnostic test accuracy study; endoscopic submucosal dissection; false negative result; false positive result; gold standard; histopathology; human; human tissue; magnifying endoscopy; major clinical study; medical expert; narrow band imaging; prediction; predictive value; priority journal; reliability; stomach cancer; stomach lesion; stomach surgery; validation study; white light endoscopy; chemistry; early cancer diagnosis; endoscopic mucosal resection; gastroscopy; pathology; procedures; prognosis; stomach tumor; surgical margin},
  title = {A deep learning method for delineating early gastric cancer resection margin under chromoendoscopy and white light endoscopy},
  url = {https://www.scopus.com/pages/publications/85084261930?origin=resultslist},
  year = {2020}
}

@article{An2024173,
  abstract = {Objective: This study aimed to discuss the application value of an artificial intelligence-based diagnosis and recognition system (AIDRS) in the teaching activities for Bachelor of Medicine and Bachelor of Surgery (MBBS) in China. The learning performance of graduate students in gastroenterology during gastroscopy training with and without AIDRS was assessed. Methods: The study recruited 32 graduate students of the gastroenterology program at Jiangsu province hospital of Chinese medicine and Xiangyang No. 1 People’s Hospital from March 2018 to March 2022 and randomly divided them into AIDRS (n = 16) and non-AIDRS (n = 16) groups. The AIDRS software was used for real-time monitoring of blind spots of gastroscopy to aid in lesion diagnosis and recognition in the AIDRS group. Only a conventional gastroscopic procedure was implemented in the non-AIDRS group. The final performance score, success rate of gastroscopy, lesion detection rate, and pain score of patients were compared between the two groups during gastroscopy. A self-prepared teaching and learning satisfaction questionnaire was administered to the two groups of students. Results: The AIDRS group had a higher final performance score (92.60 ± 2.83 vs. 89.21 ± 3.57, t = 2.98, P < 0.05), a higher success rate of gastroscopy (448/480 vs. 417/480, χ<sup>2</sup> = 11.23, P < 0.05), and a higher detection rate of lesions (51/52 vs. 41/53, χ<sup>2</sup> = 8.56, P < 0.05) compared with the non-AIDRS group. The pain scores of patients were lower in the AIDRS group than in the non-AIDRS group (3.40 [2.23, 3.98] vs. 4.45 [3.72, 4.75], Z = 3.04, P < 0.05). Besides, the average time for gastroscopy was lower in the AIDRS group than in the non-AIDRS group (7.15 ± 1.24 vs. 8.21 ± 1.26, t = 2.38, P = 0.02). The overall satisfaction level with the teaching program was higher in the AIDRS group (43.51 ± 2.29 vs. 40.93 ± 2.07, t = 3.33, P < 0.05). Conclusion: In the context of medicine–education cooperation, AIDRS offered valuable assistance in gastroscopy training and increased the success rate of gastroscopy and teaching and learning satisfaction. AIDRS is worthy of wider-scale promotion. © The Author(s), under exclusive licence to Springer-Verlag GmbH Austria, ein Teil von Springer Nature 2023.},
  author = {An, Peng and Wang, Zhongqiu},
  author_keywords = {Diagnostic imaging; Education, medical; Gastroscopes; Internship and residency; Patient simulation},
  journal = {Wiener Medizinische Wochenschrift},
  keywords = {Adult; Artificial Intelligence; China; Clinical Competence; Education, Medical, Graduate; Female; Gastroenterology; Gastroscopy; Humans; Male; Young Adult; dyclonine; dyclonine hydrochloride mucilage; local anesthetic agent; propofol; unclassified drug; adenomatous polyp; adult; anatomical landmark; Article; artificial intelligence based diagnosis and recognition system; atrophic gastritis; China; clinical education; controlled study; deep learning; diabetes mellitus; diagnostic imaging; diagnostic value; esophagus injury; esophagus varices; female; gastroenterology; gastroscopy; general anesthesia; graduate student; human; hypertension; local anesthesia; major clinical study; male; medical education; medical history; operation duration; pain assessment; pain severity; physical performance; pylorus; questionnaire; safety; stomach cancer; stomach erosion; stomach polyp; stomach surgery; stomach ulcer; teaching; teaching and learning satisfaction questionnaire; theory; upper gastrointestinal tract; visual analog scale; artificial intelligence; clinical competence; education; medical education; procedures; randomized controlled trial; young adult},
  title = {Application value of an artificial intelligence-based diagnosis and recognition system in gastroscopy training for graduate students in gastroenterology: a preliminary study},
  url = {https://www.scopus.com/pages/publications/85169933006?origin=resultslist},
  year = {2024}
}

@article{An202425,
  abstract = {BACKGROUND: Chronic atrophy gastritis (CAG) is a high-risk pre-cancerous lesion for gastric cancer (GC). The early and accurate detection and discrimination of CAG from benign forms of gastritis (e.g. chronic superficial gastritis, CSG) is critical for optimal management of GC. However, accurate non-invasive methods for the diagnosis of CAG are currently lacking. Cytokines cause inflammation and drive cancer transformation in GC, but their utility as a diagnostic for CAG is poorly characterized. METHODS: Blood samples were collected, and 40 cytokines were quantified using a multiplexed immunoassay from 247 patients undergoing screening via endoscopy. Patients were divided into discovery and validation sets. Each cytokine importance was ranked using the feature selection algorithm Boruta. The cytokines with the highest feature importance were selected for machine learning (ML), using the LightGBM algorithm. RESULTS: Five serum cytokines (IL-10, TNF-α, Eotaxin, IP-10 and SDF-1a) that could discriminate between CAG and CSG patients were identified and used for predictive model construction. This model was robust and could identify CAG patients with high performance (AUC = 0.88, Accuracy = 0.78). This compared favorably to the conventional approach using the PGI/PGII ratio (AUC = 0.59). CONCLUSION: Using state-of-the-art ML and a blood-based immunoassay, we developed an improved non-invasive screening method for the detection of precancerous GC lesions. FUNDING: Supported in part by grants from: Jiangsu Science and Technology Project (no. BK20211039); Top Talent Support Program for young and middle-aged people of Wuxi Health Committee (BJ2023008); Medical Key Discipline Program of Wuxi Health Commission (ZDXK2021010), Wuxi Science and Technology Bureau Project (no. N20201004); Scientific Research Program of Wuxi Health Commission (Z202208, J202104). © 2024 – The authors. Published by IOS Press.},
  author = {An, Fangmei and Ge, Yan and Ye, Wei and Ji, Lin and Chen, Ke and Wang, Yunfei and Zhang, Xiaoxue and Dong, Shengrong and Shen, Yao and Zhao, Jiamin and Gao, Xiaojuan and Junankar, Simon and Chan, Robin Barry and Christodoulou, Dimitris and Wen, Wen and Lu, Peihua and Zhan, Qiang},
  author_keywords = {Chronic Atrophy Gastritis (CAG); Chronic Superficial Gastritis (CSG); Cytokines; Machine Learning (ML) Algorithms; Screening},
  journal = {Cancer Biomarkers},
  keywords = {Adult; Aged; Chronic Disease; Cytokines; Early Detection of Cancer; Female; Gastritis, Atrophic; Humans; Machine Learning; Male; Middle Aged; Stomach Neoplasms; eotaxin; gamma interferon inducible protein 10; interleukin 10; pepsinogen I; pepsinogen II; stromal cell derived factor 1alpha; tumor necrosis factor; cytokine; adult; Article; atrophic gastritis; blood sampling; chronic gastritis; chronic superficial gastritis; diagnostic accuracy; diagnostic test accuracy study; early diagnosis; enzyme linked immunosorbent assay; evaluation study; feature selection; feature selection algorithm; female; gastroscopy; histopathology; human; human tissue; immunoassay; learning algorithm; LightGBM algorithm; machine learning; major clinical study; male; middle aged; predictive model; protein blood level; aged; atrophic gastritis; blood; chronic disease; diagnosis; early cancer diagnosis; procedures; stomach tumor},
  title = {Machine learning identifies a 5-serum cytokine panel for the early detection of chronic atrophy gastritis patients},
  url = {https://www.scopus.com/pages/publications/85204660291?origin=resultslist},
  year = {2024}
}

@conference{Anitha2023212,
  abstract = {In order to detect early stomach malignancies, upper GI endoscopy is commonly used. An object detection model, a form of deep learning, was projected as a means of automating the diagnosis of early stomach cancer using endoscopic pictures. Yet there were difficulties in reducing false positives in the results that were detected. Thus, this research proposes an automatic classification method for stomach cancer classification using a (CNN) that has been pre-trained. To classify cancer in endoscopic pictures automatically, our method is superior to those that rely on traditional, manual features. Thirteen convolutional layers with small 33 size kernels and three fully linked layers make up the suggested model. We use the learning approach, which involves pre-training the weight of fine-tuning the weight of layers with the Slime Mould Algorithm, to deal with the data scarcity (SMA). Experiments employing 1208 photos from healthy subjects and 533 photographs from patients with stomach cancer examined detection performance using the 5-fold cross validation approach. These findings suggest the projected strategy will be effective for automating the diagnosis of early stomach cancer in endoscopic pictures.  © 2023 IEEE.},
  author = {Anitha, Cuddapah and Srinivas Rao, Vemu and Ramyadevi, R. and Maya, R. and Debroy, Subhasish and Mahaveerakannan, R.},
  author_keywords = {Conventional hand-craft characteristics; Convolutional Neural Network; Kernel Size; Slime Mould Algorithm; Upper gastrointestinal endoscopy},
  doi = {10.1109/ICECA58529.2023.10394686},
  journal = {7th International Conference on Electronics, Communication and Aerospace Technology, ICECA 2023 - Proceedings},
  keywords = {Conventional hand-craft characteristics; Convolutional Neural Network; Kernel Size; Slime Mould Algorithm; Upper gastrointestinal endoscopy},
  title = {Segmentation and Classification of Gastric Cancer from Endoscopic Image Dataset with the Aid of Artificial Intelligence},
  url = {https://www.scopus.com/pages/publications/85186114528?origin=resultslist},
  year = {2023}
}

@article{Arai2022864,
  abstract = {Background and Aims: Accurate risk stratification for gastric cancer is required for optimal endoscopic surveillance in patients with chronic gastritis. We aimed to develop a machine learning (ML) model that incorporates endoscopic and histologic findings for an individualized prediction of gastric cancer incidence. Methods: We retrospectively evaluated 1099 patients with chronic gastritis who underwent EGD and biopsy sampling of the gastric mucosa. Patients were randomly divided into training and test sets (4:1). We constructed a conventional Cox proportional hazard model and 3 ML models. Baseline characteristics, endoscopic atrophy, and Operative Link on Gastritis-Intestinal Metaplasia Assessment (OLGIM)/Operative Link on Gastritis Assessment (OLGA) stage at initial EGD were comprehensively assessed. Model performance was evaluated using Harrel's c-index. Results: During a mean follow-up of 5.63 years, 94 patients (8.55%) developed gastric cancer. The gradient-boosting decision tree (GBDT) model achieved the best performance (c-index from the test set, .84) and showed high discriminative ability in stratifying the test set into 3 risk categories (P < .001). Age, OLGIM/OLGA stage, endoscopic atrophy, and history of malignant tumors other than gastric cancer were important predictors of gastric cancer incidence in the GBDT model. Furthermore, the proposed GBDT model enabled the generation of a personalized cumulative incidence prediction curve for each patient. Conclusions: We developed a novel ML model that incorporates endoscopic and histologic findings at initial EGD for personalized risk prediction of gastric cancer. This model may lead to the development of effective and personalized follow-up strategies after initial EGD. © 2022 American Society for Gastrointestinal Endoscopy},
  author = {Arai, Junya and Aoki, Tomonori and Sato, Masaya and Niikura, Ryota and Suzuki, Nobumi and Ishibashi, Rei and Tsuji, Yosuke and Yamada, Atsuo and Hirata, Yoshihiro and Ushiku, Tetsuo and Hayakawa, Yoku and Fujishiro, Mitsuhiro},
  journal = {Gastrointestinal Endoscopy},
  keywords = {Atrophy; Endoscopy, Gastrointestinal; Gastric Mucosa; Gastritis; Gastritis, Atrophic; Helicobacter Infections; Helicobacter pylori; Humans; Incidence; Machine Learning; Metaplasia; Retrospective Studies; Risk Factors; Stomach Neoplasms; acetylsalicylic acid; histamine H2 receptor antagonist; proton pump inhibitor; adult; age; Article; atrophic gastritis; cancer incidence; cancer staging; chronic gastritis; cohort analysis; controlled study; cumulative incidence; decision tree; female; follow up; gastroscopy; histopathology; human; intestinal metaplasia; machine learning; major clinical study; male; medical history; middle aged; predictive model; predictive value; retrospective study; stomach biopsy; stomach cancer; stomach mucosa; support vector machine; adverse event; atrophic gastritis; atrophy; diagnostic imaging; gastritis; gastrointestinal endoscopy; Helicobacter infection; Helicobacter pylori; incidence; machine learning; metaplasia; pathology; randomized controlled trial; risk factor; stomach tumor},
  title = {Machine learning–based personalized prediction of gastric cancer incidence using the endoscopic and histologic findings at the initial endoscopy},
  url = {https://www.scopus.com/pages/publications/85126512909?origin=resultslist},
  year = {2022}
}

@article{Arkhipova2021113,
  abstract = {The review includes 70 articles, most of which have been published for the last 5 years. The aim of the review: explore the modern possibilities and prospects of early diagnosis of stomach cancer. In 2018 in Russia, the mortality rate within one year after the diagnosis was 47.4%. Leading experts in luminal endoscopy from Japan, where more than 60% cases of stomach cancer are detected at an early stage, recommend using advanced endoscopic equipment for routine diagnostics, which allows enlarging the image, examining the capillaries of the mucosa and taking series of pictures. Artificial intelligence improves accuracy. Gastroscopic study with artificial intelligence compensates errors and limited capabilities of people, and provides greater accuracy. However, this technology is expensive, and esophagogastroduodenoscopy itself is an invasive method and can be used only in a clinical setting. In patients with a detectable lesion, a biopsy should be performed. It is important to obtain a sufficient amount of tissue when collecting material, however, many patients take anticoagulants, and thus sampling of numerous fragments can lead to bleeding. Given the limitations of esophagogastroduodenoscopy with biopsy and the fact that only 12.4% cases of stomach cancer in 2018 in Russia identified on the stage I, the searching of effective diagnostic tools is still relevant. MicroRNAs have been in the «cancer research arena» for over 10 years and are considered biomarkers that can help to differentiate between the patients with normal range, dysplasia and those with cancer. MicroRNA regulates all vital processes of a cell, moreover, they are stable and easily extracted from various biological materials, including tissues, blood, feces, saliva, ascitic fluid and even paraffin blocks. And although microRNAs are only entering clinical practice, the results obtained are encouraging. © 2021 SINAPS LLC. All rights reserved.},
  author = {Arkhipova, A.A. and Anischenko, V.V.},
  author_keywords = {Biomarkers; Cancer; Diagnostics; MicroRNA; Risk factors; Stomach ulcer},
  journal = {Acta Biomedica Scientifica},
  keywords = {Biomarkers; Cancer; Diagnostics; MicroRNA; Risk factors; Stomach ulcer},
  title = {Modern possibilities and prospects of early diagnosis of stomach cancer; [СовРемеННые воЗможНоСТИ И ПеРСПекТИвы РАННей дИАГНоСТИкИ РАкА желУдкА]},
  url = {https://www.scopus.com/pages/publications/85114092937?origin=resultslist},
  year = {2021}
}

@conference{Aseena2025,
  abstract = {Unusual growths found in the lining of the stomach are referred to as gastric polyps, the presence of such can be detected using upper endoscopic imaging. Detecting stomach polyps early is very crucial to prevent gastrointestinal cancers. Endoscopic imaging is a standard diagnostic tool recommended by medical practitioners to investigate the upper intestinal tract. This procedure often suffers from inconsistencies in illumination, color balance and contrast, hindering polyp identification. The current work investigates the impact of various image preprocessing and image enhancement techniques on the Kvasir dataset, a publicly available collection of gastric endoscopic images. This work evaluates techniques like resizing, rescaling, normalization, contrast enhancement, color space conversion (Lab), contrast stretching, Contrast Limited Adaptive Histogram Equalization, unsharp masking, and Histogram equalization. The effectiveness of these techniques is assessed through qualitative and quantitative analysis and their impact on polyp visibility for improved computer-aided diagnosis systems. Quantitative analysis based on evaluation metrics like Peak Signal-To-Noise Ratio, Mean Squared Error and Structural Similarity Index, is calculated and a comparative study for the various enhancement techniques was done in this work. © 2025 IEEE.},
  author = {Aseena, A. and Paul, Shiny},
  author_keywords = {CLAHE; Contrast Stretching; Endoscopy; Histogram Equalization; image preprocessing; MSE; PSNR; SSIM},
  journal = {International Conference on Trends in Engineering Systems and Technologies, ICTEST 2025 - Proceedings},
  keywords = {Computer aided analysis; Computer aided diagnosis; Equalizers; Graphic methods; Image enhancement; Mean square error; Medical imaging; CLAHE; Contrast stretching; Endoscopic imaging; Histogram equalizations; Image preprocessing; MSE; Performances evaluation; Polyp detection; PSNR; SSIM; Endoscopy},
  title = {Performance Evaluation of various Image Enhancement Techniques for Gastric Polyp Detection in the Kvasir Dataset},
  url = {https://www.scopus.com/pages/publications/105010373696?origin=resultslist},
  year = {2025}
}

@article{ASIF2024105866,
  abstract = {Gastrointestinal (GI) diseases are the most common in the human digestive system and has a significantly higher mortality rate. Accurate evaluation of endoscopic images plays an important role in decision making regarding patient treatment. Recently, convolutional neural networks (CNNs) have been introduced for the diagnosis of GI diseases. However, achieving high accuracy is still a challenging task. To overcome these limitations, we propose the “Densely Connected Depth-wise Separable Convolution-Based Network” (DCDS-Net) model, utilizing depth-wise separable convolution (DWSC) with residual connections and densely connected blocks (DCB), to effectively diagnose various endoscopic images of GI diseases. In addition, we incorporate global average pooling (GAP), batch normalization, dropout and dense layers in DCB to learn rich discriminative features and improve the performance of the model. We explored the feasibility of block-wise fine-tuning using transfer learning on the proposed model to reduce overfitting, and experimentally explore the optimal level of fine-tuning, since transfer learning is well suited to medical data where labeled data is scarce. The proposed method has been evaluated on 6000 labeled endoscopic images containing 4 classes of GI diseases. In addition, data augmentation has been incorporated into the training pipeline to improve the performance of the model. Furthermore, a critical study was conducted to evaluate the generalizability of the proposed model on smaller training samples (e.g., 60 %, 70 %, 80 %, and 90 %). The study employed Grad-CAM to generate heatmaps that identify the regions in the GI tract that are indicative of the presence of different diseases. The results of extensive experiments show that the proposed model shows significant improvements and achieves the highest classification accuracy of 99.33 %, precision of 99.37 %, recall of 99.32 % and outperforms all pre-trained and existing models for the detection of GI diseases. In conclusion, DCDS-Net exhibits high classification performance and can help endoscopists in automatic GI disease diagnosis.},
  author = {Sohaib Asif and Ming Zhao and Fengxiao Tang and Yusen Zhu},
  doi = {https://doi.org/10.1016/j.bspc.2023.105866},
  issn = {1746-8094},
  journal = {Biomedical Signal Processing and Control},
  keywords = {Gastrointestinal diseases, Endoscopy, Block-wise fine-tuning, Deep learning, Depth-wise separable convolution},
  pages = {105866},
  title = {DCDS-Net: Deep transfer network based on depth-wise separable convolution with residual connection for diagnosing gastrointestinal diseases},
  url = {https://www.sciencedirect.com/science/article/pii/S1746809423012995},
  volume = {90},
  year = {2024}
}

@article{ASIF2025128272,
  abstract = {Brain tumors pose a significant threat, necessitating accurate and timely diagnosis for effective treatment. Manually identifying tumors in large MRI datasets is time-consuming and challenging. While deep learning models can assist, they often overfit due to complexity and struggle to capture multi-scale features because of their linear, single-branched architectures, negatively impacting detection performance. This paper introduces HMDFF-Net, a novel lightweight deep learning model designed to enhance both accuracy and efficiency in brain tumor detection. Leveraging MobileNet as its backbone, HMDFF-Net reduces computational costs while maintaining high diagnostic accuracy. The model incorporates the Multi-Scale Depth-wise Dilated Residual Network (MSDDR-Net), a custom CNN designed to capture intricate, multi-scale features essential through its multiple branches for precise tumor analysis. MSDDR-Net uses dilated convolutions to expand the receptive field without increasing parameters, enabling detailed contextual understanding. Additionally, HMDFF-Net employs a unique feature fusion approach that integrates features from both MobileNet and MSDDR-Net branches, enhancing generalization across various medical imaging modalities. Finally, the Orthogonal SoftMax Layer (OSL) is used as the classifier to improve feature discrimination by maintaining orthogonality among weight vectors. To evaluate the broader applicability and generalizability of HMDFF-Net, we tested it on three brain MRI datasets— the Brain Tumor MRI Dataset (7,023 images), Br35H dataset (3,000 images), and Figshare benchmark dataset (3,064 images). Additionally, we assessed its performance across four other imaging modalities: 1,142 CT images from the IQ-OTHNCCD lung cancer dataset, 25,000 histopathological images of lung and colon cancer, 6,000 endoscopic images of gastrointestinal diseases, and 1,159 skin disease images. To improve model interpretability, we integrated LIME and Grad-CAM techniques. Experimental results show that HMDFF-Net outperforms traditional deep CNNs and state-of-the-art methods in both accuracy and efficiency. It achieved 99.31 %, 99.33 %, and 97.43 % on three brain MRI datasets; 97.45 % on the IQ-OTHNCCD lung CT dataset; 99.90 % on histopathological images; 99.75 % on endoscopic images; and 97.85 % on the skin disease dataset. The model also provides faster inference with fewer parameters and FLOPS compared to other deep CNNs. It provides a robust solution for precise and interpretable detection and classification across various imaging modalities, potentially enhancing patient care and treatment planning.},
  author = {Sohaib Asif and Enyu Wang and Vicky Yang Wang and Dong Xu},
  doi = {https://doi.org/10.1016/j.eswa.2025.128272},
  issn = {0957-4174},
  journal = {Expert Systems with Applications},
  keywords = {Multi-Scale Network, Hierarchical Feature Fusion, Dilated Convolutions, Brain MRI Detection, Medical Imaging},
  pages = {128272},
  title = {HMDFF-Net: Hierarchical multi-scale dilated feature fusion network for accurate multiclass diagnosis of brain tumors},
  url = {https://www.sciencedirect.com/science/article/pii/S0957417425018913},
  volume = {287},
  year = {2025}
}

@conference{Asiimwe2024166,
  abstract = {Medical image segmentation is crucial for precise diagnosis, treatment planning, and disease monitoring in clinical practice. Despite the advancements in segmentation models inspired by the Segment Anything Model (SAM) architecture, their real-time application is limited due to computational inefficiencies arising from transformer-based architectures. We introduce EfficientMedSAM, a suite of high-speed, memory-efficient foundation models for universal medical image segmentation. Our approach leverages differentiable neural architecture search (NAS) to explore a novel search space emphasizing efficient operations over traditional attention mechanisms. The generated candidate architectures are further refined through knowledge distillation from larger MedSAM models and evaluated on the Kvasir dataset of endoscopic images. EfficientMedSAM achieves competitive mean Average Precision (mAP) while substantially reducing Multiply-Accumulate operations (MACs) and model parameters, enhancing throughput. We integrate a knowledge distillation (KD) pipeline that transfers knowledge from logits and attention maps, using saliency maps as proxies for attention map-based distillation. Our findings establish a proof of concept for largescale distributed training on the SA-Med2D-20M dataset, paving the way for real-time medical image segmentation advancements.  © 2024 IEEE.},
  author = {Asiimwe, Arnold Caleb and Das, William and Benmeziane, Hadjer and Maghraoui, Kaoutar El},
  author_keywords = {Edge Computing; Knowledge Distillation; Medical Image Segmentation; Neural Architecture Search},
  doi = {10.1109/EDGE62653.2024.00030},
  journal = {Proceedings - IEEE International Conference on Edge Computing},
  keywords = {Disease control; Medical image processing; Clinical practices; Disease monitoring; Edge computing; Knowledge distillation; Medical image segmentation; Modeling architecture; Neural architecture search; Neural architectures; Segmentation models; Treatment planning; Image segmentation},
  title = {EfficientMedSAM: Accelerating Medical Image Segmentation via Neural Architecture Search and Knowledge Distillation},
  url = {https://www.scopus.com/pages/publications/85203296127?origin=resultslist},
  year = {2024}
}

@article{Au20251,
  abstract = {As large language models increasingly permeate medical workflows, a recent study evaluating ChatGPT 4.0’s performance in addressing patient queries about endoscopic submucosal dissection and endoscopic mucosal resection offers critical insights into three domains: Performance parity, cost democratization, and clinical readiness. The findings highlight ChatGPT’s high accuracy, completeness, and comprehensibility, suggesting potential cost efficiency in patient education. Yet, cost-effectiveness alone does not ensure clinical utility. Notably, the study relied exclusively on text-based prompts, omitting multimodal data such as photographs or endoscopic scans. This is a significant limitation in a visually driven field like endoscopy, where large language model performance may drop precipitously without image context. Without multimodal integration, artificial intelligence tools risk failing to capture key diagnostic signals, underscoring the need for cautious adoption and robust validation in clinical practice. ©The Author(s) 2025.},
  author = {Au, Sunny Chi Lik},
  author_keywords = {Artificial intelligence; ChatGPT; Cost; Endoscopic mucosal resection; Endoscopic submucosal dissection; Large language models; Patient education},
  doi = {10.4251/wjgo.v17.i12.114341},
  journal = {World Journal of Gastrointestinal Oncology},
  keywords = {Article; artificial intelligence; ChatGPT; clinical effectiveness; clinical practice; cost; cost effectiveness analysis; endoscopic mucosal resection; endoscopic submucosal dissection; endoscopy; human; large language model; patient education; photography; reliability; workflow},
  title = {Cost vs clinical utility on application of large language models in clinical practice: A double-edged sword},
  url = {https://www.scopus.com/pages/publications/105025694085?origin=resultslist},
  year = {2025}
}

