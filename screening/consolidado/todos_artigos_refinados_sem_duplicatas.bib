@article{Kim2022319,
  abstract = {Esophagogastroduodenoscopy (EGD) has been used to diagnose a wide variety of upper gastrointestinal diseases. In particular, EGD is used to screen high-risk subjects of gastric cancer. Quality control of EGD is important because the diagnostic rate is examiner-dependent. However, there is still no representative quality indicator that can be uniformly applied in EGD. There has been growing awareness of the importance of quality control in improving EGD performance. Therefore, we aimed to review the available and emerging quality indicators for diagnostic EGD. © 2022 Korean Society of Gastrointestinal Endoscopy},
  author = {Kim, Sang Yoon and Park, Jae Myung},
  author_keywords = {Detection rate; Esophagogastroduodenoscopy; Guideline; Neoplasms; Quality indicators},
  journal = {Clinical Endoscopy},
  keywords = {antifoaming agent; mucolytic agent; spasmolytic agent; artificial intelligence; clinical protocol; endoscopic biopsy; esophagogastroduodenoscopy; gastrointestinal disease; human; medical education; premedication; Review; sedation},
  title = {Quality indicators in esophagogastroduodenoscopy},
