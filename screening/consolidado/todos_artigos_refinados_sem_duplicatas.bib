@article{Tang2023,
  abstract = {Despite being widely utilized to help endoscopists identify gastrointestinal (GI) tract diseases using classification and segmentation, models based on convolutional neural network (CNN) have difficulties in distinguishing the similarities among some ambiguous types of lesions presented in endoscopic images, and in the training when lacking labeled datasets. Those will prevent CNN from further improving the accuracy of diagnosis. To address these challenges, we first proposed a Multi-task Network (TransMT-Net) capable of simultaneously learning two tasks (classification and segmentation), which has the transformer designed to learn global features and can combine the advantages of CNN in learning local features so that to achieve a more accurate prediction in identifying the lesion types and regions in GI tract endoscopic images. We further adopted the active learning in TransMT-Net to tackle the labeled image-hungry problem. A dataset was created from the CVC-ClinicDB dataset, Macau Kiang Wu Hospital, and Zhongshan Hospital to evaluate the model performance. Then, the experimental results show that our model not only achieved 96.94% accuracy in the classification task and 77.76% Dice Similarity Coefficient in the segmentation task but also outperformed those of other models on our test set. Meanwhile, active learning also produced positive results for the performance of our model with a small-scale initial training set, and even its performance with 30% of the initial training set was comparable to that of most comparable models with the full training set. Consequently, the proposed TransMT-Net has demonstrated its potential performance in GI tract endoscopic images and it through active learning can alleviate the shortage of labeled images. © 2023 Elsevier Ltd},
  author = {Tang, Suigu and Yu, Xiaoyuan and Cheang, Chak Fong and Liang, Yanyan and Zhao, Penghui and Yu, Hon Ho and Choi, I Cheong},
  author_keywords = {Active learning; Classification; Multi-task learning; Segmentation; Transformer},
  journal = {Computers in Biology and Medicine},
  keywords = {Endoscopy, Gastrointestinal; Gastrointestinal Tract; Image Processing, Computer-Assisted; Neural Networks, Computer; Convolutional neural networks; Endoscopy; Hospitals; Image classification; Image segmentation; Learning systems; Active Learning; Convolutional neural network; Endoscopic image; Gastrointestinal tract; Labeled images; Multitask learning; Performance; Segmentation; Training sets; Transformer; Article; classification algorithm; computer prediction; computer vision; convolutional neural network; deep learning; deep neural network; endoscopist; false negative result; false positive result; feature extraction; gastrointestinal cancer; gastrointestinal endoscopy; human; image analysis; image segmentation; machine learning; receiver operating characteristic; residual neural network; stomach polyp; transformer based multi task network; diagnostic imaging; gastrointestinal endoscopy; gastrointestinal tract; image processing; procedures; Classification (of information)},
  title = {Transformer-based multi-task learning for classification and segmentation of gastrointestinal tract endoscopic images},
  url = {https://www.scopus.com/pages/publications/85149790096?origin=resultslist},
  year = {2023}
}

@article{Tao20241319,
  abstract = {Background and Aims: The diagnosis and stratification of gastric atrophy (GA) predict patients’ gastric cancer progression risk and determine endoscopy surveillance interval. We aimed to construct an artificial intelligence (AI) system for GA endoscopic identification and risk stratification based on the Kimura-Takemoto classification. Methods: We constructed the system using two trained models and verified its performance. First, we retrospectively collected 869 images and 119 videos to compare its performance with that of endoscopists in identifying GA. Then, we included original image cases of 102 patients to validate the system for stratifying GA and comparing it with endoscopists with different experiences. Results: The sensitivity of model 1 was higher than that of endoscopists (92.72% vs. 76.85 %) at image level and also higher than that of experts (94.87% vs. 85.90 %) at video level. The system outperformed experts in stratifying GA (overall accuracy: 81.37 %, 73.04 %, p = 0.045). The accuracy of this system in classifying non-GA, mild GA, moderate GA, and severe GA was 80.00 %, 77.42 %, 83.33 %, and 85.71 %, comparable to that of experts and better than that of seniors and novices. Conclusions: We established an expert-level system for GA endoscopic identification and risk stratification. It has great potential for endoscopic assessment and surveillance determinations. © 2024 The Author(s)},
  author = {Tao, Xiao and Zhu, Yijie and Dong, Zehua and Huang, Li and Shang, Renduo and Du, Hongliu and Wang, Junxiao and Zeng, Xiaoquan and Wang, Wen and Wang, Jiamin and Li, Yanxia and Deng, Yunchao and Wu, Lianlian and Yu, Honggang},
  author_keywords = {Artificial intelligence; Chronic atrophic gastritis; Risk stratification},
  journal = {Digestive and Liver Disease},
  keywords = {Adult; Aged; Artificial Intelligence; Female; Gastritis, Atrophic; Gastroscopy; Humans; Male; Middle Aged; Retrospective Studies; Risk Assessment; Sensitivity and Specificity; Stomach Neoplasms; Article; artificial intelligence; atrophic gastritis; comparative effectiveness; controlled study; diagnostic accuracy; diagnostic test accuracy study; disease classification; disease risk assessment; disease severity; endoscopist; experience; human; major clinical study; medical expert; predictive value; residual neural network; retrospective study; sensitivity and specificity; validation process; videorecording; white light endoscopy; adult; aged; atrophic gastritis; diagnosis; female; gastroscopy; male; middle aged; pathology; procedures; risk assessment; stomach tumor},
  title = {An artificial intelligence system for chronic atrophic gastritis diagnosis and risk stratification under white light endoscopy},
  url = {https://www.scopus.com/pages/publications/85183119302?origin=resultslist},
  year = {2024}
}

@article{TAO20241319,
  abstract = {Background and Aims
The diagnosis and stratification of gastric atrophy (GA) predict patients’ gastric cancer progression risk and determine endoscopy surveillance interval. We aimed to construct an artificial intelligence (AI) system for GA endoscopic identification and risk stratification based on the Kimura-Takemoto classification.
Methods
We constructed the system using two trained models and verified its performance. First, we retrospectively collected 869 images and 119 videos to compare its performance with that of endoscopists in identifying GA. Then, we included original image cases of 102 patients to validate the system for stratifying GA and comparing it with endoscopists with different experiences.
Results
The sensitivity of model 1 was higher than that of endoscopists (92.72% vs. 76.85 %) at image level and also higher than that of experts (94.87% vs. 85.90 %) at video level. The system outperformed experts in stratifying GA (overall accuracy: 81.37 %, 73.04 %, p = 0.045). The accuracy of this system in classifying non-GA, mild GA, moderate GA, and severe GA was 80.00 %, 77.42 %, 83.33 %, and 85.71 %, comparable to that of experts and better than that of seniors and novices.
Conclusions
We established an expert-level system for GA endoscopic identification and risk stratification. It has great potential for endoscopic assessment and surveillance determinations.},
