  author_keywords = {Artificial intelligence; Early gastric cancer; Gastrointestinal neoplasms; Oesophagogastroduodenoscopy; Quality control},
  journal = {eClinicalMedicine},
  keywords = {adult; aged; Article; artificial intelligence; clinical trial; control system; controlled study; endoscopist; esophagogastroduodenoscopy; female; gastrointestinal cancer; high-grade vaginal intraepithelial neoplasia; human; male; medical history; multicenter study; quality control; randomized controlled trial; single blind procedure; upper gastrointestinal cancer},
  title = {Efficacy of a real-time intelligent quality-control system for the detection of early upper gastrointestinal neoplasms: a multicentre, single-blinded, randomised controlled trial},
