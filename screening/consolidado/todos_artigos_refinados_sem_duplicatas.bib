  doi = {10.1684/hpg.2025.3068},
  journal = {Hepato-Gastro et Oncologie Digestive},
  keywords = {algorithm; Article; artificial intelligence; artificial intelligence-assisted diagnosis; capsule endoscopy; cholangioscopy; colonoscopy; computer assisted diagnosis; endoscopic ultrasonography; esophagogastroduodenoscopy; gastroenterologist; gastrointestinal endoscopy; human},
  title = {Artificial intelligence in digestive endoscopy: evolution or revolution?; [L’intelligence artificielle en endoscopie digestive: évolution ou révolution ?]},
