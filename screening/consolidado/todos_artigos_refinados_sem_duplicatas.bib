@conference{Li20254355,
  abstract = {Depth estimation is a cornerstone of 3D reconstruction and plays a vital role in minimally invasive endoscopic surgeries. However, most current depth estimation networks rely on traditional convolutional neural networks, which are limited in their ability to capture global information. Foundation models offer a promising approach to enhance depth estimation, but those models currently available are primarily trained on natural images, leading to suboptimal performance when applied to endoscopic images. In this work, we introduce a novel fine-tuning strategy for the Depth Anything Model and integrate it with an intrinsic-based unsupervised monocular depth estimation framework. Our approach includes a low-rank adaptation technique based on random vectors, which improves the model's adaptability to different scales. Additionally, we propose a residual block built on depthwise separable convolution to compensate for the transformer's limited ability to capture local features. Our experimental results on the SCARED dataset and Hamlyn dataset show that our method achieves state-of-the-art performance while minimizing the number of trainable parameters. Applying this method in minimally invasive endoscopic surgery can enhance surgeons' spatial awareness, thereby improving the precision and safety of the procedures.  © 2025 IEEE.},
  author = {Li, Bojian and Liu, Bo and Yao, Xinning and Yue, Jinghua and Zhou, Fugen},
  doi = {10.1109/IROS60139.2025.11246587},
  journal = {IEEE International Conference on Intelligent Robots and Systems },
  title = {Advancing Depth Anything Model for Unsupervised Monocular Depth Estimation in Endoscopy},
  url = {https://www.scopus.com/pages/publications/105029954050?origin=resultslist},
  year = {2025}
}

@article{Li2025_1,
  abstract = {China’s response to the high prevalence of digestive tract diseases involves conducting large-scale endoscopic screening programs. However, the substantial diagnostic workload generated by these programs highlights a low staff-to-patient ratio. To address this challenge, we leverage artificial intelligence (AI) to assist in the computer-aided diagnosis (CAD) of endoscopic images. Specifically, we propose a CAD method that utilizes pre-trained large-scale vision-language models to support digestive endoscopy screening. This approach enables effective classification through the fusion of visual and textual information channels, making it particularly suitable for analyzing large-scale endoscopic datasets. Our model is trained on multicenter data collected from four hospitals, comprising 41,191 images that span 19 disease categories and four normal conditions. In comparative evaluations, our model outperforms eight state-of-the-art models. Furthermore, in a human–AI collaborative reading experiment, the model demonstrates superior diagnostic performance and faster decision-making times compared to six experienced endoscopists. These results underscore the model’s effectiveness in CAD for digestive endoscopy. Despite certain limitations, this study highlights our continued efforts to advance AI-assisted diagnostics and envisions a future where AI-driven endoscopic diagnosis becomes a clinical reality. © The Author(s) under exclusive licence to Society for Imaging Informatics in Medicine 2025.},
  author = {Li, Yilin and Du, Zhonghua and Li, Renbo and Gong, Yansheng and Zhao, Zijian and Fengyu, Gao},
  author_keywords = {Convolutional neural network; Digestive endoscopy screening; Large-scale visual-language model; Multi-head attention},
  doi = {10.1007/s10278-025-01560-0},
  journal = {Journal of Imaging Informatics in Medicine},
  keywords = {Artificial intelligence; Classification (of information); Computer aided design; Computer aided diagnosis; Decision making; Digestive system; Large datasets; Medical computing; Program diagnostics; Visual languages; Computer-aided; Convolutional neural network; Digestive endoscopy screening; Digestive tract; Endoscopic image; Large-scale visual-language model; Large-scales; Multi-head attention; Screening programs; Visual language model; Endoscopy},
  title = {Computer-Aided Diagnosis Using the Large-Scale Visual Language Models in Screening of Digestive Endoscopy},
  url = {https://www.scopus.com/pages/publications/105012943640?origin=resultslist},
  year = {2025}
}

@article{Li2026,
  abstract = {Early diagnosis of gastrointestinal diseases using deep learning remains challenging due to the limited availability of annotated endoscopic images. Although vision–language models have demonstrated strong performance in natural image understanding, their direct application to medical endoscopy is limited by the semantic discrepancy between natural and clinical domains. To address these issues, we propose an Attribute-Driven Prompt Learning (ADPL) framework that leverages vision–language models to enhance few-shot gastrointestinal disease classification. The proposed ADPL consists of two core components: attribute description generation and cross-modal prompt optimization. Specifically, attribute description generation, which employs large language models to generate standardized medical attribute descriptions (color, shape, texture, and boundary) through visual question answering for semantic guidance. Cross-modal prompt optimization aims to integrate the generated attribute descriptions with learnable visual and attribute prompts via the Attribute-to-Visual Fuser (AVF) and leverages prompt learning to enable domain adaptation to gastrointestinal endoscopy. Experiments were conducted on four gastrointestinal endoscopy datasets under few-shot settings, with each class limited to 1, 2, 4, 8, 16 annotated training samples. The results demonstrate that ADPL achieves state-of-the-art performance, significantly outperforms multiple advanced few-shot learning methods in gastrointestinal endoscopy classification. The code will be available at https://github.com/Xqq0qwq/ADPL. © 2026 Elsevier Ltd},
  author = {Li, Weiheng and Tang, Suigu and Liu, Huazhu and Cheang, Chak Fong and Liang, Yanyan and Zhao, Xiaofang and Nong, Jian},
  author_keywords = {Few-shot learning; Gastrointestinal endoscopy; Prompt learning; Vision–language model},
  doi = {10.1016/j.bspc.2026.110337},
  journal = {Biomedical Signal Processing and Control},
  keywords = {Deep learning; Endoscopy; Gastroenterology; Learning systems; Medical imaging; Sampling; Semantics; Visual languages; Cross-modal; Disease classification; Early diagnosis; Few-shot learning; Gastrointestinal Disease; Gastrointestinal endoscopies; Language model; Optimisations; Prompt learning; Vision–language model; Classification (of information)},
  title = {Attribute-driven prompt learning with vision–language models for few-shot gastrointestinal disease classification},
  url = {https://www.scopus.com/pages/publications/105036190817?origin=resultslist},
  year = {2026}
}

@article{Li2026_1,
  abstract = {Accurate recognition of lesions in endoscopic images is essential for effective diagnosis and treatment. Multi-modal learning effectively utilizes complementary clues derived from multiple modalities, which can promote performance in lesion area detection. However, accessing the amount of annotated paired images for multi-modal learning is time-consuming and costly. Segment Anything Model (SAM) is a powerful vision foundation model that excels in natural image segmentation, but it encounters performance degradation in endoscopic scenes due to a lack of medical-specific knowledge. Besides, the simple structure of the SAM decoder fails to effectively capture fine-grained details among complex lesion structures and low-contrast tissue organs in endoscopic images. To utilize the powerful feature extraction capability of the foundation model and address the scarcity dilemma in medical image annotation, we present a novel prompt-free SAM-assisted framework, Semi-MedSAM, for semi-supervised multi-modal learning. The proposed Semi-MedSAM integrates an effective SAM-based backbone comprising a designed multi-expert-instructed encoder as well as a hierarchical prototypical decoder into a prompt-free semi-supervised framework. Extensive experiments on three multi-modal endoscopic datasets demonstrate the superior segmentation performance of our Semi-MedSAM. © 2026 Elsevier Ltd},
  author = {Li, Junhao and Li, Yun and Wu, Junhao and Ji, Chaojie and Chen, Zhijie and Lei, Wenbin and Wang, Ruxin},
  author_keywords = {Endoscopic image; Medical image segmentation; Multi-modality; Semi-supervised learning},
  doi = {10.1016/j.patcog.2026.113206},
  journal = {Pattern Recognition},
  keywords = {Decoding; Endoscopy; Image analysis; Image annotation; Medical image processing; Semi-supervised learning; Endoscopic image; Foundation models; Images segmentations; Medical image segmentation; Multi-modal learning; Multi-modality; Multiple modalities; Performance; Semi-supervised; Semi-supervised learning; Image segmentation},
  title = {Semi-MedSAM: Adapting SAM-assisted semi-supervised multi-modality learning for medical endoscopic image segmentation},
  url = {https://www.scopus.com/pages/publications/105029230942?origin=resultslist},
  year = {2026}
}

@article{Li2026_2,
  abstract = {Esophageal whitish plaques are common findings in large-scale esophageal cancer screenings, requiring accurate preliminary differentiation to guide appropriate clinical management. This study presents a computer-aided diagnosis (CAD) system based on the pre-trained large-scale visual-language (VL) model BLIP for automated diagnosis and description of esophageal whitish plaques. A dataset of 13,922 endoscopic images was used for model training, and comparative experiments were conducted with multiple benchmark models, including Poolformer, Swin-Transformer, TransMSF, and ViT. The results demonstrate that our approach outperforms existing methods in terms of precision, recall, F1 score, and accuracy. Compared with LLaVA-Med, our model significantly improves keyword accuracy (K-ACC) in medical text descriptions. A human-machine competition further demonstrated that our model outperforms both senior and junior endoscopists, particularly excelling in the recall of early esophageal cancer cases. These findings suggest that integrating pre-trained VL models into CAD systems can enhance the accuracy and efficiency of esophageal whitish plaque diagnosis, reducing misdiagnoses and supporting clinical decision-making. © The Author(s) 2026.},
  author = {Li, Yilin and Li, Xin and Zhang, Di and Zhu, Wenwen and Hu, Yuan and Zhao, Zijian and Zhao, Qi},
  doi = {10.1038/s41698-026-01301-8},
  journal = {npj Precision Oncology},
  keywords = {Article; automation; benchmarking; cancer screening; clinical decision making; comparative study; computer aided design; controlled study; convolutional neural network; deep learning; diagnostic accuracy; diagnostic error; diagnostic test accuracy study; early cancer; endoscopist; esophageal papilloma; esophageal whitish plaque; esophagus cancer; esophagus disease; feature noise generator; fungal esophagitis; glycogenic acanthosis; human; image analysis; image noise; large language model; large visual language model; loss function of training; machine learning; major clinical study; narrow band imaging; Pythonidae; retrospective study; white light endoscopy},
  title = {The application of pre-trained large visual-language models for preliminary diagnosis of esophageal whitish plaques in large-scale esophageal cancer screening},
  url = {https://www.scopus.com/pages/publications/105031756863?origin=resultslist},
  year = {2026}
}

@article{Li2026_3,
  abstract = {In minimally invasive spinal endoscopic surgery, intraoperative bleeding remains a major challenge as it obscures the surgical view, elevates operative risks, and may cause postoperative complications. Accurate bleeding segmentation from endoscopic images is difficult due to highly variable morphology, vague boundaries, and color similarity with surrounding tissues. To address this challenge, we propose SGBA-Net, a Semantic-Guided Bleeding-Aware Segmentation Network for precise bleeding segmentation. SGBA-Net integrates CLIP-based language prompts (“red bleeding region”) into DINOv2 via an adapter to enhance bleeding-awareness of visual features. A prior segmentation head produces coarse masks, which are progressively refined by SAM2 with multimodal guidance to achieve coarse-to-fine precision. Furthermore, we construct SeBlood, a new dataset of 1421 spinal endoscopic images with pixel-level bleeding annotations. Experimental results demonstrate that SGBA-Net consistently outperforms state-of-the-art models on SeBlood. This work offers an effective solution for intraoperative bleeding segmentation and establishes a new paradigm for leveraging foundation models in complex medical image analysis. © 2026 Elsevier B.V.},
  author = {Li, Guoliang and Meng, Fanxu and Li, Qianqian and Li, Yibin and Qi, Lei and Song, Rui},
  author_keywords = {Bleeding detection; Medical image segmentation; Parameter-efficient tuning; Semantic-guided segmentation},
  doi = {10.1016/j.neucom.2026.133547},
  journal = {Neurocomputing},
  keywords = {Color image processing; Medical image processing; Semantic Segmentation; Semantic Web; Semantics; Transplantation (surgical); Bleeding detections; Bleedings; Endoscopic image; Endoscopic surgery; Intra-operative; Medical image segmentation; Minimally invasive; Parameter-efficient tuning; Postoperative complications; Semantic-guided segmentation; Article; bleeding; computer aided design; deep learning; discriminant analysis; embedding; endoscopic surgery; endoscopy; feature extraction; gastrointestinal hemorrhage; generalization (psychology); hierarchical clustering; human; image analysis; image segmentation; implementation science; large language model; logistic regression analysis; lumbar discectomy; natural language processing; postoperative complication; qualitative analysis; semantics; sensitivity analysis; support vector machine; volumetry; Endoscopy},
  title = {SGBA-Net: Semantic-guided bleeding-aware segmentation network for spinal endoscopy},
  url = {https://www.scopus.com/pages/publications/105034618958?origin=resultslist},
  year = {2026}
}

