  journal = {Endoscopy},
  keywords = {Adult; Aged; Artificial Intelligence; Female; Gastroscopy; Humans; Male; Middle Aged; Neural Networks, Computer; Peptic Ulcer Hemorrhage; Prospective Studies; Reproducibility of Results; Retrospective Studies; ROC Curve; Video Recording; Article; artificial intelligence; China; comparative study; convolutional neural network; disease classification; endoscopist; human; major clinical study; multicenter study; peptic ulcer bleeding; prospective study; receiver operating characteristic; retrospective study; validation study; videorecording; adult; aged; artificial intelligence; artificial neural network; classification; clinical trial; female; gastroscopy; male; middle aged; peptic ulcer bleeding; procedures; reproducibility},
  title = {Artificial intelligence-assisted system for the assessment of Forrest classification of peptic ulcer bleeding: A multicenter diagnostic study},
