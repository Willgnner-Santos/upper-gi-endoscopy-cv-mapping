@conference{Yoon2025594,
  abstract = {The ability to analyze medical images accurately and efficiently in real time is of paramount importance, especially in healthcare settings supported by telemedicine and IoT. In this paper, we propose a novel lesion-based attention mechanism (LAM) specifically designed to enhance lesion detection and analysis of endoscopic images in telemedicine applications. We integrate LAM with a state-of-the-art convolutional neural network (CNN) based lightweight detection model to achieve high-performance lesion detection while maintaining computational efficiency. LAM improves the ability of the model to identify and analyze lesions such as gastric ulcers, polyps, and early signs of cancer, by selectively focusing on critical spatial and edge features within endoscopic images. We evaluated the proposed mechanism using the Kvasir gastroscopy dataset. In these evaluations, LAM shows an improvement in the performance of the existing model by about 9.64% with only 1.75 MB additional parameters. In addition, it also outperforms other studies by approximately 4.71% on average compared to existing gastroscopy studies. Furthermore, we performed object detection on real patient endoscopic images, confirming that LAM enhances the accuracy of practical diagnostic models. This study presents a highly applicable solution for remote real-time diagnosis in resource-constrained medical environments, contributing to the advancement of AI-assisted telemedicine systems.  © 2025 IEEE.},
  author = {Yoon, Namkyung and Joo, Hyeontae and Kim, Hwangnam},
  author_keywords = {Attention mechanism; Deep learning; Telemedicine},
  doi = {10.1109/AIoT66900.2025.00089},
  journal = {Proceedings - 2025 IEEE Annual Congress on Artificial Intelligence of Things, AIoT 2025},
  keywords = {Attention mechanism; Deep learning; Telemedicine},
  title = {A Lesion-Based Attention Mechanism for Real-Time, Lightweight, and Performance-Enhanced Endoscopic Image Analysis},
  url = {https://www.scopus.com/pages/publications/105035767292?origin=resultslist},
  year = {2025}
}

