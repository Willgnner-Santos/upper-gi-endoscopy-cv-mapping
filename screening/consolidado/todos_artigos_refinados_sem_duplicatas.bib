}

@article{He2025,
  abstract = {This study aims to address the diagnostic challenges in distinguishing gastric polyps from protrusions, emphasizing the need for accurate and cost-effective diagnosis strategies. It explores the application of Convolutional Neural Networks (CNNs) to improve diagnostic accuracy. This research introduces MultiAttentiveScopeNet, a deep learning model that incorporates multi-layer feature ensemble and attention mechanisms to enhance gastroscopy image analysis accuracy. A weakly supervised labeling strategy was employed to construct a large multi-class gastroscopy image dataset for training and validation. MultiAttentiveScopeNet demonstrates significant improvements in prediction accuracy and interpretability. The integrated attention mechanism effectively identifies critical areas in images to aid clinical decisions. Its multi-layer feature ensemble enables robust analysis of complex gastroscopy images. Comparative testing against human experts shows exceptional diagnostic performance, with accuracy, micro and macro precision, micro and macro recall, and micro and macro AUC reaching 0.9308, 0.9312, 0.9325, 0.9283, 0.9308, 0.9847 and 0.9853 respectively. This highlights its potential as an effective tool for primary healthcare settings. This study provides a comprehensive solution to address diagnostic challenges differentiating gastric polyps and protrusions. MultiAttentiveScopeNet improves accuracy and interpretability, demonstrating the potential of deep learning for gastroscopy image analysis. The constructed dataset facilitates continued model optimization and validation. The model shows promise in enhancing diagnostic outcomes in primary care. © The Author(s) 2025.},
  author = {He, Chunyou and Zhang, Jingda and Liang, Yunxiao and Li, Hao},
  journal = {Scientific Reports},
  keywords = {Adenomatous Polyps; Deep Learning; Gastroscopes; Gastroscopy; Humans; Image Processing, Computer-Assisted; Neural Networks, Computer; Polyposis, Gastric; Polyps; Stomach Neoplasms; adenomatous polyp; artificial neural network; deep learning; diagnosis; diagnostic imaging; gastroscope; gastroscopy; human; image processing; pathology; polyp; procedures; stomach tumor},
  title = {A unified framework harnessing multi-scale feature ensemble and attention mechanism for gastric polyp and protrusion identification in gastroscope imaging},
  url = {https://www.scopus.com/pages/publications/85218967501?origin=resultslist},
  year = {2025}
}

@conference{He20256671,
  abstract = {Upper gastrointestinal (GI) diseases are a major health threat. Especially gastric cancer, which is the 5th most common cancer worldwide and the 3rd common cause of cancer death. In the U.S., around 62 million people are diagnosed with digestive disorders annually. Gastroscopy is currently the only commonly recognized effective method for screening and treatment. Even though there are many machine learning-based techniques for computer-aided detection and diagnosis, multimodal models that integrate both textual and visual information are extremely lacking. In this paper, we present a foundational multimodal framework for upper GI endoscopy, adapting recent vision-language model architectures. For the first time, we have applied large-scale multimodal modeling in the upper gas-trointestinal (GI) endoscopy field, which is a domain that has received less attention in prior medical image research. Based on the four downstream tasks established in previous work, our framework integrates both public and internal GI endoscopy expert-annotated datasets. Through the unified instruction-based fine-tuning pipeline, the framework sup-ports most upper GI diagnostic, detection, and reporting scenarios. It not only covers clinical tasks such as anatomical recognition, lesion diagnosis, and lesion localization, but also enables natural language interaction and communication with clinicians, greatly enhancing the model's practicality and clinical value. Experimental results show that the framework can generalization and perform in var-ious GI endoscopy tasks. It is able to handle a variety of medical tasks and report summarization capabilities that meet the needs of medical experts. Although it still has space for improvement in some tasks, the framework lays the foundation for further optimization and wider application. © 2025 IEEE.},
  author = {He, Yuxuan and Chen, Qilei and Liu, Benyuan and Cao, Yu},
  doi = {10.1109/ICCVW69036.2025.00689},
  journal = {Proceedings - 2025 IEEE/CVF International Conference on Computer Vision Workshops, ICCV-W 2025},
  keywords = {Artificial intelligence; Computer aided diagnosis; Diseases; Health risks; Learning systems; Medical imaging; Visual languages; Computer-aided detection and diagnosis; Gastric cancers; Gastrointestinal Disease; Gastrointestinal endoscopies; Machine-learning; Multi tasks; Multimodal models; Textual information; Upper gastrointestinal; Visual information; Endoscopy},
  title = {Foundational Multi-Task Multimodal Model for Upper GI Endoscopy},
  url = {https://www.scopus.com/pages/publications/105035153349?origin=resultslist},
  year = {2025}
}

@article{He2026106,
  abstract = {Pre-training on image-text colonoscopy records offers substantial potential for improving endoscopic image analysis, but faces challenges including non-informative background images, complex medical terminology, and ambiguous multi-lesion descriptions. We introduce Endo-CLIP, a novel self-supervised framework that enhances Contrastive Language-Image Pre-training (CLIP) for this domain. Endo-CLIP’s three-stage framework—cleansing, attunement, and unification—addresses these challenges by: (1) removing background frames, (2) leveraging large language models (LLMs) to extract clinical attributes for fine-grained contrastive learning, and (3) employing patient-level cross-attention to resolve multi-polyp ambiguities. Extensive experiments demonstrate that Endo-CLIP significantly outperforms state-of-the-art pre-training methods in zero-shot and few-shot polyp detection and classification, paving the way for more accurate and clinically relevant endoscopic analysis. Code will be made publicly available on https://github.com/chrlott/EndoCLIP. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  author = {He, Yili and Zhu, Yan and Fu, Peiyao and Yang, Ruijie and Chen, Tianyi and Wang, Zhihua and Li, Quanlin and Zhou, Pinghong and Yang, Xian and Wang, Shuo},
  author_keywords = {Endoscopy Image; Foundation Model; Language-Image Pre-training},
  doi = {10.1007/978-3-032-05141-7_11},
  journal = {Lecture Notes in Computer Science},
  keywords = {Learning systems; Medical image processing; Self-supervised learning; Text processing; Background image; Colonoscopy; Endoscopic image; Endoscopy image; Foundation models; Image analyze; Image texts; Image-analysis; Language-image pre-training; Pre-training; Endoscopy},
  title = {Endo-CLIP: Progressive Self-supervised Pre-training on Raw Colonoscopy Records},
  url = {https://www.scopus.com/pages/publications/105018053406?origin=resultslist},
  year = {2026}
}

@article{HE2026109620,
  abstract = {High-quality annotated datasets are essential for building robust endoscopic image segmentation models. However, acquiring large-scale annotations is both time-consuming and costly. Although semi-supervised learning alleviates the heavy reliance on annotated data, existing methods face limitations in handling high uncertainty within complex areas and adapting to multi-scale lesions. To address these challenges, this paper proposes the Uncertain Area Correction and Multi-scale Consistency Learning (UAC-MCL) framework, comprising the following key components: (1) An Uncertain Area Correction Module (UACM), which dynamically identifies uncertain areas and leverages a dynamically updated memory bank to formulate a weighted Uncertain Area Contrastive Loss (UACL), thereby facilitating uncertain feature representation learning; (2) A Multi-Scale Consistency Loss (MSCL) that enforces prediction consistency across resolutions between teacher and student models; (3) A Multi-scale Dynamic Area-Aware (MDAA) module equipped with Dynamic Area-Aware Attention (DAAA) mechanism. This mechanism dynamically directs attention toward high-confidence areas, thereby enabling the adaptive capture of diverse lesion features while effectively suppressing background interference. Extensive experiments on four endoscopic image segmentation datasets (Kvasir-SEG, CVC-ClinicDB, CVC-ColonDB, and ES-Gastric) demonstrate that UAC-MCL consistently outperforms state-of-the-art methods. Under the experimental setting of using only 25% of labeled data, our framework achieves mDice scores of 90.37% and 91.85%, along with mIoU scores of 90.42% and 92.24% on the Kvasir-SEG and CVC-ClinicDB datasets, respectively. The code is available at https://github.com/JiapingChen1/UAC-MCL.git.},
  author = {Dongzhi He and Jiaping Chen and Rui Zhang and Yu Liang and Yunqi Li},
  doi = {https://doi.org/10.1016/j.bspc.2026.109620},
  issn = {1746-8094},
  journal = {Biomedical Signal Processing and Control},
  keywords = {Semi-supervised learning, Endoscopic image segmentation, Uncertain area correction, Multi-scale consistency learning},
  pages = {109620},
  title = {Uncertain area correction and multi-scale consistency learning for semi-supervised endoscopic image segmentation},
  url = {https://www.sciencedirect.com/science/article/pii/S1746809426001746},
  volume = {117},
  year = {2026}
}

