@article{Cao2021,
  abstract = {This paper presents the research results of detecting gastric polyps with deep learning object detection method in gastroscopic images. Gastric polyps have various sizes. The difficulty of polyp detection is that small polyps are difficult to detect from the background. We propose a feature extraction and fusion module and combine it with the YOLOv3 network to form our network. This method performs better than other methods in the detection of small polyps because it can fuse the semantic information of high-level feature maps with low-level feature maps to help small polyps detection. In this work, we use a dataset of gastric polyps created by ourselves, containing 1433 training images and 508 validation images. We train and validate our network on our dataset. In comparison with other methods of polyps detection, our method has a significant improvement in precision, recall rate, F1, and F2 score. The precision, recall rate, F1 score, and F2 score of our method can achieve 91.6%, 86.2%, 88.8%, and 87.2%. © 2021 Cao et al. This is an open access article distributed under the terms of the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original author and source are credited.},
  author = {Cao, Chanting and Wang, Ruilin and Yu, Yao and Zhang, Hui and Yu, Ying and Sun, Changyin},
  journal = {PLoS ONE},
  keywords = {Gastroscopy; Humans; Intestinal Polyps; Neural Networks, Computer; ROC Curve; Stomach; Article; comparative study; deep neural network; diagnostic accuracy; F1 score; F2 score; gastroscopy; human; image analysis; major clinical study; mathematical model; polyp size; scoring system; semantics; stomach polyp; volume; intestine polyp; pathology; receiver operating characteristic; stomach},
  title = {Gastric polyp detection in gastroscopic images using deep neural network},
  url = {https://www.scopus.com/pages/publications/85104915807?origin=resultslist},
  year = {2021}
}

@conference{Cao2021852,
  abstract = {Gastroscopy is the main method of detecting gastric polyps. Specifically, the doctor observes the gastroscope image with the naked eye to determine the presence and location of polyps. The detection rate of polyps is affected by the doctor's experience, fatigue, and other factors. There is a certain degree of missed polyps. Therefore, it is necessary to detect polyps by auxiliary means. In this paper, we report a convolutional neural network for gastric polyp detection, which is based on the Single Shot MultiBox Detector (SSD). In order to improve the performance of polyp detection, an excellent feature extractor is essential. We adopt EfficientNet instead of VGG16 as the backbone network of the SSD. In addition, the previous loss function is improved, and the PReLU activation function is introduced into the SSD to achieve better detection performance. We conduct extensive experiments on the gastric polyp dataset. The final experimental results show that the improved SSD network for gastric polyp detection can achieve a precision of 90.3% and a recall rate of 85.7%, which is better than the original SSD network. © 2021 IEEE},
  author = {Cao, Chanting and Yu, Yao and Xie, Yun and Sun, Changyin},
  author_keywords = {Deep Learning; Gastric polyp; Single Shot MultiBox Detector},
  journal = {Proceeding - 2021 China Automation Congress, CAC 2021},
  keywords = {Convolutional neural networks; Endoscopy; Convolutional neural network; Deep learning; Detection rates; Detector networks; Gastric polyp; Naked-eye; Performance; Polyp detection; Single shot multibox detector; Single-shot; Deep learning},
  title = {An Efficient Approach for Gastric Polyps Detection Based on Improved SSD},
  url = {https://www.scopus.com/pages/publications/85128039753?origin=resultslist},
  year = {2021}
}

@article{Cao2025,
  abstract = {Autoimmune gastritis (AIG) has a strong correlation with gastric neuroendocrine tumors (NETs) and gastric cancer, making its timely and accurate diagnosis crucial for tumor prevention. The endoscopic manifestations of AIG differ from those of gastritis caused by Helicobacter pylori (H. pylori) infection in terms of the affected gastric anatomical regions and the pathological characteristics observed in biopsy samples. Therefore, when diagnosing AIG based on endoscopic images, it is essential not only to distinguish between normal and atrophic gastric mucosa but also to accurately identify the anatomical region in which the atrophic mucosa is located. In this study, we propose a patient-based multitask gastroscopy image classification network that analyzes all images obtained during the endoscopic procedure. First, we employ the Scale-Invariant Feature Transform (SIFT) algorithm for image registration, generating an image similarity matrix. Next, we use a hierarchical clustering algorithm to group images based on this matrix. Finally, we apply the RepLKNet model, which utilizes large-kernel convolution, to each image group to perform two tasks: anatomical region classification and lesion recognition. Our method achieves an accuracy of 93.4 ± 0.5% (95% CI) and a precision of 92.6 ± 0.4% (95% CI) in the anatomical region classification task, which categorizes images into the fundus, body, and antrum. Additionally, it attains an accuracy of 90.2 ± 1.0% (95% CI) and a precision of 90.5 ± 0.8% (95% CI) in the lesion recognition task, which identifies the presence of gastric mucosal atrophic lesions in gastroscopy images. These results demonstrate that the proposed multitask patient-based gastroscopy image analysis method holds significant practical value for advancing computer-aided diagnosis systems for atrophic gastritis and enhancing the diagnostic accuracy and efficiency of AIG. © 2025 by the authors.},
  author = {Cao, Yuqi and Zhao, Yining and Jin, Xinao and Zhang, Jiayuan and Zhang, Gangzhi and Huang, Pingjie and Zhang, Guangxin and Han, Yuehua},
  author_keywords = {autoimmune gastritis; classification; deep learning; gastrointestinal endoscopy image; image registration; multitask network},
  doi = {10.3390/jimaging11050154},
  journal = {Journal of Imaging},
  keywords = {autoimmune gastritis; classification; deep learning; gastrointestinal endoscopy image; image registration; multitask network},
  title = {A Multitask Network for the Diagnosis of Autoimmune Gastritis},
  url = {https://www.scopus.com/pages/publications/105006621882?origin=resultslist},
  year = {2025}
}

