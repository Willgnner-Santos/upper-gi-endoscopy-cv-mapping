and Oliveira, Andre Luiz and Vitorino, Rui Miguel Pinheiro and Cunha,
Thulio Marquez and Martins, Carlos Henrique Gomes and Carneiro, Murillo
Guimaraes and Sabino-Silva, Robinson},
  doi = {10.1016/j.talo.2024.100383},
  earlyaccessdate = {DEC 2024},
  issn = {2666-8319},
  journal = {TALANTA OPEN},
  month = {DEC},
  orcid-numbers = {Guevara Vega, Marco/0000-0003-2332-0886
Bernadelli Sousa Silva, Nagela/0000-0001-6644-2045
