@article{Tiwari2025,
  abstract = {GastroGPT, a transformer-based large language model, has been developed specifically for gastroenterology. It exhibited improved ability in clinical tasks compared to a general-purpose model such as GPT-4, Bard and Claude. GastroGPT was developed by Cem Simsek, MD, and was presented at UEG Week 2023. The GastroGPT dataset is adapted on 1.2 million tokens, including peer-reviewed content from leading gastroenterology journals, clinical guidelines and 10 000 synthetic GI vignettes. In 10 simulated cases of inflammatory bowel disease, cases of endoscopy, and hepatology, GastroGPT achieved a mean score of 8.1 ± 1.8 on a 10-point Likert scale. GastroGPT achieved higher mean scores compared to comparators (p < 0.001) on six out of seven tasks and included tasks such as patient history acquisition, recommendation for referral, and patient education. Its reproducibility and consistency across task complexities indicate its potential in situations of resource limitation. While it remains limited by its reliance on simulated cases, some participant selection and exposure bias attributed to training data, and lack of appropriate comparisons with medical-specific models such as OpenEvidence, there remains the need for future real-world trials and multimodal integrations within workflows to evaluate GastroGPT's transformation potential in improving gastroenterology workflows and patient care. © 2025 The Author(s). JGH Open: An open access journal of gastroenterology and hepatology published by Journal of Gastroenterology and Hepatology Foundation and John Wiley & Sons Australia, Ltd.},
  author = {Tiwari, Angad and Bharadwaj, Hareesha Rishab and Ahmed, Khabab Abbasher Hussien Mohamed and Dahiya, Dushyant Singh},
  author_keywords = {artificial intelligence; gastroenterology; GastroGPT; large language models},
  doi = {10.1002/jgh3.70306},
  journal = {JGH Open},
  keywords = {artificial intelligence; clinical decision making; clinical practice; clinical significance; clinician; colonoscopy; diagnostic accuracy; Editorial; endoscopy; gastroenterology; GastroGPT; human; inflammatory bowel disease; large language model; Likert scale; patient care; patient counseling; patient education; training},
  title = {GastroGPT Pioneering Specialized AI in Gastroenterology: Strengths, Pitfalls, and the Road to Clinical Integration},
  url = {https://www.scopus.com/pages/publications/105022022198?origin=resultslist},
  year = {2025}
}

