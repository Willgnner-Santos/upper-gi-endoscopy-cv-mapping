@conference{Liang2025,
  abstract = {Image-text multimodal disease diagnostic models have the potential to provide more precise diagnosis results compared to conventional image-only diagnostic models. Existing image-text multimodal diagnostic methods struggle to address the significant image-text distribution differences and realize comprehensive information interaction between the two modalities. To tackle these issues, we propose a novel foundation model-driven multimodal fusion model, MedFMIT, for image-text disease diagnosis. MedFMIT utilizes the DCA encoders to extract informative and well-aligned visual and textual feature representations, effectively reducing the distributional gap between images and texts while ensuring robust feature extraction. The DMII module is introduced to facilitate comprehensive information interaction between image and text features at both coarse-grained and fine-grained levels. For performance evaluation, we conducted experiments on two multimodal medical classification datasets (image + text) containing computed tomography images and endoscopic optical images. MedFMIT outperforms other state-of-the-art multimodal algorithms, achieving the AUC scores of 92.7% and 85.4% on the two datasets respectively, demonstrating its strong potential for precise medical diagnosis.  © 2025 IEEE.},
  author = {Liang, Shuyu and Fu, Junhu and Li, Wutong and Ma, Chen and Wang, Yuanyuan and Guo, Yi},
  author_keywords = {Disease diagnosis; Foundation model; Medical texts; Multi-modal fusion; Vision-language model},
  doi = {10.1109/EMBC58623.2025.11252735},
  journal = {Proceedings of the Annual International Conference of the IEEE Engineering in Medicine and Biology Society, EMBS},
  keywords = {Algorithms; Humans; Image Interpretation, Computer-Assisted; Image Processing, Computer-Assisted; Tomography, X-Ray Computed; Computer aided diagnosis; Computerized tomography; Diseases; Information fusion; Medical image processing; Text processing; Diagnostic model; Disease diagnosis; Foundation models; Image texts; Language model; Medical text; Model-driven; Multi-modal; Multi-modal fusion; Vision-language model; algorithm; computer assisted diagnosis; human; image processing; procedures; x-ray computed tomography; Classification (of information)},
  title = {MedFMIT: A Foundation Model-Driven Multimodal Fusion Method for Image-Text Disease Diagnosis},
  url = {https://www.scopus.com/pages/publications/105023790927?origin=resultslist},
  year = {2025}
}

@article{Liang2025_1,
  abstract = {Dual-stream architectures, especially teacher-student networks, have proven highly effective in semi-supervised medical image segmentation by leveraging unlabeled data to enhance generalization and reduce overfitting. In this work, we introduce a novel teacher-student architecture that harnesses the power of large-scale models and optimized consistency regularization. Our contributions are twofold. First, we propose a Segment Anything Model (SAM)-based teacher-student framework to maximize the performance potential of both teacher and student. To address SAM's high computational cost, we develop Adaptive Low-Rank Adaptation (AdaLoRA), a parameter-efficient fine-tuning strategy that updates only 2 % of the parameters, significantly reducing training time while maintaining competitive performance. Second, we improve segmentation by enforcing multi-level consistency regularization, introducing an unsupervised contrastive learning mechanism at the pixel level and a novel feature fusion strategy at the feature level. Comprehensive experiments validate that our approach significantly outperforms both classical and state-of-the-art methods across diverse datasets, including endoscopic images, MRI scans, and 2D skin images. Our framework achieves superior segmentation accuracy with minimal parameter updates, setting a new benchmark for efficient, scalable, and high-performance semi-supervised medical image segmentation. © 2025 Elsevier Ltd},
  author = {Liang, Qiwei and Zhou, Rulin and Zhou, Yijing and Wang, Guankun and Peng, Peng and Zhong, Xiaopin},
  author_keywords = {Consistency regularization; Contrastive learning; Parameter-efficient fine-tuning; Segment anything model; Semi-supervised medical segmentation},
  doi = {10.1016/j.eswa.2025.128650},
  journal = {Expert Systems with Applications},
  keywords = {Architecture; Benchmarking; Computational efficiency; Contrastive Learning; Image enhancement; Medical image processing; Network architecture; Parameterization; Personnel training; Semi-supervised learning; Students; Teaching; Tuning; Consistency regularization; Fine tuning; Medical image segmentation; Medical segmentations; Parameter-efficient fine-tuning; Regularisation; Segment anything model; Semi-supervised; Semi-supervised medical segmentation; Teachers'; Image segmentation},
  title = {STAR: Empowering semi-supervised medical image segmentation with SAM-based teacher-student architecture and contrastive consistency regularization},
  url = {https://www.scopus.com/pages/publications/105008646400?origin=resultslist},
  year = {2025}
}

