  author = {Xie, Fang and Zhang, Keqiang and Li, Feng and Ma, Guorong and Ni, Yuanyuan and Zhang, Wei and Wang, Junchao and Li, Yuewei},
  journal = {Gastrointestinal Endoscopy},
  keywords = {Early Detection of Cancer; Endoscopy; Humans; Image Processing, Computer-Assisted; Neural Networks, Computer; Stomach Neoplasms; Article; cancer diagnosis; convolutional neural network; data consistency; data extraction; data quality assessment; diagnostic accuracy; diagnostic test accuracy study; Embase; endoscopist; false positive result; gastroscopy; grey literature; human; image analysis; magnifying endoscopy; Medline; narrow band imaging; predictive value; prevalence; publication bias; sensitivity analysis; sensitivity and specificity; statistical bias; stomach cancer; systematic review; tumor depth; videorecording; Web of Science; white light endoscopy; diagnostic imaging; early cancer diagnosis; endoscopy; image processing; meta analysis; procedures; stomach tumor},
  title = {Diagnostic accuracy of convolutional neural network–based endoscopic image analysis in diagnosing gastric cancer and predicting its invasion depth: a systematic review and meta-analysis},
