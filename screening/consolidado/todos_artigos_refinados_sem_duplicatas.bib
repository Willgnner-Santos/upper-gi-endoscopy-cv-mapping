@article{Lobanovs2025,
  abstract = {The integration of machine learning (ML) into medical diagnostics has significantly advanced endoscopic examinations for gastrointestinal diseases. By leveraging extensive datasets and sophisticated algorithms, ML technologies enhance diagnostic precision, detect subtle abnormalities, classify diverse pathologies and predict disease progression. However, their widespread adoption is hindered by the inherent heterogeneity of gastrointestinal diseases, technical limitations, limited generalisability across different populations and ethical challenges related to patient privacy, data security and algorithmic bias. This review provides a comprehensive structural analysis of ML approaches in endoscopy, starting with an overview of the classical endoscopic methodology that relies on direct visualisation of the gastrointestinal tract for diagnosis and therapeutic interventions. Then, current ML applications that hold promise for reducing physician-dependent variability, improving diagnostic accuracy and streamlining procedural workflows were explored. Despite these advances, the effectiveness of ML models often remains constrained by the quality and diversity of training data, which can undermine both reliability and generalisability. Ethical considerations – such as safeguarding patient information, upholding data security and mitigating biases embedded in algorithms – are integral to responsibly deploying ML in clinical settings. By examining these technical and ethical barriers, this work contributes to the evolving discourse on integrating advanced ML techniques into gastroenterology. Ultimately, our goal is to pave the way for more effective and reliable ML-driven endoscopic practices that will enhance disease detection, optimise patient care and benefit healthcare providers worldwide. © Author(s) (or their employer(s)) 2025. Re-use permitted under CC BY-NC. No commercial re-use. See rights and permissions. Published by BMJ Group.},
  author = {Lobanovs, Sergejs and Aleksejeva, Jekaterina and Rūtiņa, Alise Kitija and Krustiņš, Eduards and Čižovs, Jurijs and Bļizņuks, Dmitrijs},
  author_keywords = {DIAGNOSTIC AND THERAPEUTIC ENDOSCOPY; ENDOSCOPIC PROCEDURES; ENDOSCOPY},
  journal = {BMJ Open Gastroenterology},
  keywords = {acetylsalicylic acid; anticoagulant agent; clopidogrel; corticosteroid; nonsteroid antiinflammatory agent; ticlopidine; alcohol consumption; Article; Barrett esophagus; Crohn disease; diagnostic accuracy; gastroenterology; gastroesophageal reflux; gastrointestinal disease; gastrointestinal endoscopy; gastrointestinal tract; gastroscopy; health care personnel; human; information security; machine learning; medical education; pathophysiology; patient care; patient information; peptic ulcer bleeding; semantics; workflow},
  title = {Machine learning in gastrointestinal endoscopy: challenges and opportunities},
  url = {https://www.scopus.com/pages/publications/105019788305?origin=resultslist},
  year = {2025}
}

@conference{Lopes2024,
  abstract = {In this work, we assess the impact of self-supervised learning (SSL) approaches on the detection of gastritis atrophy (GA) and intestinal metaplasia (IM) conditions. GA and IM are precancerous gastric lesions. Detecting these lesions is crucial to intervene early and prevent their progression to cancer. A set of experiments is conducted over the Chengdu dataset, by considering different amounts of annotated data in the training phase. Our results reveal that, when all available data is used for training, SSL approaches achieve a classification accuracy on par with a supervised learning baseline, (81.52% vs 81.76%). Interestingly, we observe that in low-data regimes (here represented as retaining only 12.5% of annotated data for training), the SSL model guarantees an accuracy gain with respect to the supervised learning baseline of approximately 1.5% (73.00% vs 71.52%). This observation hints at the potential of SSL models in leveraging unlabeled data, thus showcasing more robust performance improvements and generalization. Experimental results also show that SSL performance is significantly dependent on the specific data augmentation techniques and parameters adopted for contrastive learning, thus advocating for further investigations into the definition of optimal data augmentation frameworks specifically tailored for gastric lesion detection applications. © 2024 IEEE.},
  author = {Lopes, Inês and Vakalopoulou, Maria and Ferrante, Enzo and Libânio, Diogo and Dinis-Ribeiro, Mário and Coimbra, Miguel and Renna, Francesco},
  author_keywords = {data augmentation; early gastric cancer; esophagogastroduodenoscopy; gastrointestinal lesions; self-supervised learning; unlabeled data},
  journal = {Proceedings of the Annual International Conference of the IEEE Engineering in Medicine and Biology Society, EMBS},
  keywords = {Deep Learning; Endoscopy; Gastritis; Humans; Metaplasia; Precancerous Conditions; Stomach Neoplasms; Supervised Machine Learning; Adversarial machine learning; Contrastive Learning; Endoscopy; Federated learning; Supervised learning; Condition; Data augmentation; Early gastric cancer; Esophagogastroduodenoscopy; Gastric cancers; Gastrointestinal lesions; Learning models; Lesion classification; Supervised learning approaches; Unlabeled data; classification; deep learning; diagnostic imaging; endoscopy; gastritis; human; metaplasia; pathology; precancer; procedures; stomach tumor; supervised machine learning; Self-supervised learning},
  title = {Improving Endoscopy Lesion Classification Using Self-Supervised Deep Learning},
  url = {https://www.scopus.com/pages/publications/85214997915?origin=resultslist},
  year = {2024}
}

@article{LOPES2025102009,
  abstract = {Gastric cancer is a pressing global health issue that ranks fifth as the most commonly diagnosed malignancy and leading cause of cancer-related deaths. Early detection is critical for improving patient outcomes, with five-year survival rates exceeding 90 % when diagnosed at initial stages. Current screening modalities, primarily reliant on upper gastrointestinal endoscopy, are highly accurate, but not without limitations, such as invasiveness, high cost, low adherence and accessibility. Hence, this review aligns with the ongoing efforts to answer the pressing need for innovative approaches, emphasising novel devices and biomarker advancements over the last decade. We highlight non-endoscopic methods such as magnetically controlled capsule endoscopy and point-of-care testing. Additionally, we will provide an overview into the field of liquid biopsies and emerging biomarkers in GC detection, towards accurate, less invasive and costly screening tools that hold the promise for greater accessibility and citizen involvement.},
  author = {Catarina Lopes and Carina Pereira},
  doi = {https://doi.org/10.1016/j.bpg.2025.102009},
  issn = {1521-6918},
  journal = {Best Practice & Research Clinical Gastroenterology},
  keywords = {Stomach neoplasm, Mass screening, Biomarkers, Devices, Point-of-care testing},
  note = {Screening and Early diagnosis of Upper GI neoplastic lesions},
  pages = {102009},
  title = {Advances towards gastric cancer screening: Novel devices and biomarkers},
  url = {https://www.sciencedirect.com/science/article/pii/S1521691825000368},
  volume = {75},
  year = {2025}
}

