  keywords = {Deep learning;Support vector machines;Machine learning algorithms;Systematics;Computational modeling;Transfer learning;Real-time systems;Barrett's esophagus;Deep learning;Adenocarcinoma;Image processing;Pattern recognition;Computer-aided diagnosis},
  month = {April},
