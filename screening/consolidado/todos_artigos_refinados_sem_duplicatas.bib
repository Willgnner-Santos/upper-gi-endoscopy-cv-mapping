  title = {Artificial intelligence in the diagnosis and treatment of colorectal cancer; [Künstliche Intelligenz in der Diagnostik und Behandlung des kolorektalen Karzinoms]},
  url = {https://www.scopus.com/pages/publications/105016845015?origin=resultslist},
  year = {2025}
}

