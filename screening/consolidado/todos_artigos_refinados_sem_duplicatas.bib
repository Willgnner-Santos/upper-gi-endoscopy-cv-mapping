@conference{Shichi2019,
  abstract = {In stomach lesion screening, endoscopic images provide the most effective diagnostic information. However, in the most of lesions at the initial stage, the sign of existence is hard to appear on endoscopic images, and also there is the difference in operations of endoscopes and observation of images in real time among individual medical doctors. Therefore, development of a computer aided diagnostic system (CAD system) for endoscopic images is required. In this study, we propose a method for automated detection of fundic gland polyps from endoscopic images using an object detection algorithm named SSD (Single Shot MultiBox Detector) which is one of CNN (Convolutional Neural Network). SSD used here has 20 of convolution layers and 6 of pooling layers, and the input image size is 300x300. In the experiment, 73 practical fundic gland polyp images were used. To compensate for lack of training images, augmentation was performed using image rotation and edge enhancement. We trained 8751 training images and 2188 verification images. Also, as a preprocessing, highlight areas were removed automatically from all images including both training and test samples. As a result, 94.7% of TP (true positive) rate for 73 fundic gland polyp images was obtained by using our learned SSD. © COPYRIGHT SPIE.},
  author = {Shichi, Nagito and Totsuka, Arata and Hasegawa, Junichi and Shibata, Tomoyuki},
  journal = {Proceedings of SPIE - The International Society for Optical Engineering},
  keywords = {Convolution; Endoscopy; Medical imaging; Neural networks; Object detection; Automated detection; Computer aided diagnostics; Convolutional neural network; Edge enhancements; Endoscopic image; Image rotation; Medical doctors; Object detection algorithms; Image enhancement},
  title = {Automated detection of fundic gland polyps from endoscopic images using SSD},
  url = {https://www.scopus.com/pages/publications/85063892644?origin=resultslist},
  year = {2019}
}

@article{Shichijo2017106,
  abstract = {Background and aims The role of artificial intelligence in the diagnosis of Helicobacter pylori gastritis based on endoscopic images has not been evaluated. We constructed a convolutional neural network (CNN), and evaluated its ability to diagnose H. pylori infection. Methods A 22-layer, deep CNN was pre-trained and fine-tuned on a dataset of 32,208 images either positive or negative for H. pylori (first CNN). Another CNN was trained using images classified according to 8 anatomical locations (secondary CNN). A separate test data set (11,481 images from 397 patients) was evaluated by the CNN, and 23 endoscopists, independently. Results The sensitivity, specificity, accuracy, and diagnostic time were 81.9%, 83.4%, 83.1%, and 198 s, respectively, for the first CNN, and 88.9%, 87.4%, 87.7%, and 194 s, respectively, for the secondary CNN. These values for the 23 endoscopists were 79.0%, 83.2%, 82.4%, and 230 ± 65 min (85.2%, 89.3%, 88.6%, and 253 ± 92 min by 6 board-certified endoscopists), respectively. The secondary CNN had a significantly higher accuracy than endoscopists (by 5.3%; 95% CI, 0.3–10.2). Conclusion H. pylori gastritis could be diagnosed based on endoscopic images using CNN with higher accuracy and in a considerably shorter time compared to manual diagnosis by endoscopists. © 2017 The Authors},
  author = {Shichijo, Satoki and Nomura, Shuhei and Aoyama, Kazuharu and Nishikawa, Yoshitaka and Miura, Motoi and Shinagawa, Takahide and Takiyama, Hirotoshi and Tanimoto, Tetsuya and Ishihara, Soichiro and Matsuo, Keigo and Tada, Tomohiro},
  author_keywords = {Artificial intelligence; Convolutional neural networks; Endoscopy; Helicobacter pylori},
  doi = {10.1016/j.ebiom.2017.10.014},
  journal = {EBioMedicine},
  keywords = {Artificial intelligence; Convolutional neural networks; Endoscopy; Helicobacter pylori},
  title = {Application of Convolutional Neural Networks in the Diagnosis of Helicobacter pylori Infection Based on Endoscopic Images},
  url = {https://www.scopus.com/pages/publications/85031780325?origin=resultslist},
  year = {2017}
}

