  doi = {https://doi.org/10.1016/j.eclinm.2024.102803},
  issn = {2589-5370},
  journal = {eClinicalMedicine},
  keywords = {Artificial intelligence, Quality control, Oesophagogastroduodenoscopy, Gastrointestinal neoplasms, Early gastric cancer},
  pages = {102803},
  title = {Efficacy of a real-time intelligent quality-control system for the detection of early upper gastrointestinal neoplasms: a multicentre, single-blinded, randomised controlled trial},
  url = {https://www.sciencedirect.com/science/article/pii/S2589537024003821},
  volume = {75},
  year = {2024}
}

