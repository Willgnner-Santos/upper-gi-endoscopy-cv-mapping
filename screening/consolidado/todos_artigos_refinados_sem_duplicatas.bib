@article{Ishioka2023483,
  abstract = {Objectives: Endoscopists' abilities to diagnose early gastric cancers (EGCs) vary, especially between specialists and nonspecialists. We developed an artificial intelligence (AI)-based diagnostic support tool “Tango” to differentiate EGCs and compared its performance with that of endoscopists. Methods: The diagnostic performances of Tango and endoscopists (34 specialists, 42 nonspecialists) were compared using still images of 150 neoplastic and 165 non-neoplastic lesions. Neoplastic lesions included EGCs and adenomas. The primary outcome was to show the noninferiority of Tango (based on sensitivity) over specialists. The secondary outcomes were the noninferiority of Tango (based on accuracy) over specialists and the superiority of Tango (based on sensitivity and accuracy) over nonspecialists. The lower limit of the 95% confidence interval (CI) of the difference between Tango and the specialists for sensitivity was calculated, with >−10% defined as noninferiority and >0% defined as superiority in the primary outcome. The comparable differences between Tango and the endoscopists for each performance were calculated, with >10% defined as superiority and >0% defined as noninferiority in the secondary outcomes. Results: Tango achieved superiority over the specialists based on sensitivity (84.7% vs. 65.8%, difference 18.9%, 95% CI 12.3–25.3%) and demonstrated noninferiority based on accuracy (70.8% vs. 67.4%). Tango achieved superiority over the nonspecialists based on sensitivity (84.7% vs. 51.0%) and accuracy (70.8% vs. 58.4%). Conclusions: The AI-based diagnostic support tool for EGCs demonstrated a robust performance and may be useful to reduce misdiagnosis. © 2022 Japan Gastroenterological Endoscopy Society.},
  author = {Ishioka, Mitsuaki and Osawa, Hiroyuki and Hirasawa, Toshiaki and Kawachi, Hiroshi and Nakano, Kaoru and Fukushima, Noriyoshi and Sakaguchi, Mio and Tada, Tomohiro and Kato, Yusuke and Shibata, Junichi and Ozawa, Tsuyoshi and Tajiri, Hisao and Fujisaki, Junko},
  author_keywords = {artificial intelligence; diagnosis; endoscopy; gastric cancer; Helicobacter pylori},
  journal = {Digestive Endoscopy},
  keywords = {Artificial Intelligence; Humans; Retrospective Studies; Stomach Neoplasms; adenoma; Article; artificial intelligence; clinical assessment tool; computer assisted diagnosis; confidence interval; controlled study; diagnostic accuracy; diagnostic error; diagnostic test accuracy study; differential diagnosis; early cancer; endoscopist; gastritis; gastroscopy; Helicobacter pylori; human; human experiment; human tissue; image analysis; intermethod comparison; nonhuman; retrospective study; sensitivity and specificity; stomach cancer; stomach erosion; stomach lesion; stomach polyp; stomach ulcer; Tango; stomach tumor},
  title = {Performance of an artificial intelligence-based diagnostic support tool for early gastric cancers: Retrospective study},
  url = {https://www.scopus.com/pages/publications/85142223966?origin=resultslist},
  year = {2023}
}

@conference{Islam2021137,
  abstract = {Gastric cancer (stomach cancer) is now the sixth most common diagnosed cancer and the third leading cause of cancer mortality in the world. Gastric Erosion, Gastric Ulcer, and Stomach Polyp are examples of Gastric Precancerous Diseases (GPDs) that can lead to gastric cancer if not recognized early or misdiagnosed. Classifying these GPDs is a difficult task. Undoubtedly, Deep learning networks (DNNs) have shown to be effective in solving the challenge of image categorization. Next to practical difficulty is the limitation of the availability of medical images for DNN training. In this paper, a hybrid model is proposed to classify GPDs. The model is a combination of Convolution Neural Network (CNN) Gastric Precancerous Diseases Feature Extractor Network (GPDFENet) for feature extraction and Support Vector Machine (SVM) for classification. An open dataset 'Data-Open-Access4PLoS-One' including erosion, ulcer, and polyp endoscopic images were utilized to train the network. After evaluation, the network is then compared to various pre-trained networks such as AlexNet, ResNet-50, ResNet-101, and Inception V3. The proposed model (GPDFENet+SVM) has achieved an accuracy of 93.22%.  © 2021 IEEE.},
  author = {Islam, Jahidul and Bhuiyan, Sajjad and Hossain, Arafat and Surja, Amit Shaha and Iqbal, Md. Shahid},
  author_keywords = {artificial intelligence; convolution neural network; feature extraction; gastric disease; support vector machine},
  journal = {3rd International Conference on Electrical and Electronic Engineering, ICEEE 2021},
  keywords = {Convolution; Convolutional neural networks; Deep learning; Endoscopy; Erosion; Extraction; Feature extraction; Medical imaging; Support vector machines; Convolution neural network; Diseases features; Feature extractor; Features extraction; Gastric cancers; Gastric disease; Learning network; Network support; Stomach cancer; Support vectors machine; Diseases},
  title = {Classification of Gastric Precancerous Diseases using Hybrid CNN-SVM},
  url = {https://www.scopus.com/pages/publications/85127504202?origin=resultslist},
  year = {2021}
}

