@article{Sui2021,
  abstract = {Gastric cancer is the second most lethal type of malignant tumor in the world. Early diagnosis of gastric cancer can reduce the transformation to advanced cancer and improve the early treatment rate. As a cheap, real-time, non-invasive examination method, oral contrast-enhanced ultrasonography (OCUS) is a more acceptable way to diagnose gastric cancer than interventional diagnostic methods such as gastroscopy. In this paper, we proposed a new method for the diagnosis of gastric diseases by automatically analyzing the hierarchical structure of gastric wall in gastric ultrasound images, which is helpful to quantify the diagnosis information of gastric diseases and is a useful attempt for early screening of gastric cancer. We designed a gastric wall detection network based on U-net. On this basis, anisotropic diffusion technology was used to extract the layered structure of the gastric wall. A simple and useful gastric cancer screening model was obtained by calculating and counting the thickness of the five-layer structure of the gastric wall. The experimental results showed that our model can accurately identify the gastric wall, and it was found that the layered parameters of abnormal gastric wall is significantly different from that of normal gastric wall. For the screening of gastric disease, a statistical model based on gastric wall stratification can give a screening accuracy of 95% with AUC of 0.92. © Copyright © 2021 Sui, Hu, Xie, Deng, Wang, Yu and Shen.},
  author = {Sui, An and Hu, Zhaoyu and Xie, Xuan and Deng, Yinhui and Wang, Yuanyuan and Yu, Jinhua and Shen, Li},
  author_keywords = {anisotropic diffusion; edge detection; gastric cancer; U-net; ultrasound},
  journal = {Frontiers in Oncology},
  keywords = {contrast medium; accuracy; adult; advanced cancer; area under the curve; Article; cancer screening; clinical article; contrast-enhanced ultrasound; controlled study; diagnostic accuracy; diagnostic test accuracy study; diffusion; echography; edge detection; epiluminescence microscopy; female; gastroscopy; human; image quality; kernel method; machine learning; male; predictive value; quantitative analysis; receiver operating characteristic; risk factor; sensitivity and specificity; stomach cancer; stomach ulcer; stomach wall; thickness; three-dimensional imaging},
  title = {Automatic Detection of Gastric Wall Structure Based on Oral Contrast-Enhanced Ultrasound and Its Application on Tumor Screening},
  url = {https://www.scopus.com/pages/publications/85104029452?origin=resultslist},
  year = {2021}
}

@article{Sun202015812,
  abstract = {Gastric ulcer is one of the most common types of stomach disease. Malignancy suspiciousness classification of gastric ulcer is a crucial indicator for early cancer detection and prognosis. Technically, this problem suffers from the complexity and variability of endoscopic pathological images. For addressing these challenges, we propose a deep learning based classification neural network which combines the densely-connected architecture and non-local attention mechanism. Structurally, we add the attention block into the cascaded dense blocks for catching more contextual information and enhancing the correlation between pixels and regions. Experimentally, we implement sufficient experiments on our own gastroscopic image dataset, which is delicately annotated twice per image by medical specialists. Quantitative comparisons against several prior state-of-the-art methods demonstrate the superiority of our approach. as a result, we achieve an overall diagnostic accuracy of 96.79 %, a recall of 94.92% and an F1-score of 94.70 %, close to the diagnostic level of a gastroenterologist. The area under the receiver operating characteristic (ROC) curves of the deep learning model achieve an average of 0.93. © 2013 IEEE.},
  author = {Sun, Muyi and Liang, Kaiyi and Zhang, Wenbao and Chang, Qing and Zhou, Xiaoguang},
  author_keywords = {attention mechanism; densely-connected neural network; Gastric ulcer; malignancy suspiciousness classification; medical image analysis},
  doi = {10.1109/aCCESS.2020.2967350},
  journal = {IEEE Access},
  keywords = {attention mechanism; densely-connected neural network; Gastric ulcer; malignancy suspiciousness classification; medical image analysis},
  title = {Non-Local attention and Densely-Connected Convolutional Neural Networks for Malignancy Suspiciousness Classification of Gastric Ulcer},
  url = {https://www.scopus.com/pages/publications/85079754929?origin=resultslist},
  year = {2020}
}

