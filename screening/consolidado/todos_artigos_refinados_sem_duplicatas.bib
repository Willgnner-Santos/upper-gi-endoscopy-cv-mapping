@conference{Celis-Ar_mbula2025,
  abstract = {The monitoring of gastric intestinal metaplasia can play an important role in preventing the progression to gastric cancer. Despite efforts to quantify it in biopsy samples stained with H&E, poor quantification has inevitably biased the risk prediction and other focus is required. We propose quantifying at the cell level the possible levels of cell configurations using a hamiltonian approach. A set of 9 gastric biopsies is analyzed. The results show significant statistical differences in the t-test between complete and incomplete metaplasia (p < 0.05) with the proposed hamiltonian; however with the foundation model UNI2-h there is no significant difference between both conditions (p = 0.157). © 2025 IEEE.},
  author = {Celis-Arámbula, Juan S. and Cano-Ramirez, Fabian and Romero, Eduardo},
  author_keywords = {endoscopy; gastric; intestinal; metaplasia; pathology},
  doi = {10.1109/SIPAIM67325.2025.11283377},
  journal = {Proceedings of the 21st International Symposium on Medical Information Processing and Analysis, SIPAIM 2025},
  keywords = {Bioinformatics; Biopsy; Hamiltonians; Biopsy samples; Cell configurations; Cell levels; Gastric; Gastric biopsy; Gastric cancers; Hamiltonian approach; Intestinal; Metaplasia; Risk predictions; Pathology},
  title = {Characterization of complete and incomplete Gastric Intestinal Metaplasia (GIM) by a hamiltonian approach},
  url = {https://www.scopus.com/pages/publications/105032982917?origin=resultslist},
  year = {2025}
}

@article{Chae202329391,
  abstract = {Gastric cancer is high-risk cancer in terms of both incidence and mortality. However, if it is diagnosed early, there is a high chance of survival. Therefore, an early diagnosis of gastric cancer and precancerous lesions is very important. Gastroscopy is one of the best methods for diagnosing gastric cancer and precancerous lesions, but it relies on visual observation by medical specialists. Accordingly, factors such as the experience or fatigue of specialists can influence diagnosis results. To alleviate these problems, we propose a computer-aided diagnosis system that can improve the efficiency of diagnosis and reduce misdiagnoses by providing a second opinion. We aimed to classify healthy tissue, gastric lesions, and early gastric cancer using a Transformer-based deep-learning classification model called Vision Transformer, which has achieved the best performance in transfer learning. We also proposed a Multi-Filter AutoAugment (MFAA) method, which increases the classification performance of the model given small amounts of medical data. The medical data augmented using MFAA are better for training deep-learning models than conventionally augmented data; we effectively enhanced the classification performance of the model using MFAA. In experiments, the model achieved an F1-score of 0.87 and area under the curve of 0.94 in the classification of abnormalities (gastric lesions including early gastric cancer) and healthy tissue. In addition, it obtained an F1-score of 0.92 and area under the curve of 0.97 in the classification of early gastric cancer and non-cancerous gastric lesions. © 2013 IEEE.},
  author = {Chae, Jung-Woo and Cho, Hyun-Chong},
  author_keywords = {Computer-aided diagnosis (CADx); deep-learning; early gastric cancer; gastric lesions; gastroscopy; medical data; multi-filter AutoAugment (MFAA)},
  journal = {IEEE Access},
  keywords = {Computer aided instruction; Deep learning; Diseases; Endoscopy; Medical imaging; Tissue; Cancer; Computer-aided diagnose (CADx); Deep learning; Early gastric cancer; Gastric cancers; Gastric lesion; Gastrointestinal tract; Gastroscopy; Lesion; Medical data; Medical diagnostic imaging; Multi-filter autoaugment; Performances evaluation; Transformer; Computer aided diagnosis},
  title = {Enhanced Classification of Gastric Lesions and Early Gastric Cancer Diagnosis in Gastroscopy Using Multi-Filter AutoAugment},
  url = {https://www.scopus.com/pages/publications/85151547818?origin=resultslist},
  year = {2023}
}

@article{Chaitanya2025201,
  abstract = {Accurate assessment of disease severity from endoscopy videos in ulcerative colitis (UC) is crucial for evaluating drug efficacy in clinical trials. Severity is often measured by the Mayo Endoscopic Subscore (MES) and Ulcerative Colitis Endoscopic Index of Severity (UCEIS) score. However, expert MES/UCEIS annotation is time-consuming and susceptible to inter-rater variability, factors addressable by automation. Automation attempts with frame-level labels face challenges in fully-supervised solutions due to the prevalence of video-level labels in clinical trials. CNN-based weakly-supervised models (WSL) with end-to-end (e2e) training lack generalization to new disease scores and ignore spatio-temporal information crucial for accurate scoring. To address these limitations, we propose “Arges”, a deep learning framework that utilizes a transformer with positional encoding to incorporate spatio-temporal information from frame features to estimate disease severity scores in endoscopy video. Extracted features are derived from a foundation model (ArgesFM), pre-trained on a large diverse dataset from multiple clinical trials (61M frames, 3927 videos). We evaluate four UC disease severity scores, including MES and three UCEIS component scores. Test set evaluation indicates significant improvements, with F1 scores increasing by 4.1% for MES and 18.8%, 6.6%, 3.8% for the three UCEIS component scores compared to state-of-the-art methods. Prospective validation on previously unseen clinical trial data further demonstrates the model’s successful generalization. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
  author = {Chaitanya, Krishna and Damasceno, Pablo F. and Fadnavis, Shreyas and Mobadersany, Pooya and Parmar, Chaitanya and Scherer, Emily and Zemlianskaia, Natalia and Surace, Lindsey and Ghanem, Louis R. and Cula, Oana Gabriela and Mansi, Tommaso and Standish, Kristopher},
  author_keywords = {endoscopy; self-supervised learning; transformers; UC disease severity assessment; ulcerative colitis; weakly-supervised learning},
  doi = {10.1007/978-3-031-73290-4_20},
  journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) },
  keywords = {Contrastive Learning; Deep learning; Endoscopy; Semi-supervised learning; Clinical trial; Colitis disease; Disease severity; Generalisation; Index of severity; Transformer; Ulcerative colitis; Ulcerative colitis disease severity assessment; Weakly supervised learning; Self-supervised learning},
  title = {Arges: Spatio-Temporal Transformer for Ulcerative Colitis Severity Assessment in Endoscopy Videos},
  url = {https://www.scopus.com/pages/publications/85208413166?origin=resultslist},
  year = {2025}
}

@article{CHAN2025127444,
  abstract = {Upper gastrointestinal (UGI) diseases pose significant health risks, which necessitate efficient computer-aided diagnostic (CAD) systems for real-time endoscopy. Addressing challenges such as high latency and limited diagnostic accuracy, this study introduces FastUGI-Net, a fast and lightweight multi-task model series for the concurrent classification of anatomical landmarks and diseases. The model incorporates EffiViTNet, a hybrid encoder combining EfficientNet and MobileViT for enhanced feature extraction, and orthogonal task gradient regularization is employed to mitigate task interference. Additionally, a novel multi-class dataset, UGIAD, is developed for training and validation. Experimental results demonstrate that FastUGI-Net achieves state-of-the-art accuracies, ranging from 91.560% to 93.037% and 91.607% and 93.893% for diseases, with minimal parameter overhead. The high consistency in predictions and frame rates highlights its potential for CAD system integration. The code and dataset are available at https://github.com/allebasycin/FastUGI-Net.},
  author = {In Neng Chan and Pak Kin Wong and Tao Yan and Yanyan Hu and Chon In Chan and Peixuan Ge and Zheng Li and Ying Hu and Shan Gao and Hon Ho Yu},
  doi = {https://doi.org/10.1016/j.eswa.2025.127444},
  issn = {0957-4174},
  journal = {Expert Systems with Applications},
  keywords = {Multi-task learning, Anatomical landmark classification, Disease classification, Deep learning, Medical imaging analysis, Gastrointestinal endoscopy},
  pages = {127444},
  title = {FastUGI-Net: Enhanced Real-Time Endoscopic Diagnosis with Efficient Multi-task Learning},
  url = {https://www.sciencedirect.com/science/article/pii/S0957417425010668},
  volume = {280},
  year = {2025}
}

