@article{Liu2021,
  abstract = {Background: To develop and validate multivariate models integrating endoscopic biopsy, tumor markers, and CT findings based on late arterial phase (LAP) to predict serosal invasion in gastric cancer (GC). Methods: The preoperative differentiation degree, tumor markers, CT morphological characteristics, and CT value-related and texture parameters of 154 patients with GC were analyzed retrospectively. Multivariate models based on regression analysis and machine learning algorithms were performed to improve the diagnostic efficacy. Results: The differentiation degree, carbohydrate antigen (CA) 199, CA724, CA242, and multiple CT findings based on LAP differed significantly between T1–3 and T4 GCs in the primary cohort (all P < 0.05). Multivariate models based on regression analysis and random forest achieved AUCs of 0.849 and 0.865 in the primary cohort, respectively. Conclusion: We developed and validated multivariate models integrating endoscopic biopsy, tumor markers, CT morphological characteristics, and CT value-related and texture parameters to predict serosal invasion in GCs and achieved favorable performance. © 2021, The Author(s).},
  author = {Liu, Song and Xu, Mengying and Qiao, Xiangmei and Ji, Changfeng and Li, Lin and Zhou, Zhengyang},
  author_keywords = {Biomarkers, tumor; Endoscopy; Neoplasm staging; Stomach neoplasms; Tomography, X-ray computed},
  journal = {BMC Cancer},
  keywords = {Adult; Aged; Antigens, Tumor-Associated, Carbohydrate; Biomarkers, Tumor; Biopsy; Decision Trees; Female; Gastroscopy; Humans; Machine Learning; Male; Middle Aged; Models, Statistical; Neoplasm Invasiveness; Preoperative Period; Regression Analysis; Retrospective Studies; Serous Membrane; Stomach Neoplasms; Tomography, X-Ray Computed; carbohydrate antigen; carbohydrate antigen 199; carbohydrate antigen 242; carbohydrate antigen 724; unclassified drug; CA 242 antigen; CA-72-4 antigen; carbohydrate antigen 199, human; tumor antigen; tumor marker; adult; area under the curve; Article; cancer staging; clinical effectiveness; clinical feature; cohort analysis; computer assisted tomography; endoscopic biopsy; female; human; learning algorithm; major clinical study; male; middle aged; prediction; preoperative period; risk factor; stomach cancer; tumor invasion; validation study; aged; biopsy; blood; decision tree; diagnostic imaging; gastroscopy; machine learning; pathology; preoperative period; procedures; regression analysis; retrospective study; serosa; statistical model; stomach tumor; vascularization; x-ray computed tomography},
  title = {Prediction of serosal invasion in gastric cancer: development and validation of multivariate models integrating preoperative clinicopathological features and radiographic findings based on late arterial phase CT images},
  url = {https://www.scopus.com/pages/publications/85115063775?origin=resultslist},
  year = {2021}
