@ARTICLE{Zheng2025111,
	author = {Zheng, Neil S. and Keloth, Vipina K. and You, Kisung and Kats, Daniel and Li, Darrick K. and Deshpande, Ohm and Sachar, Hamita and Xu, Hua and Laine, Loren and Shung, Dennis L.},
	title = {Detection of Gastrointestinal Bleeding With Large Language Models to Aid Quality Improvement and Appropriate Reimbursement},
	year = {2025},
	journal = {Gastroenterology},
	doi = {10.1053/j.gastro.2024.09.014},
	url = {https://www.scopus.com/pages/publications/85209545875?origin=resultslist},
	abstract = {Background & Aims: Early identification and accurate characterization of overt gastrointestinal bleeding (GIB) enables opportunities to optimize patient management and ensures appropriately risk-adjusted coding for claims-based quality measures and reimbursement. Recent advancements in generative artificial intelligence, particularly large language models (LLMs), create opportunities to support accurate identification of clinical conditions. In this study, we present the first LLM-based pipeline for identification of overt GIB in the electronic health record (EHR). We demonstrate 2 clinically relevant applications: the automated detection of recurrent bleeding and appropriate reimbursement coding for patients with GIB. Methods: Development of the LLM-based pipeline was performed on 17,712 nursing notes from 1108 patients who were hospitalized with acute GIB and underwent endoscopy in the hospital from 2014 to 2023. The pipeline was used to train an EHR-based machine learning model for detection of recurrent bleeding on 546 patients presenting to 2 hospitals and externally validated on 562 patients presenting to 4 different hospitals. The pipeline was used to develop an algorithm for appropriate reimbursement coding on 7956 patients who underwent endoscopy in the hospital from 2019 to 2023. Results: The LLM-based pipeline accurately detected melena (positive predictive value, 0.972; sensitivity, 0.900), hematochezia (positive predictive value, 0.900; sensitivity, 0.908), and hematemesis (positive predictive value, 0.859; sensitivity, 0.932). The EHR-based machine learning model identified recurrent bleeding with area under the curve of 0.986, sensitivity of 98.4%, and specificity of 97.5%. The reimbursement coding algorithm resulted in an average per-patient reimbursement increase of $1299 to $3247 with a total difference of $697,460 to $1,743,649. Conclusions: An LLM-based pipeline can robustly detect overt GIB in the EHR with clinically relevant applications in detection of recurrent bleeding and appropriate reimbursement coding. © 2025 AGA Institute},
	author_keywords = {Acute Gastrointestinal Bleeding; Generative Artificial Intelligence; Large Language Models; Nature Language Processing; Quality Improvement},
	keywords = {Aged; Algorithms; Electronic Health Records; Endoscopy, Gastrointestinal; Female; Gastrointestinal Hemorrhage; Humans; Insurance, Health, Reimbursement; Machine Learning; Male; Middle Aged; Natural Language Processing; Predictive Value of Tests; Quality Improvement; Recurrence; Reproducibility of Results; acetylsalicylic acid; anticoagulant agent; purinergic P2Y receptor antagonist; aged; Article; coding algorithm; cohort analysis; diagnostic test accuracy study; electronic health record; gastrointestinal hemorrhage; hematochezia; human; large language model; major clinical study; melena; predictive value; reimbursement; sensitivity and specificity; total quality management; algorithm; diagnosis; economics; electronic health record; etiology; female; gastrointestinal endoscopy; gastrointestinal hemorrhage; machine learning; male; middle aged; natural language processing; recurrent disease; reimbursement; reproducibility; therapy}
}

@ARTICLE{Wang2025165,
	author = {Wang, Xiaowei and Xing, Shuli and Mao, Guojun},
	title = {Research on Lightweight Transformer Medical Image Segmentation with Multi-Scale Feature Fusion; [多尺度特征融合的轻量化Transformer医学图像分割研究]},
	year = {2025},
	journal = {Chinese Journal of Biomedical Engineering},
	doi = {10.3969/j.issn.0258-8021.2025.02.004},
	url = {https://www.scopus.com/pages/publications/105014638555?origin=resultslist},
	abstract = {UNet has been widely used in the field of medical image segmentation, and its U-shaped encoder-decoder structure has become one of the most populär frameworks. However, the Classification and localization accuracy of UNet are limited by the local receptive field of convolutions, which restricts its ability to effectively capture long-range dependencies. Transformer has been demonslrated outstanding capabilities in capturing long-range dependencies and serves as the core supporting technology for current large language models, addressing the limitations of convolutional neural networks. In this paper, a novel medical image segmentation model referred to as MoFormer was proposed. Based on the encoding decoding structure of UNet, this model integrated Transformer learning mechanism in the encoder to expand its context aware field of view and enhanced the multi-scale feature extraction ability of local and global Information. The proposed MoFormer with random initialization achieved an average Dice coefficient of 0. 823 on the BTCV dataset with 50 abdominal CT images. On the ISIC2017 dataset containing 2 750 dermoscopy images, it performed equally well as TransFuse but with 10. 91 M fewer parameters. On the polyp dataset which includes 2 590 endoscopic images, it outperformed other populär comparison models, such as PraNet, with the increase in mloU value by an average of 0. 123. Overall, this neural network model balances the number of parameters with segmentation accuracy, demonstrating strong generalization across various medical image datasets. © 2025 Chinese Academy of Medical Sciences. All rights reserved.},
	author_keywords = {lightweight; medical images segmentation; multi-scale feature; Transformer; U-shaped network},
	keywords = {Article; artificial neural network; comparative study; convolutional neural network; dermatoscopy; feature extraction; human; image segmentation; large language model}
}

