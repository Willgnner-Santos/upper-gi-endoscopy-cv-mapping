	keywords = {adult; Article; cancer center; cancer staging; ChatGPT; Chinese; clinical effectiveness; cohort analysis; confidence interval; deepseek r1; diagnostic accuracy; diagnostic test accuracy study; endoscopic ultrasonography; esophagus cancer; factorial design; female; gpt 4o; grok 3; human; large language model; major clinical study; male; McNemar test; middle aged; prompt engineering; qwen3; retrieval augmented generation; retrospective study}
