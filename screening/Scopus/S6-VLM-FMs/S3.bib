@ARTICLE{Tian2025,
	author = {Tian, Tengfei and Hsu, Szuyao and Sun, Qin and Shi, Yang and Hu, Xianyang and Wu, Yang and Zhao, Keqing and Zheng, Chunquan},
	title = {Human beta defensin-2 protects the epithelial barrier during methicillin-resistant Staphylococcus aureus infection in chronic rhinosinusitis with nasal polyps},
	year = {2025},
	journal = {Frontiers in Cellular and Infection Microbiology},
	doi = {10.3389/fcimb.2025.1551080},
	url = {https://www.scopus.com/pages/publications/105006421709?origin=resultslist},
	abstract = {Objective: We investigated the effect of human beta defensin-2 (hBD-2) on nasal epithelial barrier function with methicillin-resistant Staphylococcus aureus (MRSA) infection in chronic rhinosinusitis with nasal polyps (CRSwNP). Methods: The expression of hBD-2 was measured in nasal polyps (NPs) from CRSwNP. MRSA was treated with different concentrations of hBD-2 to assess the invasive ability. Primary human nasal epithelial cells (HNECs) cultured at the air–liquid interface (ALI) were pre-incubated with or without hBD-2 prior to MRSA infection. The cell viability, the epithelial cell integrity, and the tight junction (TJ) expression were evaluated. Results: The expression of hBD-2 in the CRSwNP group was higher than that in the control group. In addition, the hBD-2 protein was negatively correlated with the Lund–Mackay CT score and was positively correlated with the neutrophil levels in CRSwNP. The presence of hBD-2 significantly reduced the invasive ability of MRSA in HNECs. MRSA decreased the epithelial cell integrity by diminishing the protein expression of occludin and zonula occludens-1 (ZO-1). Furthermore, hBD-2 prevented the MRSA-induced barrier disruption by increasing the mucosal permeability and the expression of occludin and ZO-1. Conclusion: The results suggest that hBD-2 may partially attenuate the epithelial barrier disruption induced by MRSA, indicating the protective effect of hBD-2 on S. aureus infection. Copyright © 2025 Tian, Hsu, Sun, Shi, Hu, Wu, Zhao and Zheng.},
	author_keywords = {chronic rhinosinusitis with nasal polyps; epithelial barrier; human beta defensin-2; methicillin-resistant Staphylococcus aureus; tight junctions},
	keywords = {Adult; beta-Defensins; Cell Survival; Cells, Cultured; Chronic Disease; Epithelial Cells; Female; Humans; Male; Methicillin-Resistant Staphylococcus aureus; Middle Aged; Nasal Mucosa; Nasal Polyps; Occludin; Rhinitis; Rhinosinusitis; Sinusitis; Staphylococcal Infections; Tight Junctions; Zonula Occludens-1 Protein; beta defensin 2; lactate dehydrogenase; lipopolysaccharide; occludin; protein ZO1; beta defensin; DEFB4A protein, human; occludin; protein ZO1; adult; allergic rhinitis; antimicrobial activity; Article; cell invasion assay; cell viability; chronic rhinosinusitis; clinical article; colony forming unit; confocal microscopy; controlled study; cystic fibrosis; cytotoxicity; endoscopic sinus surgery; epithelium cell; female; gene expression; human; human cell; human tissue; immunofluorescence; male; methicillin resistant Staphylococcus aureus infection; multiplicity of infection; protein expression; real time polymerase chain reaction; RNA extraction; sinonasal polyp; tight junction; transepithelial resistance; cell culture; cell survival; chronic disease; complication; drug effect; epithelium cell; genetics; metabolism; methicillin resistant Staphylococcus aureus; microbiology; middle aged; nose mucosa; pathology; rhinitis; rhinosinusitis; sinusitis; Staphylococcus infection}
