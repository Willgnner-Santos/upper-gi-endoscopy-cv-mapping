@CONFERENCE{Tran202514190,
	author = {Tran, Khoa and Ly, Linh and Ho, Duy Khanh and Luong, Ngoc Hoang},
	title = {Enhancing Endoscopic Image Retrieval via Self-Supervised Learning and Large VLM-Based Re-ranking},
