	journal = {Biomedical Signal Processing and Control},
	doi = {10.1016/j.bspc.2026.110337},
	url = {https://www.scopus.com/pages/publications/105036190817?origin=resultslist},
	abstract = {Early diagnosis of gastrointestinal diseases using deep learning remains challenging due to the limited availability of annotated endoscopic images. Although vision–language models have demonstrated strong performance in natural image understanding, their direct application to medical endoscopy is limited by the semantic discrepancy between natural and clinical domains. To address these issues, we propose an Attribute-Driven Prompt Learning (ADPL) framework that leverages vision–language models to enhance few-shot gastrointestinal disease classification. The proposed ADPL consists of two core components: attribute description generation and cross-modal prompt optimization. Specifically, attribute description generation, which employs large language models to generate standardized medical attribute descriptions (color, shape, texture, and boundary) through visual question answering for semantic guidance. Cross-modal prompt optimization aims to integrate the generated attribute descriptions with learnable visual and attribute prompts via the Attribute-to-Visual Fuser (AVF) and leverages prompt learning to enable domain adaptation to gastrointestinal endoscopy. Experiments were conducted on four gastrointestinal endoscopy datasets under few-shot settings, with each class limited to {1, 2, 4, 8, 16} annotated training samples. The results demonstrate that ADPL achieves state-of-the-art performance, significantly outperforms multiple advanced few-shot learning methods in gastrointestinal endoscopy classification. The code will be available at https://github.com/Xqq0qwq/ADPL. © 2026 Elsevier Ltd},
	author_keywords = {Few-shot learning; Gastrointestinal endoscopy; Prompt learning; Vision–language model},
	keywords = {Deep learning; Endoscopy; Gastroenterology; Learning systems; Medical imaging; Sampling; Semantics; Visual languages; Cross-modal; Disease classification; Early diagnosis; Few-shot learning; Gastrointestinal Disease; Gastrointestinal endoscopies; Language model; Optimisations; Prompt learning; Vision–language model; Classification (of information)}
}

