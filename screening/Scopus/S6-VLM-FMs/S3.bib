@ARTICLE{Wang20253997,
	author = {Wang, Zipei and Fang, Mengjie and Tang, Linglong and Tian, Jie and Dong, Di},
	title = {HiCur-NPC: Hierarchical Feature Fusion Curriculum Learning for Multi-Modal Foundation Model in Nasopharyngeal Carcinoma},
	year = {2025},
