@ARTICLE{Fuchs2025,
	author = {Fuchs, Benedikt and Thierfelder, Nikolaus and Aranda, Irene Mesas and Alt, Verena and Kuhlmann, Constanze and Haas-Lützenberger, Elisabeth M. and Koban, Konstantin C. and Giunta, Riccardo E. and Mert, Sinan},
	title = {Augmenting Patient Education in Hand Surgery—Evaluation of ChatGPT as an Informational Tool in Carpal Tunnel Syndrome},
	year = {2025},
