@ARTICLE{Zhang2026,
	author = {Zhang, Xingyu and Zheng, Xiangwei and Li, Zhen and Ma, Mingjun and Liang, Xiao and Ren, Xiuxiu and Zhang, Mingzhe},
	title = {A Fine-tuning Multimodal Large Language Model for Endoscopic Report Generation},
	year = {2026},
	journal = {Biomedical Signal Processing and Control},
	doi = {10.1016/j.bspc.2026.109737},
	url = {https://www.scopus.com/pages/publications/105028986667?origin=resultslist},
	abstract = {Background and Objective: Writing endoscopic image reports requires extensive domain expertise, and even experienced clinicians spend substantial time on them. Although multimodal large language models (MLLMs) excel at cross-modal understanding and generation, general models struggle with specialized terminologies, pathological features, and complex medical logic, limiting their accuracy and applicability in endoscopy. Existing fine-tuning methods can improve model performance to some extent, but they often suffer from limited adaptability and insufficient domain-specific knowledge when applied to tasks in specialized fields. Methods: We propose a fine-tuning multimodal large Language Model for Endoscopic Report Generation (ERGLM). We apply a two-stage parameter-efficient fine-tuning method to address the specific requirements of endoscopic report generation. In the first-stage fine-tuning, we collect a large number of publicly available datasets to acquire knowledge of digestive endoscopy for addressing the lack of domain-specific knowledge. In the second stage, we use professionally clinical data for fine-tuning to enhance the professionalism of the model in generating reports. Then a prompt-based LoRA fine-tuning method (P-LoRA) is integrated into both stages to better adapt to the task of generating professional endoscopic reports. Results: Experimental results show that ERGLM attains state-of-the-art performance on our dataset, achieving CIDEr of 0.2667, ROUGE-L of 0.4598, METEOR of 0.4070, BLEU-4 of 0.3863, and BERTScore of 0.8216. © 2026 Elsevier Ltd},
