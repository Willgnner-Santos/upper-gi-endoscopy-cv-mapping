@ARTICLE{Choi20242294,
	author = {Choi, Woo Jin and Roberts, Surain and Verma, Amol and Razak, Fahad and O’Kane, Grainne M. and Gallinger, Steven and Hirschfield, Gideon and Hansen, Bettina and Sapisochin, Gonzalo},
	title = {Characterizing the burden of biliary tract cancers across 28 hospitals in Ontario, Canada},
