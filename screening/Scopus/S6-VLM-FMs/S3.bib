@ARTICLE{Li2026,
	author = {Li, Guoliang and Meng, Fanxu and Li, Qianqian and Li, Yibin and Qi, Lei and Song, Rui},
	title = {SGBA-Net: Semantic-guided bleeding-aware segmentation network for spinal endoscopy},
	year = {2026},
	journal = {Neurocomputing},
	doi = {10.1016/j.neucom.2026.133547},
	url = {https://www.scopus.com/pages/publications/105034618958?origin=resultslist},
	abstract = {In minimally invasive spinal endoscopic surgery, intraoperative bleeding remains a major challenge as it obscures the surgical view, elevates operative risks, and may cause postoperative complications. Accurate bleeding segmentation from endoscopic images is difficult due to highly variable morphology, vague boundaries, and color similarity with surrounding tissues. To address this challenge, we propose SGBA-Net, a Semantic-Guided Bleeding-Aware Segmentation Network for precise bleeding segmentation. SGBA-Net integrates CLIP-based language prompts (“red bleeding region”) into DINOv2 via an adapter to enhance bleeding-awareness of visual features. A prior segmentation head produces coarse masks, which are progressively refined by SAM2 with multimodal guidance to achieve coarse-to-fine precision. Furthermore, we construct SeBlood, a new dataset of 1421 spinal endoscopic images with pixel-level bleeding annotations. Experimental results demonstrate that SGBA-Net consistently outperforms state-of-the-art models on SeBlood. This work offers an effective solution for intraoperative bleeding segmentation and establishes a new paradigm for leveraging foundation models in complex medical image analysis. © 2026 Elsevier B.V.},
	author_keywords = {Bleeding detection; Medical image segmentation; Parameter-efficient tuning; Semantic-guided segmentation},
	keywords = {Color image processing; Medical image processing; Semantic Segmentation; Semantic Web; Semantics; Transplantation (surgical); Bleeding detections; Bleedings; Endoscopic image; Endoscopic surgery; Intra-operative; Medical image segmentation; Minimally invasive; Parameter-efficient tuning; Postoperative complications; Semantic-guided segmentation; Article; bleeding; computer aided design; deep learning; discriminant analysis; embedding; endoscopic surgery; endoscopy; feature extraction; gastrointestinal hemorrhage; generalization (psychology); hierarchical clustering; human; image analysis; image segmentation; implementation science; large language model; logistic regression analysis; lumbar discectomy; natural language processing; postoperative complication; qualitative analysis; semantics; sensitivity analysis; support vector machine; volumetry; Endoscopy}
