@CONFERENCE{Oguine2024,
	author = {Oguine, Kanyifeechukwu J. and Soberanis-Mukul, Roger D. and Drenkow, Nathan and Unberath, Mathias},
	title = {From Generalization to Precision: Exploring SAM for Tool Segmentation in Surgical Environments},
	year = {2024},
