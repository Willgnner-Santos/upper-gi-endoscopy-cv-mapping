@CONFERENCE{Ejiga Peter2025,
	author = {Ejiga Peter, Ojonugwa Oluwafemi and Akor Ejiga, Frederick and Khalifa, Fahmi and Rahman, Md Mahmudur},
	title = {Parameter-Efficient VLMs for Gastrointestinal Endoscopy: Medical Image Generation and Clinical Visual Question Answering},
	year = {2025},
