@ARTICLE{Fang2026562,
	author = {Fang, Hao and Zeng, Zhuo and Yang, Jianwei and Fan, Wenkang and Luo, Xiongbiao},
	title = {Structure-Aware Cross-Modal Prompt Tuning for Autonomous Bronchoscopic Navigation},
	year = {2026},
