	title = {Transfer learning-based endoscopic image recognition of nasopharyngeal carcinoma: investigating pre-trained large models in small sample settings; [基于迁移学习的鼻咽癌内镜图像识别：预训练大模型在小样本条件下的研究]},
	year = {2025},
	journal = {Chinese Journal of Otorhinolaryngology Head and Neck Surgery},
