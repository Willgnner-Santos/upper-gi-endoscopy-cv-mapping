@ARTICLE{Wang2025,
	author = {Wang, Bilin and Lei, Changda and Guo, Yunbo and Hong, Kaicheng and Kan, Xiuji and Ouyang, Yifan and Li, Junbo and Li, Rui},
	title = {Task-specific prompting SAM for multi-task gastric cancer diagnosis in endoscopic images},
