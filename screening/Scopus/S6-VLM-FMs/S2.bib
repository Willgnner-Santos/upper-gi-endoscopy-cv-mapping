	keywords = {Endoscopy; Medical computing; Medical imaging; Privacy-preserving techniques; Systems analysis; Boundary-aware loss; Colonoscopy; Images segmentations; Language model; Large language model; Mask synthesis; Multi-resolution mask synthesis; Polyp image segmentation; Polyp segmentation; Privacy preserving; Image segmentation}
