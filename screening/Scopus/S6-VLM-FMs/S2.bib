@ARTICLE{Paranjape2025187,
	author = {Paranjape, Jay N. and Sikder, Shameema and Vedula, S. Swaroop and Patel, Vishal M.},
	title = {Low-Rank Adaptation of Segment Anything Model for Surgical Scene Segmentation},
