  pages = {73-76},
  title = {Efficient Transfer Laerning Used in the Classification of Gastroscopic Images with Small Dataset},
  volume = {},
  year = {2020}
}

@inproceedings{9396379,
  abstract = {Objectives: The two-stage method for automatic endoscopic images segmentation, which provides efficient polyps segmentation in condition of small database for training is proposed. Methods: Proposed method includes two stage. First stage is based on machine learning, second stage uses deep learning. Experimental research was conducted to verify and evaluate the proposed two-step method. We used for comparing with the proposed method a neural network U-net to segment 964 real endoscopic images of the open Kvasir database. The segmentation quality was estimated by the total average Dice coefficient. Results: The proposed method realizes automatic segmentation of polyp regions in endoscopic images. Compared with neural network segmentation method, this two-stage method improves the efficiency of polyp segmentation: The total average Dice coefficient of this two-stage method is 0.8, it is significant better than in the case of segmentation only with CNN (The Dice for U-net with extremely small data base for training is 0.3). Conclusions: Using the developed method can improve the efficiency of polyp automatic segmentation in endoscopic images.},
  author = {Xin, Yang and Obukhova, Nataliia A. and Titov, Ivan P.},
  booktitle = {2021 IEEE Conference of Russian Young Researchers in Electrical and Electronic Engineering (ElConRus)},
  doi = {10.1109/ElConRus51938.2021.9396379},
  issn = {2376-6565},
  journal = {2021 IEEE Conference of Russian Young Researchers in Electrical and Electronic Engineering (ElConRus)},
  keywords = {Training;Radio frequency;Image segmentation;Machine learning algorithms;Databases;Neural networks;Medical services;Gastric endosopic images;U-net algorithm;Polyp segmentation;Random forest algorithm;Automatic image segmention},
  month = {Jan},
  number = {},
  pages = {1708-1711},
  title = {The Automatic Method of Endoscopic Images Analysis for Differential Diagnosis},
  volume = {},
  year = {2021}
}

@article{9457060,
  abstract = {Goal: Eosinophilic esophagitis (EoE) is an allergic inflammatory condition characterized by eosinophil accumulation in the esophageal mucosa. EoE diagnosis includes a manual assessment of eosinophil levels in mucosal biopsies–a time-consuming, laborious task that is difficult to standardize. One of the main challenges in automating this process, like many other biopsy-based diagnostics, is detecting features that are small relative to the size of the biopsy. Results: In this work, we utilized hematoxylin- and eosin-stained slides from esophageal biopsies from patients with active EoE and control subjects to develop a platform based on a deep convolutional neural network (DCNN) that can classify esophageal biopsies with an accuracy of 85%, sensitivity of 82.5%, and specificity of 87%. Moreover, by combining several downscaling and cropping strategies, we show that some of the features contributing to the correct classification are global rather than specific, local features. Conclusions: We report the ability of artificial intelligence to identify EoE using computer vision analysis of esophageal biopsy slides. Further, the DCNN features associated with EoE are based on not only local eosinophils but also global histologic changes. Our approach can be used for other conditions that rely on biopsy-based histologic diagnostics.},
  author = {Czyzewski, Tomer and Daniel, Nati and Rochman, Mark and Caldwell, Julie M. and Osswald, Garrett A. and Collins, Margaret H. and Rothenberg, Marc E. and Savir, Yonatan},
  doi = {10.1109/OJEMB.2021.3089552},
  issn = {2644-1276},
  journal = {IEEE Open Journal of Engineering in Medicine and Biology},
  keywords = {Biopsy;Training;Residual neural networks;Convolutional neural networks;Pediatrics;Microscopy;Hospitals;Decision support system;deep convolutional network;digital pathology;eosinophilic esophagitis;small features detection},
  month = {},
  number = {},
  pages = {218-223},
  title = {Machine Learning Approach for Biopsy-Based Identification of Eosinophilic Esophagitis Reveals Importance of Global features},
  volume = {2},
  year = {2021}
}

@inproceedings{9624380,
  abstract = {The wireless capsule endoscope (WCE) is usually used in the detection of digestive tract diseases. It has the advantages of simple use, convenient inspection, no pain, and ability to inspect the small intestine, becoming one of the hot spots in the research field of medical device. At present, the examination of WCE images is mainly manual. Thousands of images need to be examined. Therefore, the accuracy of the diagnosis is closely related to the experience of the doctor and the state of the examination. This study intends to develop a model to assist doctors in the examination. First, we established a gastritis dataset based on the endoscopic data from 20 patients. Because of the small differences in the appearance of gastritis and normal images, we creatively proposed a method of combining manual features and depth features to characterize the gastritis images. The Least absolute shrinkage and selection operator (Lasso) feature filtering and Principal Component Analysis (PCA) dimensionality reduction methods were afterwards used to screen the informative features. Subsequently, the multiple machine learning methods such as K-Nearest Neighbor (KNN), Support Vector Machine (SVM), adaptive boostint (Adaboost) and RamdomFroest were used to model classifiers. The experimental results show that the best gastritis detection model using the selected features (7 handcrafted features and 13 deep features) and SVM realizes the accuracy, recall, precision and F1-score of $97.86%±0.82%, 97.32%±2.28%,\ 98.32%±1.98%$ and $0.98± 0.01$ respectively.},
  author = {Zhao, Bailiang and Sun, Wendell Q. and Wang, Liangchao and Hu, Menghan},
  booktitle = {2021 14th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics (CISP-BMEI)},
  doi = {10.1109/CISP-BMEI53629.2021.9624380},
  issn = {},
  journal = {2021 14th International Congress on Image and Signal Processing, BioMedical Engineering and Informatics (CISP-BMEI)},
  keywords = {Support vector machines;Wireless communication;Adaptation models;Endoscopes;Biological system modeling;Signal processing algorithms;Medical services},
  month = {Oct},
  number = {},
  pages = {1-6},
  title = {Fusion of Selected Deep CNN and Handcrafted Features for Gastritis Detection from Wireless Capsule Endoscopy Images},
  volume = {},
  year = {2021}
}

@inproceedings{9653496,
  abstract = {With the advent of the information age, medical image classification technology has become a hot research topic in the field of computer vision. Based on the Tensorflow deep learning framework, a ResNet model of esophagitis disease recognition from gastrointestinal mirror image is established in this paper. Further, the random erasing data augmentation algorithm RE is applied to optimizing the images, which are then used in the network. As a result, the accuracy of the optimized network over the Kvasir data set can reach 97%.},
