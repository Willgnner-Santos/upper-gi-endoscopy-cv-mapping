@inproceedings{10262774,
  abstract = {The main focus of this work is to perform a computer vision classification method for upper gastrointestinal tract image analysis with a pre-trained deep learning features extraction stage. An open-source dataset was used containing images of upper gastrointestinal tract problems including Esophagitis (260 images) and Barretts (94 images). In the given input, image pre-processing with image re-sizing, and noise removal was applied, and then finally working extraction of features using pre-trained deep neural networks. The extracted data from the second last layer of pre-trained models represents the most prominent features. The extracted features are then classified with the help of machines and ensemble learning methods. The improved classification results have been identified using pre-trained models based on feature extraction techniques in comparison to traditional deep learning models.},
  author = {Khullar, Vikas and R.M, Veeramanickam M. and Muthukumarasamy, S. and Prabha, Chander and Pal Singh, Harjit and Pavankumar, Vadrevu},
  booktitle = {2023 International Conference on Computer, Electronics & Electrical Engineering & their Applications (IC2E3)},
  doi = {10.1109/IC2E357697.2023.10262774},
  issn = {},
  journal = {2023 International Conference on Computer, Electronics & Electrical Engineering & their Applications (IC2E3)},
  keywords = {Deep learning;Image analysis;Precision medicine;Surgery;Artificial neural networks;Feature extraction;Gastrointestinal tract},
  month = {June},
  number = {},
  pages = {1-7},
  title = {Hybrid of DNN Feature Extraction and Ensemble Classification for Identification of Esophagitis and Barretts in Upper Gastrointestinal Tract Images},
  volume = {},
  year = {2023}
}

@inproceedings{10328381,
  abstract = {The purpose of this work is to determine which is the best general method of feature localization for image matching in endoscopy images. To accomplish this, we conduct an exhaustive analysis of ten well-known feature detectors, descriptors, and learned algorithms, such as SIFT, FAST, SURF, ORB, BRIEF, BRISK, FREAK, HARRIS, DFM, and LoFTR. The analysis is performed across six challenging medical datasets, including cardiorespiratory endoscopy, human laparoscopy, bronchoscopy, gastroscopy, rabbit laparoscopy, and pig laparoscopy. This framework is highly diverse, containing a variety of textures, camera motions, tissue deformations, and visual barriers. To determine which technique is the best on average, we perform a qualitative analysis of the inliers and a quantitative analysis using the number of key-points, number of matches, number of inliers, computational cost, sparsity of the inliers, recall and 1-precision. To complete the study, we considered the sequential and template modes, as they are highly used in computer vision. Furthermore, we examine how those features may be exploited in the reconstruction of 3D shapes from visual cues.},
  author = {Urdapilleta, Ana and Agudo, Antonio},
  booktitle = {2023 IEEE International Conference on Image Processing Challenges and Workshops (ICIPCW)},
  doi = {10.1109/ICIPC59416.2023.10328381},
  issn = {},
  journal = {2023 IEEE International Conference on Image Processing Challenges and Workshops (ICIPCW)},
  keywords = {Laparoscopes;Location awareness;Training;Visualization;Three-dimensional displays;Endoscopes;Deformation;Endoscopic Images;Feature Extraction and Matching;Data-driven Features},
  month = {Oct},
  number = {},
  pages = {3719-3723},
  title = {COmparative Study of Feature Localization Methods for Endoscopy Image Matching},
  volume = {},
  year = {2023}
}

@inproceedings{10373530,
  abstract = {Gastric cancer is the fourth deadliest cancer worldwide. Esophagogastroduodenoscopy (EGD) is the preferred method to diagnose upper gastrointestinal lesions, particularly early gastric cancer. The procedure’s success relies on the endoscopist’s experience and a comprehensive examination by observing a set of anatomical landmarks. Most gastric neoplasias are undetected during early stages, despite being present during examinations, thus, it is essential to evaluate the quality and audit the examination of anatomical regions during the endoscopy procedure. This study assesses the performance of a recurrent neural network and transformer architecture in classifying anatomical and sub-anatomical regions within the gastrointestinal tract. By leveraging temporal information, the study aims to enhance the accuracy of detecting these critical regions. We collected and labeled video endoscopies from 32 patients, organizing them into four organ categories. Additionally, we utilized 565 labeled sequences from six sub-anatomical stomach regions for a separate classification task. The trained networks achieved a macro F1-score of 87.25% for organ classification and an 85.31% in identifying stomach regions. These findings provide substantial evidence supporting that temporal information improves the capabilities of accurately identify upper gastrointestinal regions.},
  author = {Bravo, Diego and Medina, Sebastian and Ruano, Josué and Jaramillo, María and Gómez, Martin and González, Fabio A. and Romero, Eduardo},
  booktitle = {2023 19th International Symposium on Medical Information Processing and Analysis (SIPAIM)},
  doi = {10.1109/SIPAIM56729.2023.10373530},
  issn = {},
  journal = {2023 19th International Symposium on Medical Information Processing and Analysis (SIPAIM)},
  keywords = {Stomach;Recurrent neural networks;Endoscopes;Transformers;Gastrointestinal tract;Quality assessment;Task analysis;Endoscopy;Sequences;Sub-anatomical region;Classification;GRU;Transformer encoder;Quality indicator},
  month = {Nov},
  number = {},
  pages = {1-5},
  title = {Automated Anatomical Classification and Quality Assessment of Endoscopy by Temporal-Spatial Analysis},
  volume = {},
  year = {2023}
}

@inproceedings{10435544,
  abstract = {Gastric cancer is one of the most common malignant tumors of the digestive system. Although gastroscopy can effectively detect early cancers, manual identification and diagnosis is time-consuming and laborious, and the false-negative rate is as high as 4.6-25.8%. Early gastric cancer lesion areas can be detected and segmented using deep learning techniques. We collected and organized 12665 eligible gastroscopy images, and cropped and expanded the original dataset after labeling by professional doctors, and finally obtained 19673 images for model training. We propose ResMSE Net and DWFF Net and apply these two networks to Mask R-CNN to obtain a new model: Mask R-CNN With R-D Net. On the same standard dataset, the mAP@[IoU=0.5] and ACC values of the Mask R-CNN With R-D Net model achieve respectively 45.37% and 67.74%, which are improved by 5.83% and 9.08%, respectively, compared with the original model. In our experiments, we found that Mask R-CNN With R-D Net is difficult to detect targets that are extremely similar to the background, which is the direction of our future work. Secondly, we hope to minimize the number of model parameters and make the model more lightweight under the premise of ensuring accuracy, so that the model can be embedded into gastroscopy detection equipment for real-time detection.},
  author = {Liang, Tao and Lei, Yi and Song, Wenai and Sun, Xue and Du, Jun and Wang, Qing and Zhao, Li},
  booktitle = {2023 3rd International Conference on Electronic Information Engineering and Computer Science (EIECS)},
  doi = {10.1109/EIECS59936.2023.10435544},
  issn = {},
  journal = {2023 3rd International Conference on Electronic Information Engineering and Computer Science (EIECS)},
  keywords = {Training;Image segmentation;Computational modeling;Medical services;Data models;Lesions;Cancer;deep learning;gastroscopy images;early gastric cancer},
  month = {Sep.},
  number = {},
  pages = {1346-1352},
  title = {Mask R-CNN with R-D Net: A Detection and Segmentation Model for Early Gastric Cancer Gastroscopy Images},
  volume = {},
  year = {2023}
}

@inproceedings{10472340,
  abstract = {The advancement of deep learning techniques has significantly improved abnormality detection in gastrointestinal (GI) endoscopy. However, this imaging process comes with challenges due to the complex nature of GI abnormalities. The wide variety of abnormalities in terms of type, color, texture, shape, and scale of lesions makes it difficult to accurately detect them in different scenarios. Furthermore, the presence of multiple types of lesions within the same region create complex scenarios that complicate abnormality detection. Additionally, differentiating early-stage cancers from non-cancerous lesions is a significant challenge even for experienced professionals. The simultaneous identification of cancers, particularly early-stage ones, and non-cancerous lesions within the same region remains a challenging issue in GI endoscopy imaging. In this study, we discover that multiple types of lesions exhibit a scale-sensitive characteristic that can be leveraged by multi-level feature-based deep learning models. Hence, we propose the use of a multi-level and multi-scale attention (MLMSA) neck module in a deep learning network. The MLMSA module utilizes multiple levels of features extracted from the backbone network to generate processed multi-level features that assist the detection head. By integrating the MLMSA module into the deep learning framework, our goal is to enhance the detection and differentiation of lesions, particularly the early-stage cancer, thereby advancing the capabilities of GI endoscopy imaging. Our experiment results show that integrating the MLMSA module leads to a significant improvement in the detection of GI abnormalities, providing compelling evidence for the enhanced performance achieved through the utilization of the MLMSA module in our approach.},
  author = {Zhang, Zhang and Wang, Xizhe and Chen, Shuijiao and Liu, Xiaowei and Chen, Qilei and Zhang, Yizhe and Cao, Yu and Liu, Benyuan},
  booktitle = {2023 IEEE International Conference on E-health Networking, Application & Services (Healthcom)},
  doi = {10.1109/Healthcom56612.2023.10472340},
  issn = {},
  journal = {2023 IEEE International Conference on E-health Networking, Application & Services (Healthcom)},
  keywords = {Deep learning;Image analysis;Endoscopes;Shape;Image color analysis;Imaging;Feature extraction;Lesion Detection;Cancer Detection;Endoscope Image Analysis},
  month = {Dec},
  number = {},
  pages = {144-150},
  title = {MLMSA: Multi-Level and Multi-Scale Attention for Lesion Detection in Endoscopy},
  volume = {},
  year = {2023}
}

@inproceedings{10635276,
  abstract = {The risk of developing gastric cancer is associated with the presence of precursor lesions, like metaplasia, currently assessed by visually scoring histopathology images. Metaplasia appearance changes have been documented during endoscopy, however they need to be highlighted by expensive dyes or devices which require high levels of expertise to be properly applied. In contrast, White Light Endoscopy (WLE) is a more cost-effective option, but it reports inter-observer variability in metaplasia diagnosis. In this scenario, computational strategies may extract subvisual patterns and associate them with metaplasia during a conventional endoscopy. This paper introduces a method to extract features from WLE images to train a neural network for predicting the presence of metaplasia, in this case confirmed by histopathological analysis. With a set of 57 real cases (34 controls and 23 diagnosed with OLGIM 1 to 3). The method achieves an accuracy and F1-score of 76.5% and 73.7%, respectively for the binary problem.},
  author = {Jaramillo, María and Bravo, Diego and Quijano, Jose M. and Gómez, Martín and González, Fabio A. and Romero, Eduardo},
  booktitle = {2024 IEEE International Symposium on Biomedical Imaging (ISBI)},
  doi = {10.1109/ISBI56570.2024.10635276},
  issn = {1945-8452},
  journal = {2024 IEEE International Symposium on Biomedical Imaging (ISBI)},
  keywords = {Measurement;Endoscopes;Histopathology;Neural networks;Computer architecture;Feature extraction;Gastrointestinal tract;Endoscopy;metaplasia;histopathology},
  month = {May},
  number = {},
  pages = {1-5},
  title = {Predicting Metaplasia in Upper Gastrointestinal Images from White Light Endoscopy},
  volume = {},
  year = {2024}
}

@inproceedings{10635452,
  abstract = {Gastric cancer ranks as the fifth leading cause of cancer mortality worldwide. The quality of upper gastrointestinal endoscopy is crucial towards early identification of premalignant conditions and relies on the endoscopist’s skill and thorough examination of stomach landmarks. Unfortunately, it has been observed that existing cancerous lesions may go undetected during examination. To standardize the quality of this procedure, meticulous protocols have been proposed. To support this process, we focused on developing a model to identify the anatomical locations in esophagogastroduodenoscopy images. This study advances endoscopic image classification by incorporating depth map estimation, essential for measuring distances to specific landmarks. This method, analyzing 2,054 images from 96 patients across 13 gastric regions using the ConvNeXT architecture with information fusion techniques, achieved an 87% F1 macro score. This approach suggests that depth map integration can improve stomach region classification, boosting prediction accuracy and potentially reducing missed gastric lesions.},
  author = {Bravo, Diego and Ruano, Josué and Jaramillo, María and Medina, Sebastian and Gómez, Martín and González, Fabio A. and Romero, Eduardo},
  booktitle = {2024 IEEE International Symposium on Biomedical Imaging (ISBI)},
  doi = {10.1109/ISBI56570.2024.10635452},
  issn = {1945-8452},
  journal = {2024 IEEE International Symposium on Biomedical Imaging (ISBI)},
  keywords = {Stomach;Protocols;Endoscopes;Estimation;Biomedical measurement;Boosting;Gastrointestinal tract;Endoscopy;Sub-anatomical region;Classification;Fusion Information;Depth map},
  month = {May},
  number = {},
  pages = {1-5},
  title = {Automatic Endoscopy Classification by Fusing Depth Estimations and Image Information},
  volume = {},
  year = {2024}
}

@inproceedings{10661758,
  abstract = {At present, the incidence and mortality of gastric cancer rank in the top five of all cancers, which seriously endangers people’s life and health, and the detection of early gastric cancer can greatly improve the survival rate of gastric cancer patients. Based on the features of early gastric cancer in gastroscopy, this paper studies the intelligent detection of early gastric cancer by using object detection technology. Detection Transformer (DETR) is a mainstream object detection framework at present, it shows good detection effect on COCO data set, but it is rarely used in medical image object detection. Through in-depth study of DETR model, we find that DETR has shortcomings in multi-object and smaller object detection, which will affect the effect of detection. So, we propose a multi-scale feature fusion method for early gastric cancer detection (MF-DETR) based on the DETR model. The main improvements include multi-scale feature fusion module and hybrid encoder design. We rely on early gastric cancer cases provided by Chongqing University Cancer Hospital, and then enhance the data to form 2062 images as an early gastric cancer data set. Through experiments, MF-DETR can achieve 97.79% AP50, 92.31% precision, and 93.91% recall rate. Compared with DETR, it has 2.68% improvement in $\mathrmAP_50, 1.12 %$ improvement in precision, and 3.91% improvement in recall. Finally, the effectiveness of multi-scale feature fusion design and hybrid encoder design are verified by ablation experiments.},
  author = {Zhang, Hengrui and Lu, Meichen and Chen, Weiqing and Ao, Fei and Chai, Yi},
  booktitle = {2024 43rd Chinese Control Conference (CCC)},
  doi = {10.23919/CCC63176.2024.10661758},
  issn = {1934-1768},
  journal = {2024 43rd Chinese Control Conference (CCC)},
  keywords = {Hospitals;Convolution;Design methodology;Object detection;Feature extraction;Cancer detection;Transformers;Early gastric cancer;multi-scale features;feature fusion},
  month = {July},
  number = {},
  pages = {7304-7309},
  title = {An Early Gastric Cancer Detection Method Based on DETR Multi-scale Feature Fusion},
  volume = {},
  year = {2024}
}

@inproceedings{10667897,
  abstract = {The latest development of AI with endoscopy video surveillance and analysis techniques enables viewing both ends of a patient’s digestive tract, which helps to detect abnormalities like cancer and ulcer in the stomach. Using traditional endoscopy techniques, an experienced clinician must spend at least an hour for classification by viewing and analyzing approximately 5,000 images produced during one examination. Therefore, it is essential to identify the optimal features using Deep Learning in endoscopy video surveillance techniques. The video observation for object detection strategy to find the connected region to characterize and relate with the diagnostic program constructed based on optimal features with deep learning architecture and is trained with 10,000 (Esophago Gastro Duodenoscopy) EGD data set. The paper proposes a Medical Diagnostic Decision Support System (MDDSS) framework, which comprises two phases. In the initial phase, the object recognition and characterization of gastric ulcer and gastric cancer in the endoscopy video, we use Flower Pollination (FP) algorithm. This procedure deals with using color features selection, as well it realizes the efficacy of 97.56% for detecting and classifying bleeding cancer and ulcer growth regions.},
  author = {Ramamoorthy, M. and GnanaJeyaraman, R. and Belinda M J, Carmel Mary and Manimaran, A and Kannan, K Nattar and Thangarasu, Gunasekar},
  booktitle = {2024 IEEE 6th Symposium on Computers & Informatics (ISCI)},
  doi = {10.1109/ISCI62787.2024.10667897},
  issn = {2996-6752},
  journal = {2024 IEEE 6th Symposium on Computers & Informatics (ISCI)},
  keywords = {Deep learning;Stomach;Power measurement;Endoscopes;Lighting;Object detection;Feature extraction;Smart Endoscopy;Video surveillance;Stomach cancer;Ulcer;Classification;Esophago Gastro Duodenoscopy},
  month = {Aug},
  number = {},
  pages = {258-263},
  title = {Early Cancer Diagnosis and Ulcer Classifications In Endoscopy Videos Using Deep Learning Approach},
  volume = {},
  year = {2024}
}

@inproceedings{10803504,
  abstract = {Gastric cancer is one of the most lethal cancers. Currently, clinical diagnosis primarily relies on gastroscopic biopsies and the manual experience of doctors to assess the development of lesions in tissue sections. However, pathological screening requires a significant amount of time from specialized pathologists. Due to variations in clinical experience and limitations in medical resources, the detection of gastric cancer still faces challenges. Traditional methods for segmenting gastric cancer images often overlook the hierarchical structure of features and the spatial details, both local and global, in the lesion images. To address the above issues, this paper proposes a hybrid and efficient pathological image segmentation network named DAC-UNet, designed for precise pathological image segmentation tasks. DAC-UNet uses Cswin Transformer blocks to build a hierarchical structure, allowing it to capture global information with less computational complexity. The network also includes multi-scale dual attention skip connections between the encoder and decoder to preserve local spatial details and improve global interactions across different scales. We conducted a thorough theoretical analysis of this method and validated it on a gastric slice dataset. The experimental results demonstrate that our proposed method achieves outstanding performance on both our gastric slice dataset and the MoNuSeg dataset. Specifically, on our gastric slice dataset, we obtained a Dice similarity coefficient (DSC) of 89.42% and an HD95 of 47.24, while on the MoNuSeg dataset, we achieved a DSC of 79.28% and a 95th percentile Hausdorff distance (HD95) of 19.38.},
  author = {Hu, Tao and Pan, Jingshan and Li, Na and Tian, Tangbin and Liu, Shengyu and Zhang, Lu and Han, Yujiao and Xu, Jiwei},
  booktitle = {2024 IEEE International Conference on Medical Artificial Intelligence (MedAI)},
  doi = {10.1109/MedAI62885.2024.00049},
  issn = {},
  journal = {2024 IEEE International Conference on Medical Artificial Intelligence (MedAI)},
  keywords = {Image segmentation;Pathology;Semantics;Manuals;Transformers;Decoding;Lesions;Medical diagnostic imaging;Faces;Cancer;DAC-UNet;pathological image segmentation;gastric cancer;attention mechanism;convolutional neural network;multi-scale features;Transformer},
  month = {Nov},
  number = {},
  pages = {325-330},
  title = {DAC-UNet: Dual Attention CNN-Enhanced CswinUnet for Gastric Cancer Pathological Image Segmentation},
  volume = {},
  year = {2024}
}

@article{10943118,
  abstract = {Using deep-learning techniques, such as convolutional neural networks to locate polyps in gastroscopic images automatically is of great significance for preventing gastric cancer. However, polyps are typically irregular in shape and inconsistent in size, posing challenges to the predictive performance of previous models. Previous localization models typically treat all parts of the gastroscopic image equally with multiple convolution and pooling operations without considering the importance of different positions. As polyps may occupy only a tiny portion of the gastroscopic image, the model should prioritize attention to different positions in the image differently. Moreover, in previous models, pooling operations generally employ max-pooling or average-pooling, which are less effective in information retention and positional awareness. Therefore, inspired by attention mechanisms and fuzzy algorithms, in this work, we propose a Hybrid Attention Fuzzy Pooling Network (HAFPN) for locating polyps in gastroscopic images in Internet of Medical Things. The advantages of the HAFPN model lie in the following. First, valuable local information in the image is preserved using a hybrid attention mechanism. Specifically, the HAFPN model inputs gastroscopic images into a convolutional neural network augmented with channel attention and spatial attention mechanisms to calculate the coordinates of gastric polyps. The combination of channel attention and spatial attention mechanisms helps the HAFPN model dynamically capture channel and spatial information from the original image. Second, fuzzy pooling operations preserve positional information in the feature maps. We conducted extensive experiments on a real gastroscopic dataset to validate the effectiveness of the HAFPN model.},
  author = {Ma, Xiaoyu and Wang, Honghu and Ren, Xiaoxue and Ma, Yu},
  doi = {10.1109/JIOT.2025.3555427},
  issn = {2327-4662},
  journal = {IEEE Internet of Things Journal},
  keywords = {Attention mechanisms;Endoscopes;Training;Location awareness;Cancer;Feature extraction;Convolutional neural networks;Computational modeling;Predictive models;Deep learning;Fuzzy pooling network;gastric cancer;gastroscopic images;hybrid attention;Internet of Medical Things (IoMT)},
  month = {Nov},
  number = {22},
  pages = {45985-45994},
  title = {A Hybrid Attention-Based Fuzzy Pooling Network Model for Locating Polyp Positions in Gastroscopic Image in Internet of Medical Things},
  volume = {12},
  year = {2025}
}

@inproceedings{10986471,
  abstract = {The main reason for a large portion of deaths related to cancer is caused by gastric cancer which is the worst form of disease. Endoscopy is the test that can identify this disease at its early stage which can result in patient survival rates. This study tries to enhance the processing of gastroscopic images by using an enhanced Deep learning (DL) model to boost the accuracy of stomach cancer. Pre-processing frequently involves resizing and bilaterally filtering images to increase clarity and reduce noise. Gamma correction is then used to enhance contrast and make the images simpler to read. To function the model more consistently approaches like zooming, scaling, and rotation are applied to improve the images. The model was trained and evaluated in this research utilizing the Kvasir-SEG dataset, which contains thorough annotations for gastroscopic images. To gauge the outcomes, two important metrics were employed: Mean Squared Error (MSE) and Peak Signal-to-Noise Ratio (PSNR). The processed photos show a very little decrease in quality, with Peak Signal-to-Noise Ratio PSNR values ranging from 50.65 to 52.94. The remarkably low Mean Squared Error (MSE) values (ranging from 0.0023 to 0.0029) show that the treated images are still fairly close to the originals. Based on the available data, this approach could significantly enhance the early detection of stomach cancer, allowing doctors to enhance and expedite patient care. In the future, an improved DL model will be used for lesion segmentation.},
  author = {Garg, Jyoti and Chhabra, Mohit},
  booktitle = {2025 3rd International Conference on Disruptive Technologies (ICDT)},
  doi = {10.1109/ICDT63985.2025.10986471},
  issn = {},
  journal = {2025 3rd International Conference on Disruptive Technologies (ICDT)},
  keywords = {Deep learning;Image quality;Stomach;PSNR;Accuracy;Filtering;Noise;Distance measurement;Reliability;Cancer;Gastric Cancer;Early Detection;Gastroscopic Images;Deep Learning (DL);Kvasir-SEG Dataset;PSNR;MSE},
  month = {March},
  number = {},
  pages = {1408-1413},
  title = {Enhancing Image Quality and Early Gastric Cancer Detection Using Pre-Processing Techniques on the Kvasir-SEG Dataset},
  volume = {},
  year = {2025}
}

@inproceedings{11134015,
  abstract = {As artificial intelligence continues to permeate diverse fields, particularly healthcare, deploying deep neural networks in the analysis and processing of medical images has emerged as a cornerstone of advanced diagnostics. Although numerous methods for tracking the lesion have been developed in endoscopic videos, existing studies focus mainly on polyps with relatively distinct morphologies. In this research, we target lesions in the upper gastrointestinal tract, addressing the primary challenge of high tissue and mucosal deformation coupled with the complex motion of the endoscopic camera. To address this, we propose an improvement to the OSNet feature extractor within the StrongSORT pipeline by incorporating a Deformable Convolution Network (DCN), which excels at capturing complex geometric features corresponding to the high deformation of target objects. Experimental results demonstrate that incorporating DCN into the final layers of OSNet significantly improves performance, achieving a mean Average Precision (mAP) of 0.869 and a Rank-1 Accuracy of 0.954. This approach showcases robust tracking capabilities under challenging conditions, paving the way for more accurate and reliable lesion tracking in clinical endoscopy. The code is available at https://github.com/shredder0812/osnet_dcn.},
  author = {Cao, Thanh-Tung and Nguyen, Thi-Thu-Huong and Manh, Xuan-Huy and Kieu, Anh-Hao and Nguyen, Thanh-Tung and Dao, Viet-Hang and Vu, Hai},
  booktitle = {2025 International Conference on Multimedia Analysis and Pattern Recognition (MAPR)},
  doi = {10.1109/MAPR67746.2025.11134015},
  issn = {2770-6850},
  journal = {2025 International Conference on Multimedia Analysis and Pattern Recognition (MAPR)},
  keywords = {Representation learning;Target tracking;Accuracy;Endoscopes;Deformation;Convolution;Streaming media;Feature extraction;Lesions;Videos;Lesion Tracking;Endoscopy;StrongSORT;OSNet;Deformable Convolution Network;OSNet-DCN},
  month = {Aug},
  number = {},
  pages = {1-6},
  title = {OSNet-DCN: Integrating Deformable Feature Learning for Tracking Lesion in Endoscopic Videos},
  volume = {},
  year = {2025}
}

@inproceedings{11138896,
  abstract = {This study introduces a novel approach that combines a dynamic window-sized Swin Transformer with Multi-Instance Learning (MIL) for classifying Helicobacter pylori (Hp) infections in gastroscopy images. By incorporating the U2-Net model for image segmentation, the method enhances the consistency of image quality and the robustness of the model. Experimental results indicate that this approach has distinct advantages in handling patient-labeled data, particularly demonstrating strong adaptability across images acquired from different devices. Hp infection, a global health threat, has significantly impacted human gastrointestinal health. Traditional Hp detection methods have several limitations, so developing a non-invasive, efficient, and accurate Hp infection classification method is clinically and practically significant. This study innovatively integrates a dynamic window-sized Swin Transformer and MIL to address the challenge of patient-labeled data. The Swin Transformer, with its unique hierarchical feature extraction mechanisms, effectively captures both local and global image features. MIL, through an attention mechanism, weighs and aggregates multiple image instances to generate patient-level feature representations. Moreover, the study introduces the U2-Net model for image segmentation, aiming to improve the consistency of image quality. The proposed method outperforms traditional models (e.g., Inception V3 and Efficient B7) in classification accuracy, especially showing strong adaptability and robustness when processing images from different devices. However, some challenges remain, such as the impact of data quality on model performance and the risk of overfitting in small-sample scenarios. Future research will focus on accumulating richer datasets, employing more diverse data augmentation techniques, and exploring additional model optimization methods to further enhance classification performance. This study not only provides a new technical approach for the precision diagnosis of Hp infections but also offers a novel research direction for other medical image classification tasks that rely on weakly supervised data.},
  author = {Jiang, Su and Lv, Zehui},
  booktitle = {2025 IEEE 3rd International Conference on Image Processing and Computer Applications (ICIPCA)},
  doi = {10.1109/ICIPCA65645.2025.11138896},
  issn = {},
  journal = {2025 IEEE 3rd International Conference on Image Processing and Computer Applications (ICIPCA)},
  keywords = {Image quality;Performance evaluation;Adaptation models;Image segmentation;Accuracy;Transformers;Data models;Robustness;Medical diagnostic imaging;Image classification;Medical Image Classification;Helicobacter pylori (Hp) infection;Multi-Instance Learning (MIL);Gastroscopy images},
  month = {June},
  number = {},
  pages = {733-738},
  title = {DwinTMIL: An Innovative Approach for Helicobacter Pylori Infection Classification},
  volume = {},
  year = {2025}
}

@inproceedings{11199511,
  abstract = {Radiomics is a promising technique for the extraction of quantitative imaging biomarkers, yet its application to Endoscopic Gastroduodenoscopy (EGD) remains largely unexplored. In this study, we investigate the feasibility of applying a radiomics-based approach to EGD images for the characterization of gastric intestinal metaplasia (GIM) and dysplasia. Using datasets collected at a tertiary cancer centre (IPO-Porto), we extracted shape, texture, and colour features from annotated images. Feature relevance was evaluated using Smith's Prediction Probability, followed by classification using Support Vector Machines. Results reveal not only the presence of relevant features, but also their interesting predictive value. The most informative features vary between the two tested scenarios, which is expected given the differences in the event itself, but also of the imaging modality. Our findings suggest that radiomic descriptors have the potential to offer biologically meaningful, visually explainable surrogates for gastric disease characterization, as a complementary alternative to traditional deep learning approaches, thus contributing to the development of more interpretable AI systems in gastroenterology.},
  author = {Teixeira, Nuno and Almeida, Eduarda and Dinis-Ribeiro, Mario and Coimbra, Miguel},
  booktitle = {2025 IEEE 8th Portuguese Meeting on Bioengineering (ENBENG)},
  doi = {10.1109/ENBENG67130.2025.11199511},
  issn = {2771-487X},
  journal = {2025 IEEE 8th Portuguese Meeting on Bioengineering (ENBENG)},
  keywords = {Support vector machines;Deep learning;Shape;Image color analysis;Endoscopes;Imaging;Gastroenterology;Biomarkers;Feature extraction;Radiomics},
  month = {Sep.},
  number = {},
  pages = {17-20},
  title = {A Radiomics-Based Approach to Gastric Imaging Biomarker Extraction in Upper GI Endoscopy},
  volume = {},
  year = {2025}
}

@inproceedings{11200389,
  abstract = {The goal of the research is to develop a neural network model for the automatic segmentation of images as a part of implementing a decision support system function in a video endoscopic system. The development is based on the use of modern artificial intelligence technologies, specifically neural networks, which enable the automatic segmentation of metaplasia in endoscopic images. Metaplasia, being a precancerous condition, requires special attention from physicians, and the availability of a tool capable of supporting them during examinations is crucial for improving diagnostics and enhancing the level of medical care. As part of the research, a database of images was collected, an original network architecture was proposed, and a neural network model was created, which achieved the target results in metaplasia segmentation. The conducted studies demonstrated that the developed model outperforms modern counterparts in terms of accuracy metrics. The use of the research results accelerates the data analysis process during video endoscopic examinations, reduces the likelihood of medical errors, and represents an important step toward improving clinical outcomes for patients.},
  author = {Obukhova, N. and Motyko, A. and Savelev, A. and Saveleva, O. and Samarin, A. and Sigaeva, J.},
  booktitle = {2025 10th International Conference on Image, Vision and Computing (ICIVC)},
  doi = {10.1109/ICIVC66358.2025.11200389},
  issn = {},
  journal = {2025 10th International Conference on Image, Vision and Computing (ICIVC)},
