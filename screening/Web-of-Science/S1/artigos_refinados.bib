  researcherid-numbers = {Xiong, Zinan/JWA-2177-2024
Liu, Benyuan/A-1821-2011
},
  title = {Deep learning for gastric location classification: An analysis of
location boundaries and improvements through attention and contrastive
learning},
  unique-id = {WOS:001612137800001},
  volume = {28},
  year = {2023}
}

