  eissn = {1996-756X},
  isbn = {978-1-5106-3829-7},
  issn = {0277-786X},
  journal = {APPLICATIONS OF MACHINE LEARNING 2020},
  note = {Conference on Applications of Machine Learning, ELECTR NETWORK, AUG
24-SEP 04, 2020},
  orcid-numbers = {Semenishchev, Evgeny/0000-0001-9817-0021
Zhdanova, Marina/0000-0003-1119-5221
Zelenskiy, Alexander/0000-0002-3464-538X},
  organization = {SPIE},
  researcherid-numbers = {Voronin, Viacheslav/H-7334-2013
Balabaeva, Oxana/A-8400-2019
Semenishchev, Evgeny/A-2062-2014
Zhdanova, Marina/A-2068-2014
Zelenskiy, Alexander/AAG-2201-2019},
  series = {Proceedings of SPIE},
  title = {Gastric Polyps Detection Based on Endoscopic Video Using Modified Dense
Micro-Block Difference Descriptor},
