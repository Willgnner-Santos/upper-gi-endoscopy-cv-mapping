@article{Staartjes2024383,
  abstract = {The advent of different realms of computational neurosurgery—including not only machine intelligence but also visualization techniques such as mixed reality and robotic applications—is beginning to impact both open vascular as well as endovascular neurosurgery. Especially in this relatively common patient population of often very fragile patients, with potential for devastating complications and clinical outcomes and sometimes highly complex pathologies, computer assistance could prove particularly useful. In this chapter, state-of-the-art applications of machine learning toward vascular patients are elucidated: Beginning from simple clinical diagnostic, prognostic, and predictive modeling, to the interpretation of medical imaging (radiomics, segmentation, and diagnostic assistance) and synthetic imaging (image modality conversion, super-resolution, and 2D-to-3D-synthesis), up to intraoperative applications of computer vision (robotic steering, rapid intraoperative histopathology, and anatomical and surgical phase recognition), and natural language processing (enabling model training and big data, documentation, and large language models)—this chapter provides a “tour de force” of machine intelligence in the realm of neurovascular medicine. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
  author = {Staartjes, Victor E. and Zanier, Olivier and da Mutten, Raffaele and Serra, Carlo and Regli, Luca},
  author_keywords = {Artificial intelligence; Computational neuroscience; Endovascular; Machine learning; Neurosurgery; Vascular},
  doi = {10.1007/978-3-031-64892-2_23},
  journal = {Advances in Experimental Medicine and Biology},
  keywords = {Artificial Intelligence; Cerebrovascular Disorders; Endovascular Procedures; Humans; Machine Learning; Natural Language Processing; Neurosurgical Procedures; Surgery, Computer-Assisted; accuracy; aneurysm clipping; apparent diffusion coefficient; arterial spin labeling; artificial intelligence; artificial neural network; astrocytoma; blood clot lysis; brain artery aneurysm; brain blood flow; brain hemorrhage; brain infarction; brain ischemia; brain perfusion; cerebrovascular accident; cerebrovascular surgery; clinical outcome; Clinical prediction modeling; computer assisted tomography; computer language; cranioplasty; craniotomy; diagnostic imaging; digital subtraction angiography; endoscopic surgery; endoscopy; endovascular surgery; fluoroscopy; glioma; hematoma; histopathology; human; hydrocephalus; image analysis; intensive care unit; Interpretation of medical imaging; language processing; lipophilicity; lung metastasis; machine learning; middle cerebral artery; natural language processing; neuroradiologist; neuroscience; neurosurgery; nuclear magnetic resonance imaging; operation duration; Operative assistance using  computer vision; patient autonomy; patient care; pituitary surgery; positron emission tomography; priority journal; prostatectomy; spine surgery; subarachnoid hemorrhage; subdural hematoma; support vector machine; surgical technique; Synthetic imaging; training; vasospasm; cerebrovascular disease; computer assisted surgery; neurosurgery; procedures; surgery},
