@article{Laqui_re20251041,
  abstract = {Convolutional neural networks which were developed for computer vision, and large language models are opening up new possibilities in many medical spe-cialties, particularly digestive endoscopy. This field is currently the subject of a large body of scientific literature, with numerous studies having been published. This article aims to provide an up-to-date overview of artificial intelligence’s performance and main applications in digestive endoscopy. It analyzes the various biases that may arise in the interaction between artificial intelligence algorithms and gastroenterologists during digestive endoscopy, along with approaches to reduce or correct them. © 2026 JLE. Downloaded by DRS MONIQUE BERKHOF on 08/01/2026.},
  author = {Laquière, Arthur and Peyret, Dysmas and Boustière, Christian and Coron, Emmanuel and Karsenti, David},
