@article{WANG2009425,
  abstract = {Most classifiers output predictions for new instances without indicating how reliable they could be. Transductive confidence machine (TCM) is a novel framework that provides hedged prediction coupled with valid confidence. Many popular machine learning algorithms can be transformed into the framework of TCM, and therefore be used for producing hedged predictions. This paper incorporates random forest (RF) to propose a method named TCM-RF for classification of chronic gastritis data. Our method benefits from TCM-RF's high performance when features are noisy, highly correlated and of mixed types. The experimental results show that TCM-RF produces informative as well as effective predictions.},
  author = {Huazhen Wang and Chengde Lin and Fan Yang and Xueqin Hu},
  doi = {https://doi.org/10.1016/j.compbiomed.2009.02.002},
  issn = {0010-4825},
  journal = {Computers in Biology and Medicine},
  keywords = {Chronic gastritis, Transductive confidence machine, Random forest, Proximity measure, Hedged prediction},
  number = {5},
  pages = {425-432},
  title = {Hedged predictions for traditional Chinese chronic gastritis diagnosis with confidence machine},
  url = {https://www.sciencedirect.com/science/article/pii/S0010482509000419},
  volume = {39},
  year = {2009}
}

@article{WANG2024105516,
  abstract = {Gastric precancerous conditions are closely linked to the development of gastric cancer. However, the detection of gastric precancerous lesions (GPL) is limited by the indistinct symptoms and the low detection rate of microscope images. This paper proposes an RGB and Hyperspectral Dual-modality imaging Feature Fusion Network (DuFF-Net) to improve the classification accuracy of GPL. To fully exploit information of different modality images, we customize a dual-stream ResNet-based model for feature sharing and fusion. Skip-Connections are added between inter-path of networks to achieve information interaction. In the decision step, we adopt the SE-based attention module and Pearson Correlation to highlight and select effective features. Experimental results show that the DuFF-Net increases the screening accuracy to 96.15 % for two types of gastric precancerous tissues with high morphological similarity. Furthermore, our approach reduces the labeling workload for classification tasks by approximately 50 %. These findings provide valuable guidance for the screening and subsequent lesion segmentation of GPLs.},
  author = {Jiansheng Wang and Benyan Zhang and Yan Wang and Chunhua Zhou and Duowu Zou and Maxim Sergeevich Vonsky and Lubov B. Mitrofanova and Qingli Li},
  doi = {https://doi.org/10.1016/j.bspc.2023.105516},
  issn = {1746-8094},
  journal = {Biomedical Signal Processing and Control},
  keywords = {Hyperspectral imaging, Gastric precancerous lesions, Dual-modality, Feature fusion},
  pages = {105516},
  title = {Dual-modality image feature fusion network for gastric precancerous lesions classification},
  url = {https://www.sciencedirect.com/science/article/pii/S1746809423009497},
  volume = {87},
  year = {2024}
}

@article{YAN2025115050,
  abstract = {Gastritis and gastric ulcer are common clinical gastrointestinal disorders, for which accurate diagnosis is crucial to guide treatment decisions and improve patient prognosis. Conventional diagnostic methods based on gastroscopy are invasive and carry procedural risks, significantly reducing patient compliance. Therefore, the development of a high-accuracy, non-invasive diagnostic technique holds substantial clinical and societal value. This study innovatively integrates surface-enhanced Raman spectroscopy (SERS) with machine learning algorithms to establish a novel diagnostic model for differentiating non-atrophic gastritis (NAG), atrophic gastritis (AG), and gastric ulcer (GU). Adopting a case-control design, the study enrolled 90 participants (30 cases each for NAG, AG, and GU) and collected blood samples to generate 900 SERS spectra. Machine learning algorithms, including Random Forest (RF) and Support Vector Machine (SVM), were employed for spectral feature analysis, and the classification performance of the models was systematically evaluated. The results demonstrated that the RF algorithm achieved optimal diagnostic efficacy in the three-class classification task, with an accuracy of 80.56 %. In binary classification tasks, the RF model also exhibited outstanding performance (NAG vs. AG: 89.17 %; NAG vs. GU: 90.83 %; AG vs. GU: 85.83 %). These findings strongly support that the non-invasive diagnostic strategy combining SERS technology and machine learning (particularly the RF algorithm) can serve as an effective auxiliary tool for the clinical diagnosis of gastritis and gastric ulcer, providing a transformative approach for gastrointestinal disease screening.},
  author = {Zixing Yan and Peipei Xu and Junpeng Su and Jingxin Chen and Youmei Liu and Chuyi Wang and Yudong Lu},
  doi = {https://doi.org/10.1016/j.microc.2025.115050},
  issn = {0026-265X},
  journal = {Microchemical Journal},
  keywords = {Gastritis, Gastric ulcer, Surface-enhanced Raman spectroscopy, Machine learning, Noninvasive},
  pages = {115050},
  title = {Nylon66-Au@Ag core-shell nanocomposites fabricated by filtration-accumulation for gastritis staging via SERS biosensing},
  url = {https://www.sciencedirect.com/science/article/pii/S0026265X25023987},
  volume = {217},
  year = {2025}
}
