@article{FU2023107605,
  abstract = {Gastric cancer continues to be a significant health concern in China, with a high incidence rate. To mitigate its impact, early detection and treatment is key. However, conducting large-scale endoscopic gastric cancer screening is not feasible in China. Instead, a more appropriate approach would be to initially screen high-risk groups and follow up with endoscopic testing as needed. We conducted a study on 25,622 asymptomatic participants aged 45–70 years from a free gastric cancer screening program in the Taizhou city government's Minimum Living Guarantee Crowd (MLGC) initiative. Participants completed questionnaires, blood tests, and underwent gastrin-17 (G-17), pepsinogen I and II (PGI and PGII), and H. pylori IgG antibody (IgG) assessments. Using the light gradient boosting machine (lightGBM) algorithm, we developed a predictive model for gastric cancer risk. In the full model, F1 score was 2.66%, precision was 1.36%, and recall was 58.14%. In the high-risk model, F1 score was 2.51%, precision was 1.27%, and recall was 94.55%. Excluding IgG, the F1 score was 2.73%, precision was 1.40%, and recall was 68.62%. We conclude that H. pylori IgG appears to be able to be excluded from the prediction model without significantly affecting its performance, which is important from a health economic point of view. It suggests that screening indicators can be optimized, and expenditures reduced. These findings can have important implications for policymakers, as we can focus resources on other important aspects of gastric cancer prevention and control.},
  author = {Xin-Yu Fu and Xin-Li Mao and Hao-Wen Wu and Jia-Ying Lin and Zong-Qing Ma and Zhi-Cheng Liu and Yue Cai and Ling-Ling Yan and Yi Sun and Li-Ping Ye and Shao-Wei Li},
  doi = {https://doi.org/10.1016/j.ypmed.2023.107605},
  issn = {0091-7435},
  journal = {Preventive Medicine},
  keywords = {Machine learning,  antibody, Minimum living guarantee crowd, Gastric cancer, Gastrin-17, Pepsinogen I and II},
  pages = {107605},
  title = {Development and validation of LightGBM algorithm for optimizing of Helicobacter pylori antibody during the minimum living guarantee crowd based gastric cancer screening program in Taizhou, China},
  url = {https://www.sciencedirect.com/science/article/pii/S0091743523001858},
  volume = {174},
  year = {2023}
}

@article{HU2026121154,
  abstract = {Magnetic manipulation provides a promising approach to enhancing the maneuverability and safety of capsule robots (CR). Due to its advantages of human harmlessness and low latency, magnetic signal-based positioning technology is regarded as the most promising CR localization method. However, traditional magnetic localization approaches based on optimization algorithms have initial values sensitivity and error accumulation issues especially in environments with multiple magnetic sources. To address this challenge, a neural network based on magnetic positioning is proposed, which integrates physics-based principles with transfer learning. The method builds a ResNet-based prediction model with multi-scale convolution and channel attention mechanism to bolster system resilience. A loss function based on physical information and designed with a magnetic field analysis model is provided, which enhances the interpretability of model inference. A transfer training strategy involving pre-training with physical model data and fine-tuning with real data is presented, which achieves high positioning accuracy even when data is limited. The efficacy of the localization methodology is validated in an ex vivo pig stomach, resulting in an average position error and angle error of 2.90 mm and 1.26°, respectively, with a single positioning time of 0.34 ms. The results demonstrate the promising potential of this technology for translation into clinical practice.},
  author = {Mengya Hu and Qingqing Wang and Yurui Shen and Ting Zhang and Jun Wu and Dezheng Hua and Xinhua Liu},
  doi = {https://doi.org/10.1016/j.measurement.2026.121154},
  issn = {0263-2241},
  journal = {Measurement},
  keywords = {Magnetic capsule robot, Localization, Neural network, Transfer learning, Physical information},
  pages = {121154},
  title = {Real-time localization method for magnetic capsule robot using transfer learning in physics-informed neural network},
  url = {https://www.sciencedirect.com/science/article/pii/S0263224126008638},
  volume = {273},
  year = {2026}
}

