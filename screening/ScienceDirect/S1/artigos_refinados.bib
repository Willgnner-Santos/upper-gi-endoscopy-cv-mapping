@article{LI2023102709,
  abstract = {We propose an endoscopic image mosaicking algorithm that is robust to light conditioning changes, specular reflections, and feature-less scenes. These conditions are especially common in minimally invasive surgery where the light source moves with the camera to dynamically illuminate close range scenes. This makes it difficult for a single image registration method to robustly track camera motion and then generate consistent mosaics of the expanded surgical scene across different and heterogeneous environments. Instead of relying on one specialised feature extractor or image registration method, we propose to fuse different image registration algorithms according to their uncertainties, formulating the problem as affine pose graph optimisation. This allows to combine landmarks, dense intensity registration, and learning-based approaches in a single framework. To demonstrate our application we consider deep learning-based optical flow, hand-crafted features, and intensity-based registration, however, the framework is general and could take as input other sources of motion estimation, including other sensor modalities. We validate the performance of our approach on three datasets with very different characteristics to highlighting its generalisability, demonstrating the advantages of our proposed fusion framework. While each individual registration algorithm eventually fails drastically on certain surgical scenes, the fusion approach flexibly determines which algorithms to use and in which proportion to more robustly obtain consistent mosaics.},
  author = {Liang Li and Evangelos Mazomenos and James H. Chandler and Keith L. Obstein and Pietro Valdastri and Danail Stoyanov and Francisco Vasconcelos},
  doi = {https://doi.org/10.1016/j.media.2022.102709},
  issn = {1361-8415},
  journal = {Medical Image Analysis},
  keywords = {Medical image processing, Optical flow, Image mosaicking, Pose graph optimisation, Endoscopic image mosaicking},
  pages = {102709},
  title = {Robust endoscopic image mosaicking via fusion of multimodal estimation},
  url = {https://www.sciencedirect.com/science/article/pii/S1361841522003371},
  volume = {84},
  year = {2023}
}

@article{LI2024106454,
  abstract = {Gastrointestinal metaplasia (GIM) is a common precancerous condition and is closely related to the occurrence of gastric cancer. With the development of modern medicine, some studies have demonstrated that precise severity classification of GIM can effectively assess the risk of early gastric cancer and contribute to its prevention. To the best of our knowledge, current research primarily focuses on utilizing deep learning methods for the GIM recognition, without delving into severity classification. To address this problem, we propose a Deformable Transformer with Token Merge (DTTM), which aims to achieve automatic diagnosis of GIM, specifically grading the GIM severity. Specifically, a novel Token Matching and Merging (TMM) module is devised and embedded into Vision Transformer (ViT). By progressive merging, the representation area of tokens can be adaptively adjusted according to the GIM areas, and DTTM can learn more abundant semantic features under irregular shapes. Experimental results show that DTTM achieves 95.23% and 87.05% accuracy on self-construct GIM recognition and GIM severity classification datasets, respectively, outperforming strong baselines and existing methods. Furthermore, an endoscope-aided GIM analysis system is developed and a separate clinical trial is conducted to evaluate the clinical applications of DTTM, and the results show its significant clinical potential.},
  author = {Zheng Li and Xiangwei Zheng and Yijun Mu and Mingzhe Zhang and Guanqun Liu},
  doi = {https://doi.org/10.1016/j.bspc.2024.106454},
  issn = {1746-8094},
  journal = {Biomedical Signal Processing and Control},
  keywords = {Medical image classification, Gastric cancer, Gastrointestinal metaplasia, Deep learning, Transformer},
  pages = {106454},
  title = {The intelligent gastrointestinal metaplasia assessment based on deformable transformer with token merging},
  url = {https://www.sciencedirect.com/science/article/pii/S1746809424005123},
  volume = {95},
  year = {2024}
}

@article{LI2024107751,
  abstract = {Computer-aided diagnosis (CAD) assists endoscopists in analyzing endoscopic images, reducing misdiagnosis rates and enabling timely treatment. A few studies have focused on CAD for gastroesophageal reflux disease, but CAD studies on reflux esophagitis (RE) are still inadequate. This paper presents a CAD study on RE using a dataset collected from hospital, comprising over 3000 images. We propose an uncertainty-aware network with handcrafted features, utilizing representation and classifier decoupling with metric learning to address class imbalance and achieve fine-grained RE classification. To enhance interpretability, the network estimates uncertainty through test time augmentation. The experimental results demonstrate that the proposed network surpasses previous methods, achieving an accuracy of 90.2% and an F1 score of 90.1%.},
  author = {Xingcun Li and Qinghua Wu and Mi Wang and Kun Wu},
  doi = {https://doi.org/10.1016/j.compbiomed.2023.107751},
  issn = {0010-4825},
  journal = {Computers in Biology and Medicine},
  keywords = {Medical image classification, Deep learning, Machine learning, Class imbalance, Computer-aided diagnosis, Gastroesophageal reflux disease},
  pages = {107751},
  title = {Uncertainty-aware network for fine-grained and imbalanced reflux esophagitis grading},
  url = {https://www.sciencedirect.com/science/article/pii/S0010482523012167},
  volume = {168},
  year = {2024}
}

