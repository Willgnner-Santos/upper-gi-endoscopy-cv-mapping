@article{EBIGBO2025396,
  abstract = {Artificial intelligence (AI) holds the potential to transform the management of upper gastrointestinal (GI) conditions, such as Barrett's esophagus, esophageal squamous cell cancer, and early gastric cancer. Advancements in deep learning and convolutional neural networks offer improved diagnostic accuracy and reduced diagnostic variability across different clinical settings, particularly where human error or fatigue may impair diagnostic precision. Deep learning models have shown the potential to improve early cancer detection and lesion characterization, predict invasion depth, and delineate lesion margins with remarkable accuracy, all contributing to effective treatment planning. Several challenges, however, limit the broad application of AI in GI endoscopy, particularly in the upper GI tract. Subtle lesion morphology and restricted diversity in training datasets, which are often sourced from specialized centers, may constrain the generalizability of AI models in various clinical settings. Furthermore, the "black box" nature of some AI systems can impede explainability and clinician trust. To address these issues, efforts are underway to incorporate multimodal data, such as combining endoscopic and histopathologic imaging, to bolster model robustness and transparency. In the future, AI promises substantial advancements in automated real-time endoscopic guidance, personalized risk assessment, and optimized biopsy decision making. As it evolves, it would substantially impact not only early diagnosis and prognosis, but also the cost-effectiveness of managing upper GI diseases, ultimately leading to improved patient outcomes and more efficient health care delivery.},
  author = {Alanna Ebigbo and Helmut Messmann and Sung Hak Lee},
  doi = {https://doi.org/10.1053/j.gastro.2025.01.253},
  issn = {0016-5085},
  journal = {Gastroenterology},
  keywords = {Barrett's Esophagus, Squamous Cell Cancer, Gastric Cancer, Early Detection, Artificial Intelligence},
  note = {Shaping the Future of Gastroenterology and Hepatology With Artificial Intelligence},
  number = {3},
  pages = {396-415.e2},
  title = {Artificial Intelligence Applications in Image-Based Diagnosis of Early Esophageal and Gastric Neoplasms},
  url = {https://www.sciencedirect.com/science/article/pii/S0016508525004718},
  volume = {169},
  year = {2025}
}

