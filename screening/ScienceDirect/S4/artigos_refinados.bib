@article{BRUNA2026800279,
  abstract = {Hiatus hernia (HH) is a relatively prevalent condition in our setting, yet there is little clinical evidence or guidelines establishing precise recommendations for its diagnostic and therapeutic management. In order to establish clinical recommendations for the diagnostic and therapeutic management of patients with complex hiatal hernia, defined as a primary type III or IV mixed hernia, a large one with >30% of the gastric contents in the thoracic cavity, or a recurrence. This document was prepared based on current scientific evidence and the experience of a group of 28 expert surgeons, using GRADE methodology in order to establish recommendations on 13 controversial aspects related to this pathology. Although the quality of evidence and the degree of recommendation are high in some areas, high-quality prospective clinical studies are needed to clarify certain unresolved points of controversy.
Resumen
La hernia de hiato (HH) es una patología relativamente prevalente en nuestro medio, pero a pesar de ello existe escasa evidencia clínica y guías que establezcan recomendaciones precisas sobre su manejo diagnóstico y terapéutico. Con el fin de establecer recomendaciones clínicas para el manejo diagnóstico y terapéutico de pacientes con hernia de hiato compleja, definida como aquella hernia primaria tipo III mixta y IV, aquella de gran tamaño con >30% del contenido gástrico en la cavidad torácica o recidivada, se ha elaborado este documento basado en la evidencia científica actual y la experiencia de un grupo de 28 cirujanos expertos. Para ello se revisó la bibliografía publicada y se empleó la metodología GRADE para establecer recomendaciones sobre 13 aspectos controvertidos en relación a esta patología. A pesar de que en algunos puntos la calidad de evidencia y el grado de recomendación es elevado, es necesario la realización de estudios clínicos prospectivos y de calidad para aclarar ciertos puntos de controversia aún no resueltos.},
  author = {Marcos Bruna and María Asunción Acosta and Silvia Carbonell and Luis Gómez and Marian Mayo and Salvador Morales-Conde and Aitana Garcia-Tejero and Silvia Aguas and David Ruíz de Angulo and Vicente Munitiz and Luisa Martínez de Haro and Vanessa Concepción and Fernando Mingol and Miriam Menéndez and Gabriel Salcedo and Esteban Martín and Ana Senent and Alexis Luna and Dulce Momblán and Pablo Priego and María Posada and Purificación Parada and Rocío Pérez and Felipe Parreño and Coro Miranda and Carlos Loureiro and Lourdes Sanz and Mónica Miró},
  doi = {https://doi.org/10.1016/j.cireng.2026.800279},
  issn = {2173-5077},
  journal = {Cirugía Española (English Edition)},
  keywords = {Hiatus hernia, Recommendations, Experts, Surgery, Fundoplication, Mesh, Hernia de hiato, Recomendaciones, Expertos, Cirugía, Funduplicatura, Malla},
  number = {2},
  pages = {800279},
  title = {Complex hiatus hernias. Diagnostic and therapeutic management recommendations},
  url = {https://www.sciencedirect.com/science/article/pii/S2173507726000050},
  volume = {104},
  year = {2026}
}

